                        <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black">Chat &amp; channel alerts</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/telegram/add"
                   class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-hc-muted group-hover:bg-[#26A5E4]/10 group-hover:border-[#26A5E4]/20 group-hover:text-[#26A5E4] transition-all">
