@{
    var project = (ViewBag.Project as HealthyCron.Models.Project)!;
    var user = (ViewBag.User as HealthyCron.Models.User)!;
    var integrations = ViewBag.Integrations as List<HealthyCron.Models.ViewModels.IntegrationListItemViewModel>;
    ViewData["Title"] = $"{(project != null ? project.Name : "Project")} - Integrations";
    Layout = "_DashboardLayout";
}

<div class="max-w-5xl ml-0 pb-20 px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-hc-muted text-sm mb-6 tracking-wider font-semibold">
        <a href="/dashboard" class="hover:text-blue-500 transition-colors flex items-center gap-1">
            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
            Projects
        </a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/monitors" class="hover:text-white transition-colors">@project.Name</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-white">Integrations</span>
    </div>

    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white flex items-center gap-3">
                <i data-lucide="zap" class="text-blue-500"></i>
                Integrations
            </h1>
            <p class="text-hc-muted mt-1">Manage where you receive notifications for this project.</p>
        </div>
    </div>

    @{
        var successParam = Context.Request.Query["success"].FirstOrDefault();
        var errorParam = Context.Request.Query["error"].FirstOrDefault();
    }
    @if (successParam == "pushover")
    {
        <div class="mb-6 flex items-center gap-3 rounded-xl bg-hc-amber/10 border border-hc-amber/20 px-4 py-3 text-hc-amber text-sm font-medium">
            <i data-lucide="check-circle-2" class="w-4 h-4 shrink-0"></i>
            Pushover connected successfully! You'll start receiving alerts on your device.
        </div>
    }
    @if (errorParam == "pushover_cancelled")
    {
        <div class="mb-6 flex items-center gap-3 rounded-xl bg-red-500/10 border border-red-500/20 px-4 py-3 text-red-400 text-sm font-medium">
            <i data-lucide="x-circle" class="w-4 h-4 shrink-0"></i>
            Pushover subscription was cancelled. You can try again anytime.
        </div>
    }

    <!-- 1. Connected Integrations (Top) -->
    <section class="mb-12">
        <h2 class="text-xs font-black uppercase tracking-widest text-hc-muted mb-4 flex items-center gap-2">
            <i data-lucide="link" class="w-3.5 h-3.5"></i>
            Connected Integrations
        </h2>

        @if (integrations != null && integrations.Any())
        {
            <div class="grid grid-cols-1 gap-4">
                @foreach (var item in integrations)
                {
                    var integration = item.Integration;
                    var slackDetails = item.SlackDetails;
                    var teamsDetails = item.TeamsDetails;
                    var googleChatDetails = item.GoogleChatDetails;
                    var discordDetails = item.DiscordDetails;
                    var emailDetails = item.EmailDetails;
                    var pagerDutyDetails = item.PagerDutyDetails;
                    var telegramDetails = item.TelegramDetails;
                    var pushoverDetails = item.PushoverDetails;
                    var spikeDetails = item.SpikeDetails;
                    var webhookDetails = item.WebhookDetails;
                    var isSlack = integration.Type == HealthyCron.Enums.IntegrationType.Slack;
                    var isTeams = integration.Type == HealthyCron.Enums.IntegrationType.Teams;
                    var isGoogleChat = integration.Type == HealthyCron.Enums.IntegrationType.GoogleChat;
                    var isDiscord = integration.Type == HealthyCron.Enums.IntegrationType.Discord;
                    var isEmail = integration.Type == HealthyCron.Enums.IntegrationType.Email;
                    var isPagerDuty = integration.Type == HealthyCron.Enums.IntegrationType.PagerDuty;
                    var isWhatsApp = integration.Type == HealthyCron.Enums.IntegrationType.WhatsApp;
                    var isCall = integration.Type == HealthyCron.Enums.IntegrationType.Call;
                    var isTelegram = integration.Type == HealthyCron.Enums.IntegrationType.Telegram;
                    var isPushover = integration.Type == HealthyCron.Enums.IntegrationType.Pushover;
                    var isSpike = integration.Type == HealthyCron.Enums.IntegrationType.Spike;
                    var isWebhook = integration.Type == HealthyCron.Enums.IntegrationType.Webhook;

                    <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-blue-500/20 transition-all group">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
                            <div class="flex items-center gap-4">
                                @if (isSlack)
                                {
                                    <div class="w-12 h-12 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                                        <img src="/images/slack.png" class="w-7 h-7 object-contain" alt="Slack" />
                                    </div>
                                }
                                else if (isTeams)
                                {
                                    <div class="w-12 h-12 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                                        <img src="/images/teams.png" class="w-8 h-8 object-contain" alt="Microsoft Teams" />
                                    </div>
                                }
                                else if (isGoogleChat)
                                {
                                    <div class="w-12 h-12 bg-white/5 border border-white/5 rounded-xl flex items-center justify-center shrink-0">
                                        <i data-lucide="message-square" class="w-7 h-7 text-[#00897B]"></i>
                                    </div>
                                }
                                else if (isDiscord)
                                {
                                    <div class="w-12 h-12 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                                        <img src="/images/discord.png" class="w-7 h-7 object-contain" alt="Discord" />
                                    </div>
                                }
                                else if (isEmail)
                                {
                                    <div class="w-12 h-12 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                                        <img src="/images/gmail.png" class="w-7 h-7 object-contain" alt="Email" />
                                    </div>
                                }
                                else if (isPagerDuty)
                                {
                                    <div class="w-12 h-12 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                                        <img src="/images/pagerduty.png" class="w-8 h-8 object-contain" alt="PagerDuty" />
                                    </div>
                                }
                                else if (isWhatsApp)
                                {
                                    <div class="w-12 h-12 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                                        <img src="/images/whatsapp.png" class="w-8 h-8 object-contain" alt="WhatsApp" />
                                    </div>
                                }
                                else if (isCall)
                                {
                                    <div class="w-12 h-12 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                                        <img src="/images/telephone.png" class="w-7 h-7 object-contain" alt="Phone Call" />
                                    </div>
                                }
                                else if (isTelegram)
                                {
                                    <div class="w-12 h-12 bg-hc-black-light border border-white/5 rounded-xl flex items-center justify-center shrink-0">
                                        <img src="/images/telegram.png" class="w-7 h-7 object-contain" alt="Telegram" />
                                    </div>
                                }
                                else if (isPushover)
                                {
                                    <div class="w-12 h-12 bg-hc-black-light border border-white/5 rounded-xl flex items-center justify-center shrink-0">
                                        <img src="/images/pushover.png" class="w-7 h-7 object-contain" alt="Pushover" />
                                    </div>
                                }
                                else if (isSpike)
                                {
                                    <div class="w-12 h-12 bg-hc-black-light border border-white/5 rounded-xl flex items-center justify-center shrink-0">
                                        <img src="/images/spike.png" class="w-7 h-7 object-contain" alt="Spike.sh" />
                                    </div>
                                }
                                else if (isWebhook)
                                {
                                    <div class="w-12 h-12 bg-hc-black-light border border-white/5 rounded-xl flex items-center justify-center shrink-0">
                                        <img src="/images/webhook.png" class="w-7 h-7 object-contain" alt="Webhook" />
                                    </div>
                                }
                                else
                                {
                                    <div class="w-12 h-12 bg-hc-black-light border border-white/5 rounded-xl flex items-center justify-center shrink-0">
                                        <i data-lucide="zap" class="w-7 h-7 text-blue-500"></i>
                                    </div>
                                }

                                <div>
                                    <h3 class="font-bold text-white text-lg">@integration.Name</h3>
                                    @if (isSlack && slackDetails != null)
                                    {
                                        <p class="text-xs text-hc-muted">Workspace: @slackDetails.WorkspaceName | Channel: #@slackDetails.ChannelName</p>
                                    }
                                    else if (isTeams && teamsDetails != null)
                                    {
                                        var maskedUrl = teamsDetails.WebhookUrl.Length > 50 
                                            ? teamsDetails.WebhookUrl.Substring(0, 50) + "..." 
                                            : teamsDetails.WebhookUrl;
                                        <p class="text-xs text-hc-muted font-mono">@maskedUrl</p>
                                    }
                                    else if (isGoogleChat && googleChatDetails != null)
                                    {
                                        if (!string.IsNullOrEmpty(googleChatDetails.SpaceName))
                                        {
                                            <p class="text-xs text-hc-muted">Space: @googleChatDetails.SpaceName</p>
                                        }
                                        else
                                        {
                                            var maskedUrl = googleChatDetails.WebhookUrl.Length > 50 
                                                ? googleChatDetails.WebhookUrl.Substring(0, 50) + "..." 
                                                : googleChatDetails.WebhookUrl;
                                            <p class="text-xs text-hc-muted font-mono">@maskedUrl</p>
                                        }
                                    }
                                    else if (isDiscord && discordDetails != null)
                                    {
                                        if (!string.IsNullOrEmpty(discordDetails.ChannelName))
                                        {
                                            <p class="text-xs text-hc-muted">Channel: @discordDetails.ChannelName</p>
                                        }
                                        else
                                        {
                                            var maskedUrl = discordDetails.WebhookUrl.Length > 50 
                                                ? discordDetails.WebhookUrl.Substring(0, 50) + "..." 
                                                : discordDetails.WebhookUrl;
                                            <p class="text-xs text-hc-muted font-mono">@maskedUrl</p>
                                        }
                                    }
                                    else if (isEmail && emailDetails != null)
                                    {
                                        <p class="text-xs text-hc-muted">@emailDetails.Email</p>
                                    }
                                    else if (isPagerDuty && pagerDutyDetails != null)
                                    {
                                        <p class="text-xs text-hc-muted">Account ID: @pagerDutyDetails.AccountId</p>
                                    }
                                    else if (isTelegram && telegramDetails != null)
                                    {
                                        var chatTypeLabel = telegramDetails.ChatType switch {
                                            "group" => "Group",
                                            "supergroup" => "Group",
                                            "channel" => "Channel",
                                            "private" => "DM",
                                            _ => "Chat"
                                        };
                                        var chatTypeBadgeColor = telegramDetails.ChatType switch {
                                            "channel" => "text-sky-400 bg-sky-400/10 border-sky-400/20",
                                            "private" => "text-violet-400 bg-violet-400/10 border-violet-400/20",
                                            _ => "text-hc-amber bg-hc-amber/10 border-hc-amber/20"
                                        };
                                        <div class="flex items-center gap-2 flex-wrap mt-0.5">
                                            @if (!string.IsNullOrEmpty(telegramDetails.ChatName))
                                            {
                                                <span class="text-xs text-hc-muted">@telegramDetails.ChatName</span>
                                            }
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold border @chatTypeBadgeColor">@chatTypeLabel</span>
                                        </div>
                                    }
                                    else if (isPushover && pushoverDetails != null)
                                    {
                                        var deviceLabel = string.IsNullOrEmpty(pushoverDetails.Device) ? "All devices" : pushoverDetails.Device;
                                        <p class="text-xs text-hc-muted mt-0.5">Device: @deviceLabel</p>
                                    }
                                    else if (isSpike && spikeDetails != null)
                                    {
                                        var maskedUrl = "hooks.spike.sh/****";
                                        <p class="text-xs text-hc-muted font-mono mt-0.5">@maskedUrl</p>
                                    }
                                    else if (isWebhook && webhookDetails != null)
                                    {
                                        string displayMethod = "POST";
                                        string displayUrl = "";
                                        
                                        if (!string.IsNullOrEmpty(webhookDetails.DownUrl))
                                        {
                                            displayMethod = webhookDetails.DownMethod?.ToUpper() ?? "POST";
                                            displayUrl = webhookDetails.DownUrl;
                                        }
                                        else if (!string.IsNullOrEmpty(webhookDetails.UpUrl))
                                        {
                                            displayMethod = webhookDetails.UpMethod?.ToUpper() ?? "POST";
                                            displayUrl = webhookDetails.UpUrl;
                                        }

                                        var badgeColor = displayMethod == "GET" ? "text-green-400 bg-green-400/10 border-green-400/20" : displayMethod == "PUT" ? "text-hc-amber bg-hc-amber/10 border-hc-amber/20" : "text-blue-400 bg-blue-400/10 border-blue-400/20";
                                        var truncatedUrl = displayUrl.Length > 40 ? displayUrl[..40] + "..." : displayUrl;
                                        <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-black border @badgeColor">@displayMethod</span>
                                            <span class="text-xs text-hc-muted font-mono">@truncatedUrl</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="flex flex-wrap items-center gap-2 mt-2 sm:mt-0">
                                <button onclick="openMonitorSelector('@integration.Id', '@integration.Name')" 
                                        class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-3 sm:px-4 py-2 rounded-xl bg-blue-600/10 text-blue-500 border border-blue-500/20 hover:bg-blue-600 hover:text-white transition-all font-bold text-xs sm:text-sm">
                                    <i data-lucide="list-checks" class="w-3.5 h-3.5 sm:w-4 h-4"></i>
                                    Checks
                                </button>
                                @if (ViewBag.CanManage != false && (isEmail || isWebhook))
                                {
                                    var editUrl = isEmail ? $"/project/{@project.Slug}/integrations/email/{@integration.Id}/edit" : $"/project/{@project.Slug}/integrations/webhook/{@integration.Id}/edit";
                                    <a href="@editUrl" 
                                       class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-3 sm:px-4 py-2 rounded-xl bg-white/5 text-hc-muted border border-white/10 hover:border-blue-500/20 hover:text-blue-500 transition-all font-bold text-xs sm:text-sm">
                                        <i data-lucide="edit-2" class="w-3.5 h-3.5 sm:w-4 h-4"></i>
                                        Edit
                                    </a>
                                }
                                <button onclick="testIntegration('@integration.Id')" 
                                        @(ViewBag.CanManage == false ? "disabled" : "")
                                        class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-3 sm:px-4 py-2 rounded-xl bg-white/5 text-hc-muted border border-white/10 hover:border-blue-500/20 hover:text-blue-500 transition-all font-bold text-xs sm:text-sm @(ViewBag.CanManage == false ? "opacity-50 cursor-not-allowed" : "")">
                                    <i data-lucide="play" class="w-3.5 h-3.5 sm:w-4 h-4"></i>
                                    Test
                                </button>
                                @if (ViewBag.CanManage != false)
                                {
                                    <button onclick="deleteIntegration('@integration.Id')" 
                                            class="flex-1 sm:flex-none flex items-center justify-center px-3 sm:px-4 py-2 rounded-xl bg-red-500/10 text-red-500 border border-red-500/20 hover:bg-red-500 hover:text-white transition-all font-bold text-xs sm:text-sm">
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5 sm:w-4 h-4"></i>
                                        <span class="sm:inline">Delete</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="glass-card rounded-2xl p-12 text-center border-dashed border-2 border-white/5">
                <div class="w-16 h-16 bg-white/5 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="inbox" class="w-8 h-8 text-hc-muted"></i>
                </div>
                <p class="text-hc-muted font-medium">No active integrations connected yet.</p>
                <p class="text-[10px] text-hc-muted mt-1 uppercase tracking-widest font-bold">Select a service below to get started</p>
            </div>
        }
    </section>

    <!-- 2. Available Integrations (Bottom) -->
    <section>
        <h2 class="text-xs font-black uppercase tracking-widest text-hc-muted mb-4 flex items-center gap-2">
            <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i>
            Available Integrations
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Slack -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-purple-500/20 transition-all flex items-center justify-between group">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                        <img src="/images/slack.png" class="w-5 h-5 object-contain" alt="Slack" />
                    </div>
                    <div>
                        <h3 class="font-bold text-white">Slack</h3>
                        <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black">Modern team chat</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/slack/authorize" 
                   class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-hc-muted group-hover:bg-blue-600/10 group-hover:border-blue-500/20 group-hover:text-blue-500 transition-all">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>

            <!-- MS Teams -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-hc-blue/20 transition-all flex items-center justify-between group">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                        <img src="/images/teams.png" class="w-6 h-6 object-contain" alt="Teams" />
                    </div>
                    <div>
                        <h3 class="font-bold text-white">Teams</h3>
                        <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black">Enterprise collaboration</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/teams/add" 
                   class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-hc-muted group-hover:bg-blue-600/10 group-hover:border-blue-500/20 group-hover:text-blue-500 transition-all">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>

            <!-- Google Chat -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-hc-amber/20 transition-all flex items-center justify-between group">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-white/5 border border-white/5 rounded-xl flex items-center justify-center shrink-0">
                        <i data-lucide="message-square" class="w-6 h-6 text-[#00897B]"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-white">Google Chat</h3>
                        <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black">Workspace alerts</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/googlechat/add" 
                   class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-hc-muted group-hover:bg-blue-600/10 group-hover:border-blue-500/20 group-hover:text-blue-500 transition-all">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>

            <!-- Discord -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-hc-blue/20 transition-all flex items-center justify-between group">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                        <img src="/images/discord.png" class="w-6 h-6 object-contain" alt="Discord" />
                    </div>
                    <div>
                        <h3 class="font-bold text-white">Discord</h3>
                        <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black">Community & Dev chat</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/discord/add" 
                   class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-hc-muted group-hover:bg-blue-600/10 group-hover:border-blue-500/20 group-hover:text-blue-500 transition-all">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>

            <!-- Email -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-blue-500/20 transition-all flex items-center justify-between group">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                        <img src="/images/gmail.png" class="w-6 h-6 object-contain" alt="Email" />
                    </div>
                    <div>
                        <h3 class="font-bold text-white">Email</h3>
                        <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black">Direct notifications</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/email/add" 
                   class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-hc-muted group-hover:bg-blue-600/10 group-hover:border-blue-500/20 group-hover:text-blue-500 transition-all">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>

            <!-- PagerDuty -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-hc-amber/20 transition-all flex items-center justify-between group">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                        <img src="/images/pagerduty.png" class="w-6 h-6 object-contain" alt="PagerDuty" />
                    </div>
                    <div>
                        <h3 class="font-bold text-white">PagerDuty</h3>
                        <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black">Incident Management</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/pagerduty/authorize" 
                   class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-hc-muted group-hover:bg-blue-600/10 group-hover:border-blue-500/20 group-hover:text-blue-500 transition-all">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>

            <!-- Webhook -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-hc-blue/20 transition-all flex items-center justify-between group">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                        <img src="/images/webhook.png" class="w-6 h-6 object-contain" alt="Webhook" />
                    </div>
                    <div>
                        <h3 class="font-bold text-white">Webhook</h3>
                        <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black">Custom endpoints</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/webhook/add" 
                   class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-hc-muted group-hover:bg-blue-600/10 group-hover:border-blue-500/20 group-hover:text-blue-500 transition-all">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>



            <!-- Telegram -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-[#26A5E4]/20 transition-all flex items-center justify-between group">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-white/5 border border-white/10 rounded-xl flex items-center justify-center shrink-0">
                        <img src="/images/telegram.png" class="w-6 h-6 object-contain" alt="Telegram" />
