@{
    var project = (ViewBag.Project as HealthyCron.Models.Project)!;
    var user = (ViewBag.User as HealthyCron.Models.User)!;
    var integrations = ViewBag.Integrations as List<HealthyCron.Models.ViewModels.IntegrationListItemViewModel>;
    ViewData["Title"] = $"{(project != null ? project.Name : "Project")} - Integrations";
    Layout = "_DashboardLayout";
}

<div class="max-w-4xl mx-auto pb-20">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-text-secondary text-sm mb-6 uppercase tracking-wider font-semibold">
        <a href="/dashboard" class="hover:text-blue-500 transition-colors flex items-center gap-1">
            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
            Projects
        </a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/monitors" class="hover:text-white transition-colors">@project.Name</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-white">Integrations</span>
    </div>

    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white flex items-center gap-3">
                <i data-lucide="zap" class="text-blue"></i>
                Integrations
            </h1>
            <p class="text-text-secondary mt-1">Manage where you receive notifications for this project.</p>
        </div>
    </div>

    <!-- 1. Connected Integrations (Top) -->
    <section class="mb-12">
        <h2 class="text-xs font-black uppercase tracking-widest text-text-secondary mb-4 flex items-center gap-2">
            <i data-lucide="link" class="w-3.5 h-3.5"></i>
            Connected Integrations
        </h2>

        @if (integrations != null && integrations.Any())
        {
            <div class="grid grid-cols-1 gap-4">
                @foreach (var item in integrations)
                {
                    var integration = item.Integration;
                    var slackDetails = item.SlackDetails;
                    var teamsDetails = item.TeamsDetails;
                    var googleChatDetails = item.GoogleChatDetails;
                    var discordDetails = item.DiscordDetails;
                    var emailDetails = item.EmailDetails;
                    var pagerDutyDetails = item.PagerDutyDetails;
                    var isSlack = integration.Type == HealthyCron.Enums.IntegrationType.Slack;
                    var isTeams = integration.Type == HealthyCron.Enums.IntegrationType.Teams;
                    var isGoogleChat = integration.Type == HealthyCron.Enums.IntegrationType.GoogleChat;
                    var isDiscord = integration.Type == HealthyCron.Enums.IntegrationType.Discord;
                    var isEmail = integration.Type == HealthyCron.Enums.IntegrationType.Email;
                    var isPagerDuty = integration.Type == HealthyCron.Enums.IntegrationType.PagerDuty;

                    <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-blue-500/20 transition-all group">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
                            <div class="flex items-center gap-4">
                                @if (isSlack)
                                {
                                    <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl flex items-center justify-center shrink-0">
                                        <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"/>
                                        </svg>
                                    </div>
                                }
                                else if (isTeams)
                                {
                                    <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-500 rounded-xl flex items-center justify-center shrink-0">
                                        <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M20.625 7.5H19.5V3c0-.621-.504-1.125-1.125-1.125h-15C2.754 1.875 2.25 2.379 2.25 3v13.5c0 .621.504 1.125 1.125 1.125H7.5v2.25c0 .621.504 1.125 1.125 1.125h12c.621 0 1.125-.504 1.125-1.125v-12c0-.621-.504-1.125-1.125-1.125zM7.125 16.5H3.375V3.375h14.25v4.125h-9c-.621 0-1.125.504-1.125 1.125v7.875zm13.5 3.375h-10.5v-11.25h10.5v11.25z"/>
                                        </svg>
                                    </div>
                                }
                                else if (isGoogleChat)
                                {
                                    <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-blue-500 rounded-xl flex items-center justify-center shrink-0">
                                        <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.2L4 17.2V4h16v12z"/>
                                        </svg>
                                    </div>
                                }
                                else if (isDiscord)
                                {
                                    <div class="w-12 h-12 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center shrink-0">
                                        <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
                                        </svg>
                                    </div>
                                }
                                else if (isEmail)
                                {
                                    <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center shrink-0">
                                        <i data-lucide="mail" class="w-7 h-7 text-white"></i>
                                    </div>
                                }
                                else if (isPagerDuty)
                                {
                                    <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-red-600 rounded-xl flex items-center justify-center shrink-0">
                                        <i data-lucide="siren" class="w-7 h-7 text-white"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="w-12 h-12 bg-navy-light border border-white/5 rounded-xl flex items-center justify-center shrink-0">
                                        <i data-lucide="zap" class="w-7 h-7 text-blue-500"></i>
                                    </div>
                                }

                                <div>
                                    <h3 class="font-bold text-white text-lg">@integration.Name</h3>
                                    @if (isSlack && slackDetails != null)
                                    {
                                        <p class="text-xs text-text-secondary">Workspace: @slackDetails.WorkspaceName | Channel: #@slackDetails.ChannelName</p>
                                    }
                                    else if (isTeams && teamsDetails != null)
                                    {
                                        var maskedUrl = teamsDetails.WebhookUrl.Length > 50 
                                            ? teamsDetails.WebhookUrl.Substring(0, 50) + "..." 
                                            : teamsDetails.WebhookUrl;
                                        <p class="text-xs text-text-secondary font-mono">@maskedUrl</p>
                                    }
                                    else if (isGoogleChat && googleChatDetails != null)
                                    {
                                        if (!string.IsNullOrEmpty(googleChatDetails.SpaceName))
                                        {
                                            <p class="text-xs text-text-secondary">Space: @googleChatDetails.SpaceName</p>
                                        }
                                        else
                                        {
                                            var maskedUrl = googleChatDetails.WebhookUrl.Length > 50 
                                                ? googleChatDetails.WebhookUrl.Substring(0, 50) + "..." 
                                                : googleChatDetails.WebhookUrl;
                                            <p class="text-xs text-text-secondary font-mono">@maskedUrl</p>
                                        }
                                    }
                                    else if (isDiscord && discordDetails != null)
                                    {
                                        if (!string.IsNullOrEmpty(discordDetails.ChannelName))
                                        {
                                            <p class="text-xs text-text-secondary">Channel: @discordDetails.ChannelName</p>
                                        }
                                        else
                                        {
                                            var maskedUrl = discordDetails.WebhookUrl.Length > 50 
                                                ? discordDetails.WebhookUrl.Substring(0, 50) + "..." 
                                                : discordDetails.WebhookUrl;
                                            <p class="text-xs text-text-secondary font-mono">@maskedUrl</p>
                                        }
                                    }
                                    else if (isEmail && emailDetails != null)
                                    {
                                        <p class="text-xs text-text-secondary">@emailDetails.Email</p>
                                    }
                                    else if (isPagerDuty && pagerDutyDetails != null)
                                    {
                                        <p class="text-xs text-text-secondary">Account ID: @pagerDutyDetails.AccountId</p>
                                    }
                                </div>
                            </div>

                            <div class="flex items-center gap-2">
                                <button onclick="openMonitorSelector('@integration.Id', '@integration.Name')" 
                                        class="flex items-center gap-2 px-4 py-2 rounded-xl bg-blue/10 text-blue border border-blue-500/20 hover:bg-blue hover:text-white transition-all font-bold text-sm">
                                    <i data-lucide="list-checks" class="w-4 h-4"></i>
                                    Checks
                                </button>
                                <button disabled class="px-4 py-2 rounded-xl bg-white/5 text-text-secondary border border-white/10 opacity-50 cursor-not-allowed font-bold text-sm flex items-center gap-2">
                                    <i data-lucide="play" class="w-4 h-4"></i>
                                    Test
                                </button>
                                <button onclick="deleteIntegration('@integration.Id')" 
                                        class="px-4 py-2 rounded-xl bg-rose-500/10 text-rose-500 border border-rose-500/20 hover:bg-rose-500 hover:text-white transition-all font-bold text-sm flex items-center gap-2">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="glass-card rounded-2xl p-12 text-center border-dashed border-2 border-white/5">
                <div class="w-16 h-16 bg-white/5 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="inbox" class="w-8 h-8 text-text-secondary"></i>
                </div>
                <p class="text-text-secondary font-medium">No active integrations connected yet.</p>
                <p class="text-[10px] text-text-secondary mt-1 uppercase tracking-widest font-bold">Select a service below to get started</p>
            </div>
        }
    </section>

    <!-- 2. Available Integrations (Bottom) -->
    <section>
        <h2 class="text-xs font-black uppercase tracking-widest text-text-secondary mb-4 flex items-center gap-2">
            <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i>
            Available Integrations
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Slack -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-blue-500/20 transition-all flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl flex items-center justify-center shrink-0">
                        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold text-white">Slack</h3>
                        <p class="text-[10px] text-text-secondary uppercase tracking-widest font-black">Connected via OAuth</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/slack/authorize" 
                   class="p-2.5 rounded-xl bg-blue hover:bg-blue/80 text-white transition-all shadow-lg shadow-blue/20">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>

            <!-- Microsoft Teams -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-blue-500/20 transition-all flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-500 rounded-xl flex items-center justify-center shrink-0">
                        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.625 7.5H19.5V3c0-.621-.504-1.125-1.125-1.125h-15C2.754 1.875 2.25 2.379 2.25 3v13.5c0 .621.504 1.125 1.125 1.125H7.5v2.25c0 .621.504 1.125 1.125 1.125h12c.621 0 1.125-.504 1.125-1.125v-12c0-.621-.504-1.125-1.125-1.125zM7.125 16.5H3.375V3.375h14.25v4.125h-9c-.621 0-1.125.504-1.125 1.125v7.875zm13.5 3.375h-10.5v-11.25h10.5v11.25z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold text-white">Microsoft Teams</h3>
                        <p class="text-[10px] text-text-secondary uppercase tracking-widest font-black">Webhook Integration</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/teams/add" 
                   class="p-2.5 rounded-xl bg-blue hover:bg-blue/80 text-white transition-all shadow-lg shadow-blue/20">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>

            <!-- Google Chat -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-green-500/20 transition-all flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-blue-500 rounded-xl flex items-center justify-center shrink-0">
                        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.2L4 17.2V4h16v12z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold text-white">Google Chat</h3>
                        <p class="text-[10px] text-text-secondary uppercase tracking-widest font-black">Webhook Integration</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/googlechat/add" 
                   class="p-2.5 rounded-xl bg-green-500 hover:bg-green-600 text-white transition-all shadow-lg shadow-green-500/20">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>

            <!-- Discord -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-indigo-500/20 transition-all flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center shrink-0">
                        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold text-white">Discord</h3>
                        <p class="text-[10px] text-text-secondary uppercase tracking-widest font-black">Webhook Integration</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/discord/add" 
                   class="p-2.5 rounded-xl bg-indigo-500 hover:bg-indigo-600 text-white transition-all shadow-lg shadow-indigo-500/20">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>

            <!-- Email -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-blue-500/20 transition-all flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center shrink-0">
                        <i data-lucide="mail" class="w-6 h-6 text-white"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-white">Email</h3>
                        <p class="text-[10px] text-text-secondary uppercase tracking-widest font-black">Email Notifications</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/email/add" 
                   class="p-2.5 rounded-xl bg-blue hover:bg-blue/80 text-white transition-all shadow-lg shadow-blue/20">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>

            <!-- PagerDuty -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-orange-500/20 transition-all flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-gradient-to-br from-orange-500 to-red-600 rounded-xl flex items-center justify-center shrink-0">
                        <i data-lucide="siren" class="w-6 h-6 text-white"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-white">PagerDuty</h3>
                        <p class="text-[10px] text-text-secondary uppercase tracking-widest font-black">Incident Management</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/pagerduty/authorize" 
                   class="p-2.5 rounded-xl bg-orange-500 hover:bg-orange-600 text-white transition-all shadow-lg shadow-orange-500/20">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>
            
            <!-- Opsgenie -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 hover:border-amber-500/20 transition-all flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center shrink-0">
                        <i data-lucide="bell-ring" class="w-6 h-6 text-white"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-white">Opsgenie</h3>
                        <p class="text-[10px] text-text-secondary uppercase tracking-widest font-black">Incident Response</p>
                    </div>
                </div>
                <a href="/project/@project.Slug/integrations/opsgenie/add" 
                   class="p-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white transition-all shadow-lg shadow-amber-500/20">
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </a>
            </div>
            
            <!-- Webhook (Placeholder) -->
            <div class="glass-card rounded-2xl p-6 border border-white/5 opacity-40 grayscale flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-indigo-500 rounded-xl flex items-center justify-center shrink-0">
                        <i data-lucide="webhook" class="w-6 h-6 text-white"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-white">Webhook</h3>
                        <p class="text-[10px] text-text-secondary uppercase tracking-widest font-black">Custom endpoints</p>
                    </div>
                </div>
                <button disabled class="p-2.5 rounded-xl bg-white/5 text-text-secondary border border-white/10 cursor-not-allowed">
                    <span class="text-[10px] font-black uppercase">Soon</span>
                </button>
            </div>
        </div>
    </section>
</div>

<!-- Monitor Selector Modal -->
<div id="monitorSelectorModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen p-4">
        <!-- Overlay -->
        <div class="fixed inset-0 bg-black/80 transition-opacity" onclick="closeMonitorSelector()"></div>

        <!-- Modal Panel -->
        <div class="inline-block bg-navy-light rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:max-w-xl w-full border border-border-color relative z-10">
            <div class="px-6 py-4 border-b border-border-color flex justify-between items-center bg-navy/50">
                <h3 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="list-checks" class="text-blue-500"></i>
                    Manage Monitors
                </h3>
                <button type="button" onclick="closeMonitorSelector()" class="text-text-secondary hover:text-white transition-colors">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>

            <div class="p-6">
                <div class="mb-4">
                    <h4 id="integrationNameRef" class="text-white font-bold opacity-50 uppercase text-[10px] tracking-widest mb-1">Integration</h4>
                    <p class="text-sm text-text-secondary">Select which monitors should trigger notifications for this integration.</p>
                </div>

                <div id="monitorsContainer" class="max-h-[300px] overflow-y-auto space-y-2 pr-2">
                    <!-- Loaded via JS -->
                    <div class="animate-pulse flex space-y-4 flex-col">
                        <div class="h-10 bg-white/5 rounded-xl"></div>
                        <div class="h-10 bg-white/5 rounded-xl"></div>
                        <div class="h-10 bg-white/5 rounded-xl"></div>
                    </div>
                </div>
            </div>

            <div class="bg-navy/50 px-6 py-4 flex justify-end gap-3 border-t border-border-color">
                <button type="button" onclick="closeMonitorSelector()" class="px-5 py-2 rounded-xl text-text-secondary hover:text-white font-bold text-sm">
                    Cancel
                </button>
                <button type="button" onclick="saveMonitorSelection()" id="saveMappingBtn" class="bg-blue hover:bg-blue/80 text-white px-8 py-2 rounded-xl font-black text-sm transition-all shadow-lg shadow-blue/20">
                    Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentIntegrationId = null;

    async function openMonitorSelector(integrationId, name) {
        currentIntegrationId = integrationId;
        document.getElementById('integrationNameRef').innerText = name;
        document.getElementById('monitorSelectorModal').classList.remove('hidden');
        
        const container = document.getElementById('monitorsContainer');
        container.innerHTML = '<div class="flex justify-center py-8"><div class="w-8 h-8 border-4 border-blue border-t-transparent rounded-full animate-spin"></div></div>';

        try {
            const response = await fetch(`/integrations/${integrationId}/monitors`);
            const data = await response.json();
            
            if (data.monitors && data.monitors.length > 0) {
                container.innerHTML = data.monitors.map(m => `
                    <label class="flex items-center justify-between p-4 rounded-xl bg-navy hover:bg-white/5 border border-border-color cursor-pointer transition-all">
                        <span class="text-white font-bold text-sm">${m.name}</span>
                        <input type="checkbox" name="monitorIds" value="${m.id}" ${m.isSelected ? 'checked' : ''} 
                               class="w-5 h-5 rounded border-border-color bg-navy text-blue focus:ring-blue focus:ring-offset-navy">
                    </label>
                `).join('');
            } else {
                container.innerHTML = '<p class="text-center py-8 text-text-secondary text-sm">No monitors found in this project.</p>';
            }
        } catch (error) {
            container.innerHTML = '<p class="text-center py-8 text-rose-500 text-sm">Failed to load monitors.</p>';
        }
        
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function closeMonitorSelector() {
        document.getElementById('monitorSelectorModal').classList.add('hidden');
    }

    async function saveMonitorSelection() {
        const btn = document.getElementById('saveMappingBtn');
        const checkboxes = document.querySelectorAll('input[name="monitorIds"]:checked');
        const monitorIds = Array.from(checkboxes).map(cb => cb.value);

        btn.disabled = true;
        btn.innerText = 'Saving...';

        try {
            const response = await fetch(`/integrations/${currentIntegrationId}/monitors`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(monitorIds)
            });

            if (response.ok) {
                closeMonitorSelector();
            } else {
                alert('Failed to save monitor mapping.');
            }
        } catch (error) {
            alert('An error occurred while saving.');
        } finally {
            btn.disabled = false;
            btn.innerText = 'Save Changes';
        }
    }

    async function deleteIntegration(id) {
        if (!confirm('Are you sure you want to delete this integration?')) return;

        try {
            const response = await fetch(`/integrations/${id}/delete`, {
                method: 'POST'
            });

            if (response.ok) {
                window.location.reload();
            } else {
                alert('Failed to delete integration.');
            }
        } catch (error) {
            console.error(error);
            alert('An error occurred while deleting.');
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>
