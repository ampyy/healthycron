@{
    ViewData["Title"] = "Select PagerDuty Service";
    var services = ViewBag.Services as List<HealthyCron.Logic.Service.PagerDutyServiceInfo>;
    var sessionId = ViewBag.SessionId as string;
    var accountName = ViewBag.AccountName as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 min-h-screen flex items-center justify-center p-6">
    <div class="max-w-2xl w-full">
        <!-- Logo and Header -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-hc-amber to-red-600 rounded-2xl shadow-2xl shadow-hc-amber/20 mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-white">
                    <path d="M10.5 20.5 10 21a2 2 0 0 1-2.828 0L4.343 18.172a2 2 0 0 1 0-2.828l17-17a2 2 0 0 1 2.828 0L21 1l.5.5"/>
                    <path d="m15 5 4 4"/>
                </svg>
            </div>
            <h1 class="text-3xl font-bold text-white mb-2">Connect PagerDuty</h1>
            <p class="text-slate-400">Account: <span class="text-white font-medium">@accountName</span></p>
        </div>

        <!-- Main Card -->
        <div class="bg-slate-800/50 backdrop-blur-xl border border-slate-700/50 rounded-2xl p-8 shadow-2xl">
            <div class="mb-6">
                <h2 class="text-xl font-semibold text-white mb-2">Select a Service</h2>
                <p class="text-slate-400 text-sm">Choose which PagerDuty service should receive incidents from HealthyCron monitors.</p>
            </div>

            <form action="/integrations/pagerduty/complete" method="POST">
                <input type="hidden" name="session" value="@sessionId" />

                <div class="space-y-3 mb-6">
                    @if (services != null && services.Any())
                    {
                        @foreach (var service in services)
                        {
                            <label class="flex items-center p-4 bg-slate-700/30 hover:bg-slate-700/50 border border-slate-600/50 hover:border-hc-amber/50 rounded-xl cursor-pointer transition-all group">
                                <input type="radio" name="serviceId" value="@service.Id" required class="w-5 h-5 text-hc-amber focus:ring-hc-amber focus:ring-offset-slate-800" />
                                <div class="ml-4 flex-1">
                                    <div class="flex items-center gap-2">
                                        <p class="text-white font-medium">@service.Name</p>
                                        @if (!string.IsNullOrEmpty(service.Status))
                                        {
                                            <span class="px-2 py-0.5 text-xs rounded-full @(service.Status == "active" ? "bg-green-500/20 text-green-400" : "bg-slate-500/20 text-slate-400")">
                                                @service.Status
                                            </span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(service.Description))
                                    {
                                        <p class="text-slate-400 text-sm mt-1">@service.Description</p>
                                    }
                                </div>
                                <i data-lucide="check-circle" class="w-5 h-5 text-hc-amber opacity-0 group-has-[:checked]:opacity-100 transition-opacity"></i>
                            </label>
                        }
                    }
                    else
                    {
                        <div class="text-center py-8 text-slate-400">
                            <p>No services found. Please create a service in your PagerDuty account first.</p>
                        </div>
                    }
                </div>

                <div class="flex gap-3">
                    <a href="/integrations" class="flex-1 px-6 py-3 bg-slate-700 hover:bg-slate-600 text-white rounded-xl font-medium transition-all text-center">
                        Cancel
                    </a>
                    <button type="submit" class="flex-1 px-6 py-3 bg-gradient-to-r from-hc-amber to-red-600 hover:from-orange-600 hover:to-red-700 text-white rounded-xl font-medium transition-all shadow-lg shadow-hc-amber/25 hover:shadow-hc-amber/40">
                        Connect Service
                    </button>
                </div>
            </form>
        </div>

        <!-- Footer Note -->
        <p class="text-center text-slate-500 text-sm mt-6">
            HealthyCron will create incidents in the selected service when monitors fail.
        </p>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
