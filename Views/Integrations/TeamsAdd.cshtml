@{
    var project = (ViewBag.Project as HealthyCron.Models.Project)!;
    var user = (ViewBag.User as HealthyCron.Models.User)!;
    ViewData["Title"] = $"{project.Name} - Add Teams Integration";
    Layout = "_DashboardLayout";
}

<div class="max-w-5xl pb-20">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-text-secondary text-sm mb-6 uppercase tracking-wider font-semibold">
        <a href="/dashboard" class="hover:text-blue-500 transition-colors flex items-center gap-1">
            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
            Projects
        </a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/monitors" class="hover:text-white transition-colors">@project.Name</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/integrations" class="hover:text-white transition-colors">Integrations</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-white">Add Teams</span>
    </div>

    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-4 mb-3">
            <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-purple-500 rounded-2xl flex items-center justify-center shrink-0">
                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.625 7.5H19.5V3c0-.621-.504-1.125-1.125-1.125h-15C2.754 1.875 2.25 2.379 2.25 3v13.5c0 .621.504 1.125 1.125 1.125H7.5v2.25c0 .621.504 1.125 1.125 1.125h12c.621 0 1.125-.504 1.125-1.125v-12c0-.621-.504-1.125-1.125-1.125zM7.125 16.5H3.375V3.375h14.25v4.125h-9c-.621 0-1.125.504-1.125 1.125v7.875zm13.5 3.375h-10.5v-11.25h10.5v11.25z"/>
                </svg>
            </div>
            <div>
                <h1 class="text-3xl font-bold text-white">Add Teams Integration</h1>
                <p class="text-text-secondary mt-1">Connect your Microsoft Teams channel</p>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-500 flex items-start gap-3">
            <i data-lucide="alert-circle" class="w-5 h-5 mt-0.5 shrink-0"></i>
            <p class="text-sm font-medium">@TempData["Error"]</p>
        </div>
    }

    <!-- Instructions -->
    <div class="glass-card rounded-2xl p-6 border border-blue-500/20 bg-blue-500/5 mb-6">
        <h2 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
            <i data-lucide="info" class="w-5 h-5 text-blue-500"></i>
            How to get your Teams Webhook URL
        </h2>
        <ol class="space-y-2 text-sm text-text-secondary ml-7 list-decimal">
            <li>Open your Microsoft Teams channel</li>
            <li>Click the three dots (⋯) next to the channel name</li>
            <li>Select <strong class="text-white">Connectors</strong> or <strong class="text-white">Workflows</strong></li>
            <li>
                <strong class="text-white">Legacy method:</strong> Search for and add <strong class="text-white">"Incoming Webhook"</strong><br/>
                <strong class="text-white">New method:</strong> Create a workflow with "When a Teams webhook request is received" trigger
            </li>
            <li>Copy the webhook URL and paste it below</li>
        </ol>
        <div class="mt-3 pt-3 border-t border-blue-500/20">
            <p class="text-xs text-text-secondary">
                <strong class="text-white">Supported formats:</strong><br/>
                • Legacy: <code class="text-xs bg-hc-black px-1.5 py-0.5 rounded">https://outlook.office.com/webhook/...</code><br/>
                • Power Automate: <code class="text-xs bg-hc-black px-1.5 py-0.5 rounded">https://*.api.powerplatform.com/.../invoke?...&sig=...</code>
            </p>
        </div>
    </div>

    <!-- Form -->
    <form method="post" action="/project/@project.Slug/integrations/teams" class="glass-card rounded-2xl p-8 border border-white/5">
        <div class="space-y-6">
            <!-- Webhook URL -->
            <div>
                <label for="webhookUrl" class="block text-sm font-bold text-white mb-2">
                    Webhook URL <span class="text-rose-500">*</span>
                </label>
                <input 
                    type="url" 
                    id="webhookUrl" 
                    name="webhookUrl" 
                    required
                    placeholder="https://outlook.office.com/webhook/... or https://*.api.powerplatform.com/..."
                    class="w-full px-4 py-3 rounded-xl bg-hc-black border border-border-color text-white placeholder-text-secondary focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
                />
                <p class="mt-2 text-xs text-text-secondary">Supports both legacy Outlook webhooks and new Power Automate webhooks</p>
            </div>

            <!-- Integration Name (Optional) -->
            <div>
                <label for="name" class="block text-sm font-bold text-white mb-2">
                    Integration Name <span class="text-text-secondary text-xs font-normal">(Optional)</span>
                </label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    placeholder="Microsoft Teams - #alerts"
                    class="w-full px-4 py-3 rounded-xl bg-hc-black border border-border-color text-white placeholder-text-secondary focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
                />
                <p class="mt-2 text-xs text-text-secondary">If left empty, will default to "Microsoft Teams"</p>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-end gap-3 mt-8 pt-6 border-t border-white/5">
            <a href="/project/@project.Slug/integrations" class="px-6 py-2.5 rounded-xl text-text-secondary hover:text-white font-bold text-sm transition-colors">
                Cancel
            </a>
            <button type="submit" class="bg-blue hover:bg-blue/80 text-white px-8 py-2.5 rounded-xl font-black text-sm transition-all shadow-lg shadow-blue/20 flex items-center gap-2">
                <i data-lucide="plus" class="w-4 h-4"></i>
                Add Integration
            </button>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>
