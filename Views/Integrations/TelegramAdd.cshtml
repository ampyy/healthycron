@{
    var project = ViewBag.Project as HealthyCron.Models.Project;
    var user = ViewBag.User as HealthyCron.Models.User;
    ViewData["Title"] = $"{project?.Name} - Add Telegram Integration";
    Layout = "_DashboardLayout";
}

<div class="max-w-2xl mx-auto pb-20 mt-8">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-text-secondary text-sm mb-6 uppercase tracking-wider font-semibold">
        <a href="/dashboard" class="hover:text-amber-500 transition-colors flex items-center gap-1">
            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
            Projects
        </a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project?.Slug/monitors" class="hover:text-white transition-colors">@project?.Name</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project?.Slug/integrations" class="hover:text-white transition-colors">Integrations</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-white">Add Telegram</span>
    </div>

    <!-- Header -->
    <div class="mb-8 border-b border-[#262626] pb-6">
        <div class="flex items-center gap-4 mb-3">
            <div class="w-14 h-14 bg-amber-500/10 border border-amber-500/20 rounded-2xl flex items-center justify-center shrink-0">
                <i data-lucide="send" class="w-7 h-7 text-amber-500"></i>
            </div>
            <div>
                <h1 class="text-3xl font-bold text-white">Add Telegram Integration</h1>
                <p class="text-[15px] text-[#A3A3A3] mt-1">Get instant alerts sent directly to your Telegram chat, group, or channel.</p>
            </div>
        </div>
    </div>

    <!-- Instruction Steps -->
    <div class="relative pt-2">
        <div class="absolute left-6 top-8 bottom-8 w-px bg-[#262626]"></div>

        <div class="space-y-6">
            <!-- Step 1 -->
            <div class="relative pl-16 group">
                <div class="absolute left-2 top-2 flex h-8 w-8 items-center justify-center rounded-full bg-[#0a0a0a] border-2 border-[#262626] text-[#A3A3A3] font-bold text-sm z-10 transition-colors duration-300 group-hover:border-amber-500 group-hover:text-amber-500 bg-[#000000]">
                    1
                </div>
                <div class="rounded-2xl border border-[#262626] bg-[#0a0a0a] p-6 transition-all duration-300">
                    <h3 class="text-lg font-bold text-white mb-2">Add our bot to your chat</h3>
                    <p class="text-[15px] text-[#A3A3A3]">Invite <span class="px-2 py-1 rounded bg-[#1A1A1A] border border-[#333333] text-white font-mono text-xs mx-1">@@healthycron_bot</span> to any Telegram chat to begin.</p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="relative pl-16 group">
                <div class="absolute left-2 top-2 flex h-8 w-8 items-center justify-center rounded-full bg-[#0a0a0a] border-2 border-[#262626] text-[#A3A3A3] font-bold text-sm z-10 transition-colors duration-300 group-hover:border-amber-500 group-hover:text-amber-500 bg-[#000000]">
                    2
                </div>
                <div class="rounded-2xl border border-[#262626] bg-[#0a0a0a] p-6 transition-all duration-300">
                    <h3 class="text-lg font-bold text-white mb-2">Send the start command</h3>
                    <p class="text-[15px] text-[#A3A3A3] mb-4">Send this command into the chat where the bot was added to initiate the handshake:</p>
                    <div class="flex items-center justify-between p-1.5 pl-4 rounded-xl bg-black border border-[#262626]">
                        <code class="text-amber-500 font-mono text-sm leading-none pt-0.5">/start@@healthycron_bot</code>
                        <button type="button" onclick="navigator.clipboard.writeText('/start@@healthycron_bot')" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#1A1A1A] hover:bg-amber-500 hover:text-black text-white transition-all duration-200 text-xs font-semibold">
                            <i data-lucide="copy" class="w-3.5 h-3.5"></i> Copy
                        </button>
                    </div>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="relative pl-16 group">
                <div class="absolute left-2 top-2 flex h-8 w-8 items-center justify-center rounded-full bg-[#0a0a0a] border-2 border-[#262626] text-[#A3A3A3] font-bold text-sm z-10 transition-colors duration-300 group-hover:border-amber-500 group-hover:text-amber-500 bg-[#000000]">
                    3
                </div>
                <div class="rounded-2xl border border-[#262626] bg-[#0a0a0a] p-6 transition-all duration-300">
                    <h3 class="text-lg font-bold text-white mb-2">Click the confirmation link</h3>
                    <p class="text-[15px] text-[#A3A3A3]">The bot will immediately reply with a secure link. Click it to finalize the setup.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>
