@{
    var project = (ViewBag.Project as HealthyCron.Models.Project)!;
    ViewData["Title"] = "Add Telegram Integration";
    Layout = "_DashboardLayout";
}

<div class="max-w-xl mx-auto pb-20">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-text-secondary text-sm mb-6 tracking-wider font-semibold">
        <a href="/dashboard" class="hover:text-white transition-colors flex items-center gap-1">
            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i> Projects
        </a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/monitors" class="hover:text-white transition-colors">@project.Name</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/integrations" class="hover:text-white transition-colors">Integrations</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-white">Telegram</span>
    </div>

    <!-- Header -->
    <div class="flex items-center gap-4 mb-8">
        <div class="w-12 h-12 rounded-2xl bg-[#26A5E4]/10 border border-[#26A5E4]/20 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-[#26A5E4]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
        </div>
        <div>
            <h1 class="text-2xl font-bold text-white">Add Telegram Integration</h1>
            <p class="text-text-secondary text-sm mt-0.5">Get instant alerts in any Telegram chat, group, or channel</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm font-medium">
            <i data-lucide="alert-circle" class="w-4 h-4 inline mr-2"></i>@TempData["Error"]
        </div>
    }

    <div class="glass-card rounded-2xl p-8 border border-white/5">
        <form method="POST" action="/project/@project.Slug/integrations/telegram">
            @Html.AntiForgeryToken()

            <!-- Integration Name -->
            <div class="mb-6">
                <label class="block text-sm font-semibold text-white mb-2">Integration Name</label>
                <input type="text" name="name" placeholder="e.g. Dev Team Telegram"
                    class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-text-secondary focus:outline-none focus:ring-2 focus:ring-[#26A5E4]/50 transition-all">
            </div>

            <!-- Chat ID -->
            <div class="mb-2">
                <label class="block text-sm font-semibold text-white mb-2">Chat ID <span class="text-rose-400">*</span></label>
                <div class="flex gap-2">
                    <input type="text" name="chatId" id="chatIdInput" required placeholder="-1001234567890"
                        class="flex-1 bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-text-secondary focus:outline-none focus:ring-2 focus:ring-[#26A5E4]/50 transition-all font-mono">
                    <button type="button" onclick="resolveChatId()"
                        class="px-4 py-3 rounded-xl bg-[#26A5E4]/10 border border-[#26A5E4]/20 text-[#26A5E4] hover:bg-[#26A5E4]/20 transition-all text-sm font-bold whitespace-nowrap flex items-center gap-2">
                        <i data-lucide="search" class="w-4 h-4"></i>
                        Find my Chat ID
                    </button>
                </div>
            </div>

            <!-- Chat ID Helper -->
            <div class="mb-6">
                <button type="button" onclick="toggleInstructions()"
                    class="text-xs text-[#26A5E4] hover:underline flex items-center gap-1 mt-1">
                    <i data-lucide="help-circle" class="w-3.5 h-3.5"></i>
                    Don't know your Chat ID?
                </button>
                <div id="telegramInstructions" class="hidden mt-3 p-4 rounded-xl bg-[#26A5E4]/5 border border-[#26A5E4]/15 text-sm text-text-secondary space-y-1.5">
                    <p class="font-semibold text-white text-xs uppercase tracking-widest mb-2">How to get your Chat ID</p>
                    <p>1. Start a chat with our bot: <span class="font-mono text-[#26A5E4]">@@healthycron_bot</span></p>
                    <p>2. Send any message to the bot (e.g. "hello")</p>
                    <p>3. Click <strong class="text-white">Find my Chat ID</strong> above to auto-detect it</p>
                    <p class="text-xs mt-2 opacity-60">For groups/channels, add the bot as an admin first.</p>
                </div>
                <p id="resolveStatus" class="text-xs mt-1 hidden"></p>
            </div>

            <!-- Chat Name (optional) -->
            <div class="mb-8">
                <label class="block text-sm font-semibold text-white mb-2">
                    Chat Name <span class="text-text-secondary font-normal">(optional)</span>
                </label>
                <input type="text" name="chatName" id="chatNameInput" placeholder="e.g. Engineering Alerts"
                    class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-text-secondary focus:outline-none focus:ring-2 focus:ring-[#26A5E4]/50 transition-all">
                <p class="text-xs text-text-secondary mt-1">Just a label for your own reference.</p>
            </div>

            <div class="flex gap-3">
                <a href="/project/@project.Slug/integrations"
                    class="flex-1 text-center px-6 py-3 rounded-xl border border-white/10 text-text-secondary hover:text-white hover:bg-white/5 transition-all font-bold">
                    Cancel
                </a>
                <button type="submit"
                    class="flex-1 bg-[#26A5E4] hover:bg-[#26A5E4]/80 text-white px-6 py-3 rounded-xl font-bold transition-all shadow-lg shadow-[#26A5E4]/20">
                    Connect Telegram
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleInstructions() {
        document.getElementById('telegramInstructions').classList.toggle('hidden');
    }

    async function resolveChatId() {
        const status = document.getElementById('resolveStatus');
        status.className = 'text-xs mt-1 text-[#26A5E4]';
        status.textContent = 'Searching for recent messages…';
        status.classList.remove('hidden');

        try {
            const resp = await fetch('/api/v1/integrations/telegram/resolve-chat-id');
            const data = await resp.json();
            if (resp.ok) {
                document.getElementById('chatIdInput').value = data.chat_id;
                if (data.chat_name) document.getElementById('chatNameInput').value = data.chat_name;
                status.className = 'text-xs mt-1 text-emerald-400';
                status.textContent = `✓ Found: ${data.chat_name || data.chat_id}`;
            } else {
                status.className = 'text-xs mt-1 text-rose-400';
                status.textContent = data.error || 'Could not resolve Chat ID.';
                document.getElementById('telegramInstructions').classList.remove('hidden');
            }
        } catch (e) {
            status.className = 'text-xs mt-1 text-rose-400';
            status.textContent = 'Failed to contact server.';
        }
    }

    document.addEventListener('DOMContentLoaded', () => { if (typeof lucide !== 'undefined') lucide.createIcons(); });
</script>
