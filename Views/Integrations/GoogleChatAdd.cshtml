@{
    var project = (ViewBag.Project as HealthyCron.Models.Project)!;
    var user = (ViewBag.User as HealthyCron.Models.User)!;
    ViewData["Title"] = $"{project.Name} - Add Google Chat Integration";
    Layout = "_DashboardLayout";
}

<div class="max-w-2xl mx-auto pb-20">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-text-secondary text-sm mb-6 uppercase tracking-wider font-semibold">
        <a href="/dashboard" class="hover:text-blue-500 transition-colors flex items-center gap-1">
            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
            Projects
        </a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/monitors" class="hover:text-white transition-colors">@project.Name</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/integrations" class="hover:text-white transition-colors">Integrations</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-white">Add Google Chat</span>
    </div>

    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-4 mb-3">
            <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-blue-500 rounded-2xl flex items-center justify-center shrink-0">
                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.2L4 17.2V4h16v12z"/>
                </svg>
            </div>
            <div>
                <h1 class="text-3xl font-bold text-white">Add Google Chat Integration</h1>
                <p class="text-text-secondary mt-1">Connect your Google Chat space</p>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-500 flex items-start gap-3">
            <i data-lucide="alert-circle" class="w-5 h-5 mt-0.5 shrink-0"></i>
            <p class="text-sm font-medium">@TempData["Error"]</p>
        </div>
    }

    <!-- Instructions -->
    <div class="glass-card rounded-2xl p-6 border border-green-500/20 bg-green-500/5 mb-6">
        <h2 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
            <i data-lucide="info" class="w-5 h-5 text-green-500"></i>
            How to get your Google Chat Webhook URL
        </h2>
        <ol class="space-y-2 text-sm text-text-secondary ml-7 list-decimal">
            <li>Open Google Chat and navigate to the space where you want to receive alerts</li>
            <li>Click the space name at the top to open the menu</li>
            <li>Select <strong class="text-white">Apps & integrations</strong></li>
            <li>Click <strong class="text-white">Add webhooks</strong></li>
            <li>Give the webhook a name (e.g., "HealthyCron Alerts")</li>
            <li>Copy the webhook URL and paste it below</li>
        </ol>
        <div class="mt-3 pt-3 border-t border-green-500/20">
            <p class="text-xs text-text-secondary">
                <strong class="text-white">URL format:</strong><br/>
                <code class="text-xs bg-navy px-1.5 py-0.5 rounded">https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...</code>
            </p>
        </div>
    </div>

    <!-- Form -->
    <form method="post" action="/project/@project.Slug/integrations/googlechat" class="glass-card rounded-2xl p-8 border border-white/5">
        <div class="space-y-6">
            <!-- Webhook URL -->
            <div>
                <label for="webhookUrl" class="block text-sm font-bold text-white mb-2">
                    Webhook URL <span class="text-rose-500">*</span>
                </label>
                <input 
                    type="url" 
                    id="webhookUrl" 
                    name="webhookUrl" 
                    required
                    placeholder="https://chat.googleapis.com/v1/spaces/..."
                    class="w-full px-4 py-3 rounded-xl bg-navy border border-border-color text-white placeholder-text-secondary focus:border-green-500 focus:ring-2 focus:ring-green-500/20 transition-all"
                />
                <p class="mt-2 text-xs text-text-secondary">The Google Chat webhook URL from your space settings</p>
            </div>

            <!-- Integration Name (Optional) -->
            <div>
                <label for="name" class="block text-sm font-bold text-white mb-2">
                    Integration Name <span class="text-text-secondary text-xs font-normal">(Optional)</span>
                </label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    placeholder="Google Chat - Alerts"
                    class="w-full px-4 py-3 rounded-xl bg-navy border border-border-color text-white placeholder-text-secondary focus:border-green-500 focus:ring-2 focus:ring-green-500/20 transition-all"
                />
                <p class="mt-2 text-xs text-text-secondary">If left empty, will default to "Google Chat"</p>
            </div>

            <!-- Space Name (Optional) -->
            <div>
                <label for="spaceName" class="block text-sm font-bold text-white mb-2">
                    Space Name <span class="text-text-secondary text-xs font-normal">(Optional)</span>
                </label>
                <input 
                    type="text" 
                    id="spaceName" 
                    name="spaceName" 
                    placeholder="Alerts & Monitoring"
                    class="w-full px-4 py-3 rounded-xl bg-navy border border-border-color text-white placeholder-text-secondary focus:border-green-500 focus:ring-2 focus:ring-green-500/20 transition-all"
                />
                <p class="mt-2 text-xs text-text-secondary">Optional space name for easier identification</p>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-end gap-3 mt-8 pt-6 border-t border-white/5">
            <a href="/project/@project.Slug/integrations" class="px-6 py-2.5 rounded-xl text-text-secondary hover:text-white font-bold text-sm transition-colors">
                Cancel
            </a>
            <button type="submit" class="bg-green-500 hover:bg-green-600 text-white px-8 py-2.5 rounded-xl font-black text-sm transition-all shadow-lg shadow-green-500/20 flex items-center gap-2">
                <i data-lucide="plus" class="w-4 h-4"></i>
                Add Integration
            </button>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>
