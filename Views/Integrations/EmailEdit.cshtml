@{
    var project = (ViewBag.Project as HealthyCron.Models.Project)!;
    var integration = (ViewBag.Integration as HealthyCron.Models.Integration)!;
    var emailDetails = (ViewBag.EmailDetails as HealthyCron.Models.EmailIntegration)!;
    ViewData["Title"] = $"{project.Name} - Edit Email Integration";
    Layout = "_DashboardLayout";
}

<div class="max-w-5xl ml-0 pb-20 px-4 sm:px-6 lg:px-8 mt-8">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-text-secondary text-xs mb-6 uppercase tracking-wider font-semibold flex-wrap">
        <a href="/dashboard" class="hover:text-blue-500 transition-colors flex items-center gap-1">
            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
            Projects
        </a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/monitors" class="hover:text-white transition-colors">@project.Name</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/integrations" class="hover:text-white transition-colors">Integrations</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-white">Edit Email</span>
    </div>

    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-4 mb-3">
            <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center shrink-0">
                <i data-lucide="mail" class="w-6 h-6 text-white"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-white">Edit Email Integration</h1>
                <p class="text-text-secondary mt-0.5 text-sm">Update your email notification settings</p>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 flex items-start gap-3">
            <i data-lucide="alert-circle" class="w-4 h-4 mt-0.5 shrink-0"></i>
            <p class="text-sm">@TempData["Error"]</p>
        </div>
    }

    <!-- Form -->
    <form method="post" action="/project/@project.Slug/integrations/email/@integration.Id/edit" class="glass-card rounded-2xl p-6 border border-white/5 space-y-5">
        <!-- Email Address -->
        <div>
            <label for="email" class="block text-sm font-semibold text-white mb-2">
                Email Address <span class="text-red-500">*</span>
            </label>
            <input
                type="email"
                id="email"
                name="email"
                required
                value="@emailDetails.Email"
                placeholder="alerts@example.com"
                class="w-full px-4 py-3 rounded-xl bg-[#141414] border border-[#262626] text-white placeholder-text-secondary focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all text-sm"
            />
            <p class="mt-2 text-xs text-text-secondary">The email address where notifications will be sent</p>
        </div>

        <!-- Integration Name -->
        <div>
            <label for="name" class="block text-sm font-semibold text-white mb-2">
                Integration Name <span class="text-text-secondary text-xs font-normal">(Optional)</span>
            </label>
            <input
                type="text"
                id="name"
                name="name"
                value="@integration.Name"
                placeholder="Team Alerts Email"
                class="w-full px-4 py-3 rounded-xl bg-[#141414] border border-[#262626] text-white placeholder-text-secondary focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all text-sm"
            />
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-between gap-3 pt-4 border-t border-white/5">
            <a href="/project/@project.Slug/integrations" class="px-4 py-2.5 rounded-xl text-text-secondary hover:text-white font-semibold text-sm transition-colors border border-white/10 hover:border-white/20">
                Cancel
            </a>
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-xl font-semibold text-sm transition-all flex items-center gap-2">
                <i data-lucide="save" class="w-4 h-4"></i>
                Save Changes
            </button>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>
