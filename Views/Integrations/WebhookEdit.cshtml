@{
    var project = (ViewBag.Project as HealthyCron.Models.Project)!;
    var integration = (ViewBag.Integration as HealthyCron.Models.Integration)!;
    var wh = (ViewBag.WebhookDetails as HealthyCron.Models.WebhookIntegration)!;
    ViewData["Title"] = $"{project.Name} - Edit Webhook Integration";
    Layout = "_DashboardLayout";
    var errorMsg = TempData["Error"] as string;
}

<div class="max-w-5xl ml-0 pb-20 px-4 sm:px-6 lg:px-8 mt-8">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-text-secondary text-xs mb-6 uppercase tracking-wider font-semibold flex-wrap">
        <a href="/dashboard" class="hover:text-blue-400 transition-colors flex items-center gap-1">
            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
            Projects
        </a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/monitors" class="hover:text-white transition-colors">@project.Name</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/integrations" class="hover:text-white transition-colors">Integrations</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-white">Edit Webhook</span>
    </div>

    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-4 mb-3">
            <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/20 rounded-xl flex items-center justify-center shrink-0">
                <i data-lucide="webhook" class="w-6 h-6 text-blue-400"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-white">Edit Webhook</h1>
                <p class="text-sm text-text-secondary mt-0.5">Update your webhook integration settings</p>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="mb-6 flex items-center gap-3 rounded-xl bg-red-500/10 border border-red-500/20 px-4 py-3 text-red-400 text-sm font-medium">
            <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
            @errorMsg
        </div>
    }

    <form method="post" action="/project/@project.Slug/integrations/webhook/@integration.Id/edit" id="webhook-form">
        <!-- Integration Name -->
        <div class="glass-card rounded-2xl border border-[#262626] bg-[#0a0a0a] p-6 mb-4">
            <label class="block text-sm font-bold text-white mb-2">Integration Name</label>
            <input type="text" name="name" value="@integration.Name" placeholder="e.g. My API Alerting"
                   class="w-full bg-[#141414] border border-[#262626] rounded-xl px-4 py-3 text-[15px] text-white placeholder-[#737373] focus:border-blue-500 hover:border-[#404040] focus:ring-1 focus:ring-blue-500 outline-none transition-all" />
        </div>

        <!-- Two-column webhook config -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
            <!-- DOWN column -->
            <div class="glass-card rounded-2xl border border-red-500/20 bg-[#0a0a0a] p-6 relative overflow-hidden">
                <div class="absolute -top-24 -left-24 w-48 h-48 bg-red-500/5 blur-[60px] rounded-full pointer-events-none"></div>
                <h2 class="text-base font-black text-red-400 uppercase tracking-widest mb-5 flex items-center gap-2">
                    <i data-lucide="arrow-down-circle" class="w-4 h-4"></i>
                    DOWN event
                    <span class="text-text-secondary text-[10px] border border-white/10 px-1.5 py-0.5 rounded ml-auto font-normal">Optional if UP is set</span>
                </h2>

                <div class="space-y-4 relative z-10">
                    <div>
                        <label class="block text-xs font-bold text-white/70 uppercase tracking-wider mb-2">URL</label>
                        <div class="flex gap-2">
                            <select name="downMethod" id="down_method" class="bg-[#141414] border border-[#262626] rounded-xl px-3 py-3 text-[14px] text-white focus:border-red-500 focus:ring-1 focus:ring-red-500 outline-none transition-all">
                                @if(wh.DownMethod == "POST") { <option value="POST" selected>POST</option> } else { <option value="POST">POST</option> }
                                @if(wh.DownMethod == "GET") { <option value="GET" selected>GET</option> } else { <option value="GET">GET</option> }
                                @if(wh.DownMethod == "PUT") { <option value="PUT" selected>PUT</option> } else { <option value="PUT">PUT</option> }
                            </select>
                            <input type="url" name="downUrl" id="down_url" value="@wh.DownUrl" placeholder="https://example.com/alert"
                                   class="flex-1 bg-[#141414] border border-[#262626] rounded-xl px-4 py-3 text-[14px] text-white placeholder-[#737373] focus:border-red-500 hover:border-[#404040] focus:ring-1 focus:ring-red-500 outline-none transition-all font-mono" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-white/70 uppercase tracking-wider mb-2">Request Headers</label>
                        <textarea name="downHeaders" rows="3" placeholder="X-Api-Key: your-key&#10;Content-Type: application/json"
                                  class="w-full bg-[#141414] border border-[#262626] rounded-xl px-4 py-3 text-[13px] text-white placeholder-[#737373] focus:border-red-500 hover:border-[#404040] focus:ring-1 focus:ring-red-500 outline-none transition-all font-mono resize-y">@wh.DownHeaders</textarea>
                        <p class="text-[11px] text-[#737373] mt-1">One header per line — <code class="text-[#aaa]">Name: Value</code></p>
                    </div>

                    <div id="down_body_section">
                        <label class="block text-xs font-bold text-white/70 uppercase tracking-wider mb-2">Request Body</label>
                        <textarea name="downBody" rows="4" placeholder='{"monitor": "$NAME", "status": "$STATUS"}'
                                  class="w-full bg-[#141414] border border-[#262626] rounded-xl px-4 py-3 text-[13px] text-white placeholder-[#737373] focus:border-red-500 hover:border-[#404040] focus:ring-1 focus:ring-red-500 outline-none transition-all font-mono resize-y">@wh.DownBody</textarea>
                    </div>
                </div>
            </div>

            <!-- UP column -->
            <div class="glass-card rounded-2xl border border-green-500/20 bg-[#0a0a0a] p-6 relative overflow-hidden">
                <div class="absolute -top-24 -right-24 w-48 h-48 bg-green-500/5 blur-[60px] rounded-full pointer-events-none"></div>
                <h2 class="text-base font-black text-green-400 uppercase tracking-widest mb-2 flex items-center gap-2">
                    <i data-lucide="arrow-up-circle" class="w-4 h-4"></i>
                    UP event
                    <span class="text-text-secondary text-[10px] border border-white/10 px-1.5 py-0.5 rounded ml-auto font-normal">Optional</span>
                </h2>
                <p class="text-[12px] text-[#737373] mb-4">Leave the URL blank to skip this webhook on recovery.</p>

                <div class="space-y-4 relative z-10">
                    <div>
                        <label class="block text-xs font-bold text-white/70 uppercase tracking-wider mb-2">URL</label>
                        <div class="flex gap-2">
                            <select name="upMethod" id="up_method" class="bg-[#141414] border border-[#262626] rounded-xl px-3 py-3 text-[14px] text-white focus:border-green-500 focus:ring-1 focus:ring-green-500 outline-none transition-all">
                                @if(wh.UpMethod == "POST") { <option value="POST" selected>POST</option> } else { <option value="POST">POST</option> }
                                @if(wh.UpMethod == "GET") { <option value="GET" selected>GET</option> } else { <option value="GET">GET</option> }
                                @if(wh.UpMethod == "PUT") { <option value="PUT" selected>PUT</option> } else { <option value="PUT">PUT</option> }
                            </select>
                            <input type="url" name="upUrl" id="up_url" value="@wh.UpUrl" placeholder="https://example.com/recovered (optional)"
                                   class="flex-1 bg-[#141414] border border-[#262626] rounded-xl px-4 py-3 text-[14px] text-white placeholder-[#737373] focus:border-green-500 hover:border-[#404040] focus:ring-1 focus:ring-green-500 outline-none transition-all font-mono" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-white/70 uppercase tracking-wider mb-2">Request Headers</label>
                        <textarea name="upHeaders" rows="3" placeholder="X-Api-Key: your-key&#10;Content-Type: application/json"
                                  class="w-full bg-[#141414] border border-[#262626] rounded-xl px-4 py-3 text-[13px] text-white placeholder-[#737373] focus:border-green-500 hover:border-[#404040] focus:ring-1 focus:ring-green-500 outline-none transition-all font-mono resize-y">@wh.UpHeaders</textarea>
                        <p class="text-[11px] text-[#737373] mt-1">One header per line — <code class="text-[#aaa]">Name: Value</code></p>
                    </div>

                    <div id="up_body_section">
                        <label class="block text-xs font-bold text-white/70 uppercase tracking-wider mb-2">Request Body</label>
                        <textarea name="upBody" rows="4" placeholder='{"monitor": "$NAME", "status": "$STATUS"}'
                                  class="w-full bg-[#141414] border border-[#262626] rounded-xl px-4 py-3 text-[13px] text-white placeholder-[#737373] focus:border-green-500 hover:border-[#404040] focus:ring-1 focus:ring-green-500 outline-none transition-all font-mono resize-y">@wh.UpBody</textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-between gap-3">
            <a href="/project/@project.Slug/integrations" class="px-4 py-2.5 rounded-xl text-text-secondary hover:text-white font-semibold text-sm transition-colors border border-white/10 hover:border-white/20">
                Cancel
            </a>
            <button type="submit" id="save-btn"
                    class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-2.5 rounded-xl font-semibold text-sm transition-all flex items-center gap-2 outline-none">
                <i data-lucide="save" class="w-4 h-4"></i>
                Save Changes
            </button>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
        updateBodyVisibility('down');
        updateBodyVisibility('up');
    });

    document.getElementById('down_method').addEventListener('change', () => updateBodyVisibility('down'));
    document.getElementById('up_method').addEventListener('change', () => updateBodyVisibility('up'));

    function updateBodyVisibility(side) {
        const method = document.getElementById(`${side}_method`).value;
        const section = document.getElementById(`${side}_body_section`);
        section.style.display = (method === 'GET') ? 'none' : 'block';
    }

    document.getElementById('webhook-form').addEventListener('submit', function() {
        const btn = document.getElementById('save-btn');
        btn.disabled = true;
        btn.innerHTML = '<div class="h-4 w-4 animate-spin rounded-full border-2 border-white border-r-transparent"></div> Saving...';
    });
</script>
