@{
    var project = ViewBag.Project as HealthyCron.Models.Project;
    var user = ViewBag.User as HealthyCron.Models.User;
    ViewData["Title"] = $"{project?.Name} - Add Pushover Integration";
    Layout = "_DashboardLayout";
}

<div class="max-w-5xl pb-20 mt-8">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-hc-muted text-sm mb-6 uppercase tracking-wider font-semibold">
        <a href="/dashboard" class="hover:text-hc-amber transition-colors flex items-center gap-1">
            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
            Projects
        </a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project?.Slug/monitors" class="hover:text-white transition-colors">@project?.Name</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project?.Slug/integrations" class="hover:text-white transition-colors">Integrations</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-white">Add Pushover</span>
    </div>

    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-4 mb-3">
            <div class="w-14 h-14 bg-hc-amber/10 border border-hc-amber/20 rounded-2xl flex items-center justify-center shrink-0">
                <i data-lucide="bell-ring" class="w-7 h-7 text-hc-amber"></i>
            </div>
            <div>
                <h1 class="text-3xl font-bold text-white">Add Pushover Integration</h1>
                <p class="text-[15px] text-[#A3A3A3] mt-1">Receive high-priority alerts via Pushover</p>
            </div>
        </div>
    </div>

    <!-- Content Card -->
    <div class="glass-card rounded-2xl border border-hc-border bg-[#0a0a0a] p-10 text-center relative overflow-hidden group">
        <!-- Subtle Glow -->
        <div class="absolute -top-32 -left-32 w-64 h-64 bg-hc-amber/5 blur-[80px] rounded-full pointer-events-none opacity-50"></div>

        <div class="relative">
            <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-hc-amber/10 border border-hc-amber/20 mb-6">
                <i data-lucide="smartphone" class="h-10 w-10 text-hc-amber"></i>
            </div>
            
            <h3 class="text-xl font-bold text-white mb-3">Subscribe to Notifications</h3>
            <p class="text-[#A3A3A3] mb-8 max-w-sm mx-auto text-[15px] leading-relaxed">
                You will be redirected to Pushover.net to securely authorize Healthycron to send push notifications to your devices.
            </p>

            <div id="loading" class="hidden mb-8 flex-col items-center">
                <div class="inline-block h-6 w-6 animate-spin rounded-full border-2 border-solid border-hc-amber border-r-transparent mb-3"></div>
                <p class="text-[14px] font-medium text-hc-amber">Generating secure link...</p>
            </div>

            <div class="flex items-center justify-center gap-4 pt-6 border-t border-hc-border">
                <a href="/project/@project?.Slug/integrations" class="px-6 py-2.5 rounded-xl text-[#A3A3A3] hover:text-white font-bold text-sm transition-colors">
                    Cancel
                </a>
                <button onclick="subscribePushover()" id="subscribe-btn" class="bg-amber-600 outline-none hover:bg-hc-amber text-white px-8 py-2.5 rounded-xl font-black text-sm transition-all shadow-lg shadow-hc-amber/20 flex items-center gap-2">
                    Continue to Pushover <i data-lucide="arrow-up-right" class="w-4 h-4 ml-1"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });

    async function subscribePushover() {
        const btn = document.getElementById('subscribe-btn');
        const loader = document.getElementById('loading');
        
        btn.disabled = true;
        btn.classList.add('opacity-50', 'cursor-not-allowed');
        loader.classList.remove('hidden');
        loader.classList.add('flex');

        try {
            const res = await fetch(`/api/v1/integrations/pushover/subscribe-url?project_id=@project?.Id`);
            if (res.ok) {
                const data = await res.json();
                window.location.href = data.url;
            } else {
                alert('Failed to generate subscription link.');
                resetBtn();
            }
        } catch (e) {
            alert('A network error occurred.');
            resetBtn();
        }

        function resetBtn() {
            btn.disabled = false;
            btn.classList.remove('opacity-50', 'cursor-not-allowed');
            loader.classList.add('hidden');
            loader.classList.remove('flex');
        }
    }
</script>
