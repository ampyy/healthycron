@{
    var project = (ViewBag.Project as HealthyCron.Models.Project)!;
    ViewData["Title"] = $"{project?.Name} - Add Spike.sh Integration";
    Layout = "_DashboardLayout";
}

<div class="max-w-5xl pb-20 mt-8">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-text-secondary text-sm mb-6 uppercase tracking-wider font-semibold">
        <a href="/dashboard" class="hover:text-amber-500 transition-colors flex items-center gap-1">
            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
            Projects
        </a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project?.Slug/monitors" class="hover:text-white transition-colors">@project?.Name</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project?.Slug/integrations" class="hover:text-white transition-colors">Integrations</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-white">Add Spike</span>
    </div>

    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-4 mb-3">
            <div class="w-14 h-14 bg-amber-500/10 border border-amber-500/20 rounded-2xl flex items-center justify-center shrink-0">
                <img src="/images/spike.png" class="w-7 h-7 object-contain" alt="Spike.sh" />
            </div>
            <div>
                <h1 class="text-3xl font-bold text-white">Add Spike.sh Integration</h1>
                <p class="text-[15px] text-[#A3A3A3] mt-1">Trigger incidents directly in Spike.sh when your monitors fail</p>
            </div>
        </div>
    </div>

    <!-- Form container -->
    <div class="glass-card rounded-2xl border border-[#262626] bg-[#0a0a0a] p-8 relative overflow-hidden group">
        <!-- Subtle Glow -->
        <div class="absolute -top-32 -left-32 w-64 h-64 bg-amber-500/5 blur-[80px] rounded-full pointer-events-none opacity-50"></div>

        <form id="spike-form" method="post" action="/project/@project?.Slug/integrations/spike" class="space-y-6 relative z-10">
            <div>
                <label class="block text-sm font-bold text-white mb-2">Integration Name <span class="text-amber-500">*</span></label>
                <input type="text" id="integration-name" name="name" required value="Spike.sh"
                       class="w-full bg-[#141414] border border-[#262626] rounded-xl px-4 py-3 text-[15px] text-white placeholder-[#737373] focus:border-amber-500 hover:border-[#404040] focus:ring-1 focus:ring-amber-500 outline-none transition-all shadow-inner" />
            </div>
            
            <div>
                <label class="block text-sm font-bold text-white mb-2">Webhook URL <span class="text-amber-500">*</span></label>
                <input type="url" id="webhook-url" name="webhookUrl" required placeholder="https://hooks.spike.sh/..."
                       class="w-full bg-[#141414] border border-[#262626] rounded-xl px-4 py-3 text-[15px] text-white placeholder-[#737373] focus:border-amber-500 hover:border-[#404040] focus:ring-1 focus:ring-amber-500 outline-none transition-all font-mono shadow-inner" />
                <div class="mt-2 flex items-center justify-between">
                    <span class="text-xs text-[#737373]">Get this from your Spike.sh Integrations.</span>
                    <a href="https://spike.sh" target="_blank" class="text-amber-500 hover:text-amber-400 text-xs font-bold flex items-center gap-1 transition-colors">
                        Open Spike.sh <i data-lucide="external-link" class="w-3 h-3"></i>
                    </a>
                </div>
            </div>

            <div id="error-message" class="hidden rounded-xl bg-rose-500/10 border border-rose-500/20 p-4 text-[14px] text-rose-500 flex items-start gap-3">
                <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 mt-0.5"></i>
                <span id="error-text" class="break-all whitespace-normal font-medium text-rose-400"></span>
            </div>

            <div class="flex items-center justify-end gap-3 pt-6 border-t border-[#262626]">
                <a href="/project/@project?.Slug/integrations" class="px-6 py-2.5 rounded-xl text-[#A3A3A3] hover:text-white font-bold text-sm transition-colors">
                    Cancel
                </a>
                <button type="submit" id="submit-btn" class="bg-amber-600 outline-none hover:bg-amber-500 text-white px-8 py-2.5 rounded-xl font-black text-sm transition-all shadow-lg shadow-amber-500/20 flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    Connect Spike
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });

    document.getElementById('spike-form').addEventListener('submit', function(e) {
        const url = document.getElementById('webhook-url').value;
        const err = document.getElementById('error-message');
        const errText = document.getElementById('error-text');
        const btn = document.getElementById('submit-btn');

        err.classList.add('hidden');

        if (!url.startsWith('https://hooks.spike.sh/')) {
            e.preventDefault();
            errText.textContent = "Webhook URL must start with https://hooks.spike.sh/";
            err.classList.remove('hidden');
            return;
        }

        // Show loading state, then let the native form POST happen
        btn.disabled = true;
        btn.innerHTML = '<div class="h-4 w-4 animate-spin rounded-full border-2 border-white border-r-transparent mr-2"></div> Connecting...';
    });
</script>
