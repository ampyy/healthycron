@{
    var project = (ViewBag.Project as HealthyCron.Models.Project)!;
    var user = (ViewBag.User as HealthyCron.Models.User)!;
    ViewData["Title"] = $"{project.Name} - Add Discord Integration";
    Layout = "_DashboardLayout";
}

<div class="max-w-2xl mx-auto pb-20">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-text-secondary text-sm mb-6 uppercase tracking-wider font-semibold">
        <a href="/dashboard" class="hover:text-blue-500 transition-colors flex items-center gap-1">
            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
            Projects
        </a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/monitors" class="hover:text-white transition-colors">@project.Name</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/integrations" class="hover:text-white transition-colors">Integrations</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-white">Add Discord</span>
    </div>

    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-4 mb-3">
            <div class="w-14 h-14 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center shrink-0">
                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
                </svg>
            </div>
            <div>
                <h1 class="text-3xl font-bold text-white">Add Discord Integration</h1>
                <p class="text-text-secondary mt-1">Connect your Discord channel</p>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-500 flex items-start gap-3">
            <i data-lucide="alert-circle" class="w-5 h-5 mt-0.5 shrink-0"></i>
            <p class="text-sm font-medium">@TempData["Error"]</p>
        </div>
    }

    <!-- Instructions -->
    <div class="glass-card rounded-2xl p-6 border border-indigo-500/20 bg-indigo-500/5 mb-6">
        <h2 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
            <i data-lucide="info" class="w-5 h-5 text-indigo-500"></i>
            How to get your Discord Webhook URL
        </h2>
        <ol class="space-y-2 text-sm text-text-secondary ml-7 list-decimal">
            <li>Open Discord and navigate to the channel where you want to receive alerts</li>
            <li>Click the gear icon (⚙️) next to the channel name to open <strong class="text-white">Edit Channel</strong></li>
            <li>Go to the <strong class="text-white">Integrations</strong> tab</li>
            <li>Click <strong class="text-white">Create Webhook</strong> (or view an existing webhook)</li>
            <li>Give the webhook a name (e.g., "HealthyCron Alerts")</li>
            <li>Click <strong class="text-white">Copy Webhook URL</strong> and paste it below</li>
        </ol>
        <div class="mt-3 pt-3 border-t border-indigo-500/20">
            <p class="text-xs text-text-secondary">
                <strong class="text-white">URL format:</strong><br/>
                <code class="text-xs bg-navy px-1.5 py-0.5 rounded">https://discord.com/api/webhooks/...</code>
            </p>
        </div>
    </div>

    <!-- Form -->
    <form method="post" action="/project/@project.Slug/integrations/discord" class="glass-card rounded-2xl p-8 border border-white/5">
        <div class="space-y-6">
            <!-- Webhook URL -->
            <div>
                <label for="webhookUrl" class="block text-sm font-bold text-white mb-2">
                    Webhook URL <span class="text-rose-500">*</span>
                </label>
                <input 
                    type="url" 
                    id="webhookUrl" 
                    name="webhookUrl" 
                    required
                    placeholder="https://discord.com/api/webhooks/..."
                    class="w-full px-4 py-3 rounded-xl bg-navy border border-border-color text-white placeholder-text-secondary focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all"
                />
                <p class="mt-2 text-xs text-text-secondary">The Discord webhook URL from your channel settings</p>
            </div>

            <!-- Integration Name (Optional) -->
            <div>
                <label for="name" class="block text-sm font-bold text-white mb-2">
                    Integration Name <span class="text-text-secondary text-xs font-normal">(Optional)</span>
                </label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    placeholder="Discord - #alerts"
                    class="w-full px-4 py-3 rounded-xl bg-navy border border-border-color text-white placeholder-text-secondary focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all"
                />
                <p class="mt-2 text-xs text-text-secondary">If left empty, will default to "Discord"</p>
            </div>

            <!-- Channel Name (Optional) -->
            <div>
                <label for="channelName" class="block text-sm font-bold text-white mb-2">
                    Channel Name <span class="text-text-secondary text-xs font-normal">(Optional)</span>
                </label>
                <input 
                    type="text" 
                    id="channelName" 
                    name="channelName" 
                    placeholder="#alerts"
                    class="w-full px-4 py-3 rounded-xl bg-navy border border-border-color text-white placeholder-text-secondary focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all"
                />
                <p class="mt-2 text-xs text-text-secondary">Optional channel name for easier identification</p>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-end gap-3 mt-8 pt-6 border-t border-white/5">
            <a href="/project/@project.Slug/integrations" class="px-6 py-2.5 rounded-xl text-text-secondary hover:text-white font-bold text-sm transition-colors">
                Cancel
            </a>
            <button type="submit" class="bg-indigo-500 hover:bg-indigo-600 text-white px-8 py-2.5 rounded-xl font-black text-sm transition-all shadow-lg shadow-indigo-500/20 flex items-center gap-2">
                <i data-lucide="plus" class="w-4 h-4"></i>
                Add Integration
            </button>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>
