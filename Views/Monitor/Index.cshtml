<!-- SignalR Client -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    // SignalR Connection
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/monitorHub")
        .withAutomaticReconnect()
        .build();

    const h1 = document.querySelector('h1');

    async function startSignalR() {
        try {
            await connection.start();
            console.log("SignalR Connected.");
            await connection.invoke("JoinMonitor", "@Model.Id");
        } catch (err) {
            console.error("SignalR Connection Error: ", err);
            setTimeout(startSignalR, 5000);
        }
    }

    connection.on("PingReceived", (data) => {
        console.log("Ping Received:", data);
        updateStatusBadge(data.newMonitorStatus);
        updateChart();
        addLogRow(data);
    });

    connection.on("StatusChanged", (data) => {
        console.log("Status Changed:", data);
        updateStatusBadge(data.newStatus);
    });

    startSignalR();

    function updateStatusBadge(status) {
        if (!h1) return;
        const badgeContainer = h1.nextElementSibling;
        if (!badgeContainer) return;

        let badgeHtml = '';
        if (status === 'Paused') {
            badgeHtml = `<span class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest bg-hc-amber/10 text-hc-amber">
                            <i data-lucide="pause-circle" class="w-3 h-3"></i>
                            Paused
                        </span>`;
        } else if (status === 'Success' || status === 'Healthy') {
            badgeHtml = `<span class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest bg-green-500/10 text-green-500">
                            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                            Healthy
                        </span>`;
        } else {
            badgeHtml = `<span class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest bg-red-500/10 text-red-500">
                            <span class="w-2 h-2 rounded-full bg-red-500"></span>
                            Down
                        </span>`;
        }

        const parent = badgeContainer.parentElement;
        parent.removeChild(badgeContainer);

        const temp = document.createElement('div');
        temp.innerHTML = badgeHtml;
        parent.insertBefore(temp.firstElementChild, h1.nextSibling);
        lucide.createIcons();
    }

    function updateChart() {
        const chartContainer = document.querySelector('.h-32');
        if (!chartContainer) return;

        const bars = chartContainer.querySelectorAll('.flex-1');
        if (bars.length === 0) return;

        const lastBar = bars[bars.length - 1];
        const innerBarWrapper = lastBar.querySelector('.bg-blue\\/10');
        const countText = lastBar.querySelector('.text-blue');

        if (innerBarWrapper) {
            let currentPings = parseInt(countText.innerText) || 0;
            currentPings++;
            countText.innerText = currentPings + ' pings';

            const height = Math.max(5, Math.min(100, (currentPings * 20) + 5));
            innerBarWrapper.style.height = height + '%';

            if (!innerBarWrapper.querySelector('.bg-blue')) {
                innerBarWrapper.innerHTML = '<div class="bg-blue-600 rounded-t-sm w-full h-full opacity-60"></div>';
            }
        }
    }

    function addLogRow(data) {
        const tbody = document.querySelector('table tbody');
        if (!tbody) return;

        const noActivityRow = tbody.querySelector('td[colspan="6"]');
        if (noActivityRow && noActivityRow.innerText.includes("No activity")) {
            tbody.removeChild(noActivityRow.parentElement);
        }

        const currentStatus = data.status === 'Success' ? 'Success' : (data.status === 'Start' ? 'Starting' : 'Failed');
        const statusClass = currentStatus == 'Success' ? 'bg-green-500/10 text-green-500 border border-green-500/20' : (currentStatus == 'Starting' ? 'bg-blue-500/10 text-blue-500 border border-blue-500/20' : 'bg-red-500/10 text-red-500 border border-red-500/20');
        const statusText = currentStatus.substring(0, Math.min(3, currentStatus.length));

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-white/[0.04] transition-all cursor-pointer group opacity-0 translate-y-2';
        tr.onclick = function() { showPingDetails(this); };

        tr.dataset.id = data.id;
        tr.dataset.time = data.timeStr;
        tr.dataset.status = currentStatus;
        tr.dataset.message = data.message || '';
        tr.dataset.ip = data.ipAddress || '';
        tr.dataset.ua = data.userAgent || '';
        tr.dataset.method = data.method || '';
        tr.dataset.headers = data.headers || '{}';

        // Split date and time from display string if possible, or use raw
        // data.dateDisplay usually has "MMM dd, yyyy"
        // data.timeDisplay usually has "HH:mm:ss"
        // We'll rely on the server sending these or parse them. 
        // Assuming the server sends 'dateDisplay' and 'timeDisplay' separately or we parse 'receivedAt'.
        // Existing code used `data.dateDisplay` and `data.timeDisplay`.
        
        tr.innerHTML = `
            <td class="p-4 pl-6 align-middle text-center">
                <span class="text-[10px] text-hc-muted font-black opacity-30">NEW</span>
            </td>
            <td class="p-4 align-middle">
                 <span class="text-sm text-white font-medium whitespace-nowrap">${data.dateDisplay || '-'}</span>
            </td>
            <td class="p-4 align-middle">
                <span class="text-xs text-hc-muted font-mono whitespace-nowrap">${data.timeDisplay || '-'}</span>
            </td>
            <td class="p-4 align-middle">
                <span class="px-2 py-0.5 rounded-md text-[9px] font-black uppercase tracking-widest ${statusClass}">
                    ${statusText}
                </span>
            </td>
            <td class="p-4 pr-6 align-middle">
                <div class="flex items-center gap-1.5 opacity-60">
                    <i data-lucide="globe" class="w-3.5 h-3.5 text-hc-muted shrink-0"></i>
                    <span class="text-xs text-white font-mono truncate" title="${data.userAgent || ''}">${data.userAgent || 'N/A'}</span>
                </div>
            </td>
        `;

        tbody.insertBefore(tr, tbody.firstChild);
        // Force reflow
        tr.offsetHeight;
        tr.classList.remove('opacity-0', 'translate-y-2');
        tr.classList.add('duration-500');

        lucide.createIcons();

        if (tbody.children.length > 20) {
            tbody.removeChild(tbody.lastChild);
        }
    }

    async function toggleMonitorIntegration(integrationId, btn) {
        const isCurrentlyEnabled = btn.dataset.enabled === 'true';
        const newStatus = !isCurrentlyEnabled;

        btn.disabled = true;
        btn.classList.add('opacity-50');

        try {
            const response = await fetch(`/monitor/@Model.Id/integrations/${integrationId}/toggle`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ isEnabled: newStatus })
            });

            if (response.ok) {
                btn.dataset.enabled = newStatus.toString();
                
                if (newStatus) {
                    btn.classList.remove('bg-white/5', 'border-white/10', 'text-hc-muted');
                    btn.classList.add('bg-green-500/10', 'border-green-500/20', 'text-green-500');
                    btn.innerHTML = `<i data-lucide="bell" class="w-3 h-3"></i><span>Enabled</span>`;
                } else {
                    btn.classList.remove('bg-green-500/10', 'border-green-500/20', 'text-green-500');
                    btn.classList.add('bg-white/5', 'border-white/10', 'text-hc-muted');
                    btn.innerHTML = `<i data-lucide="bell-off" class="w-3 h-3"></i><span>Disabled</span>`;
                }
                lucide.createIcons();
            } else {
                alert('Failed to update integration status');
            }
        } catch (error) {
            console.error(error);
            alert('An error occurred');
        } finally {
            btn.disabled = false;
            btn.classList.remove('opacity-50');
        }
    }


    function switchEndpoint(type) {
        document.querySelectorAll('.endpoint-tab').forEach(tab => {
            tab.classList.remove('bg-blue-600/10', 'text-blue', 'active');
            tab.classList.add('text-hc-muted', 'opacity-50');
        });
        document.querySelectorAll('.endpoint-content').forEach(content => content.classList.add('hidden'));

        document.getElementById(`tab-${type}`).classList.add('bg-blue-600/10', 'text-blue', 'active');
        document.getElementById(`tab-${type}`).classList.remove('text-hc-muted', 'opacity-50');
        document.getElementById(`endpoint-${type}`).classList.remove('hidden');
    }

    function copyUrl(id) {
        const text = document.getElementById(id).innerText.trim();
        navigator.clipboard.writeText(text).then(() => {
            const btn = document.querySelector(`button[onclick="copyUrl('${id}')"]`);
            const originalInner = btn.innerHTML;
            
            btn.innerHTML = '<i data-lucide="check" class="w-3.5 h-3.5 text-green-500"></i>';
            lucide.createIcons();
            
            setTimeout(() => {
                btn.innerHTML = originalInner;
                lucide.createIcons();
            }, 2000);
        });
    }

    function openScheduleModal() { document.getElementById('scheduleModal').classList.remove('hidden'); }
    function closeScheduleModal() { document.getElementById('scheduleModal').classList.add('hidden'); }
    function openEditModal() { document.getElementById('editModal').classList.remove('hidden'); }
    function closeEditModal() { document.getElementById('editModal').classList.add('hidden'); }
    function openPingModal() { document.getElementById('pingModal').classList.remove('hidden'); }
    function closePingModal() { document.getElementById('pingModal').classList.add('hidden'); }

    function setScheduleType(type) {
        document.getElementById('schedule-type-input').value = type;
        document.querySelectorAll('.schedule-btn').forEach(btn => btn.classList.remove('active-sch', 'text-white'));
        document.getElementById(`btn-sch-${type}`).classList.add('active-sch', 'text-white');
        document.getElementById(`btn-sch-${type}`).classList.add('active-sch', 'text-white');
        [0, 1, 2].forEach(t => document.getElementById(`config-sch-${t}`).classList.add('hidden'));
        document.getElementById(`config-sch-${type}`).classList.remove('hidden');
    }

    function showLoading() {
        const overlay = document.getElementById('loading-overlay');
        overlay.classList.remove('hidden');
        setTimeout(() => {
            overlay.classList.remove('opacity-0');
        }, 10);
    }

    function hideLoading() {
        const overlay = document.getElementById('loading-overlay');
        overlay.classList.add('opacity-0');
        setTimeout(() => {
            overlay.classList.add('hidden');
        }, 300);
    }

    async function togglePause() {
        showLoading();
        try {
            const response = await fetch(`/monitor/@Model.Id/pause`, { method: 'POST' });
            if (response.ok) {
                const result = await response.json();
                window.location.reload();
            }
        } catch (error) { 
            console.error(error); 
            hideLoading();
        }
    }

    async function deleteMonitor() {
        if (!confirm('Are you sure you want to delete this monitor? This action cannot be undone.')) return;
        showLoading();
        try {
            const response = await fetch(`/monitor/@Model.Id/delete`, { method: 'POST' });
            if (response.ok) {
                const result = await response.json();
                window.location.href = result.redirectUrl;
            }
        } catch (error) { 
            console.error(error); 
            hideLoading();
        }
    }

    // Schedule Update
    document.getElementById('updateScheduleForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        showLoading();
        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());
        data.ScheduleType = parseInt(data.ScheduleType);
        data.PeriodValue = parseInt(data.PeriodValue);
        data.GraceSeconds = parseInt(data.GraceSeconds);

        try {
            const response = await fetch('/monitor/update-schedule', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (response.ok) window.location.reload();
            else {
                alert('Error updating schedule');
                hideLoading();
            }
        } catch (error) { 
            console.error(error); 
            alert('Error updating schedule'); 
            hideLoading();
        }
    });

    // Details Update
    document.getElementById('edit-slug').addEventListener('input', function(e) {
        const val = e.target.value;
        const isValid = /^[a-z0-9-]+$/.test(val);
        const errorEl = document.getElementById('slug-error');
        const hintEl = document.getElementById('slug-hint');
        if (!isValid && val !== '') {
            errorEl.classList.remove('hidden');
            hintEl.classList.add('hidden');
            e.target.classList.add('border-red-500/50', 'ring-red-500/20');
        } else {
            errorEl.classList.add('hidden');
            hintEl.classList.remove('hidden');
            e.target.classList.remove('border-red-500/50', 'ring-red-500/20');
        }
    });

    document.getElementById('updateDetailsForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        const slug = document.getElementById('edit-slug').value;
        if (!/^[a-z0-9-]+$/.test(slug)) {
            alert('Invalid slug format');
            return;
        }

        showLoading();
        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());

        try {
            const response = await fetch('/monitor/update-details', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (response.ok) {
                 const result = await response.json();
                 window.location.href = result.redirectUrl || window.location.reload();
            }
            else {
                const err = await response.text();
                alert('Error updating details: ' + err);
                hideLoading();
            }
        } catch (error) { 
            console.error(error); 
            alert('Error updating details'); 
            hideLoading();
        }
    });

    function showPingDetails(row) {
        const dataset = row.dataset;
        document.getElementById('modal-time').innerText = dataset.time;
        document.getElementById('modal-message').innerText = dataset.message || 'Regular heartbeat ping.';
        
        const statusEl = document.getElementById('modal-status');
        statusEl.innerText = dataset.status;
        statusEl.className = 'text-sm font-black uppercase tracking-widest ' + 
            (dataset.status === 'Success' ? 'text-green-500' : (dataset.status === 'Starting' ? 'text-blue-500' : 'text-red-500'));
        
        document.getElementById('modal-ip').innerText = dataset.ip || 'N/A';
        document.getElementById('modal-method').innerText = dataset.method || '-';
        document.getElementById('modal-ua').innerText = dataset.ua || 'N/A';
        
        try {
            const headers = JSON.parse(dataset.headers || '{}');
            document.getElementById('modal-headers').innerText = JSON.stringify(headers, null, 2);
        } catch {
            document.getElementById('modal-headers').innerText = '{}';
        }

        document.getElementById('pingModal').classList.remove('hidden');
        lucide.createIcons();
    }

    // Chart.js Implementation
    let pingChart = null;

    async function loadPingData(range = '24h') {
        const loadingStr = document.getElementById('chart-loading');
        const errorStr = document.getElementById('chart-error');
        loadingStr.classList.remove('hidden');
        errorStr.classList.add('hidden');

        // Update active button state
        document.querySelectorAll('[id^="btn-"]').forEach(btn => {
            btn.classList.remove('text-white', 'bg-blue-600/20', 'text-blue-400');
            btn.classList.add('text-hc-muted');
        });
        const activeBtn = document.getElementById(`btn-${range}`);
        if(activeBtn) {
            activeBtn.classList.remove('text-hc-muted');
            activeBtn.classList.add('text-white', 'bg-blue-600/20', 'text-blue-400');
        }

        const end = new Date();
        const start = new Date();
        if (range === '24h') start.setHours(start.getHours() - 24);
        else if (range === '3d') start.setDate(start.getDate() - 3);
        else if (range === '7d') start.setDate(start.getDate() - 7);

        try {
            const url = `/monitor/api/@Model.Id/pings?start=${start.toISOString()}&end=${end.toISOString()}`;
            const response = await fetch(url);
            if (!response.ok) throw new Error('Failed to fetch ping data');
            const pings = await response.json();

            // Bucket the data based on range
            // For 24h: bucket by hour
            // For 3d: bucket by 3 hours
            // For 7d: bucket by 12 hours
            let bucketSizeMs = 60 * 60 * 1000; // 1 hour
            if (range === '3d') bucketSizeMs = 3 * 60 * 60 * 1000;
            else if (range === '7d') bucketSizeMs = 12 * 60 * 60 * 1000;

            const buckets = {};
            // Initialize empty buckets
            for (let time = start.getTime(); time <= end.getTime(); time += bucketSizeMs) {
                // Round down to nearest bucket
                const roundedTime = Math.floor(time / bucketSizeMs) * bucketSizeMs;
                buckets[roundedTime] = 0;
            }

            pings.forEach(ping => {
                const time = new Date(ping.receivedAt).getTime();
                const roundedTime = Math.floor(time / bucketSizeMs) * bucketSizeMs;
                if (buckets[roundedTime] !== undefined) {
                    buckets[roundedTime]++;
                }
            });

            // Prepare chart arrays, sorted chronologically
            const labels = [];
            const data = [];
            Object.keys(buckets).sort().forEach(timestamp => {
                const date = new Date(parseInt(timestamp));
                let label = '';
                if (range === '24h') label = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                else label = date.toLocaleDateString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
                labels.push(label);
                data.push(buckets[timestamp]);
            });

            renderChart(labels, data, range);

        } catch (error) {
            console.error(error);
            errorStr.classList.remove('hidden');
        } finally {
            loadingStr.classList.add('hidden');
        }
    }

    function renderChart(labels, data, range) {
        const ctx = document.getElementById('monitorChart').getContext('2d');
        
        Chart.defaults.color = '#9ca3af';
        Chart.defaults.font.family = 'Inter, system-ui, sans-serif';

        if (pingChart) {
            pingChart.destroy();
        }

        // Determine if we show bars (for small buckets) or lines (for 24h)
        const isBar = range !== '24h';

        pingChart = new Chart(ctx, {
            type: isBar ? 'bar' : 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Pings Received',
                    data: data,
                    backgroundColor: 'rgba(37, 99, 235, 0.4)', // blue-600/40
                    borderColor: 'rgb(37, 99, 235)', // blue-600
                    borderWidth: isBar ? 0 : 2,
                    pointRadius: 0,
                    pointHoverRadius: 4,
                    pointBackgroundColor: 'rgb(37, 99, 235)',
                    fill: !isBar,
                    tension: 0.4,
                    borderRadius: isBar ? 4 : 0 // Rounded top for bars
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: 'rgba(15, 23, 42, 0.9)',
                        titleColor: '#fff',
                        bodyColor: '#cbd5e1',
                        borderColor: 'rgba(255, 255, 255, 0.1)',
                        borderWidth: 1,
                        padding: 12,
                        boxPadding: 4,
                        callbacks: {
                            label: function(context) {
                                return ` ${context.parsed.y} pings received`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            color: 'rgba(255, 255, 255, 0.05)',
                            drawBorder: false
                        },
                        ticks: {
                            maxTicksLimit: range === '24h' ? 8 : (range === '3d' ? 6 : 7),
                            font: { size: 10 }
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(255, 255, 255, 0.05)',
                            drawBorder: false
                        },
                        ticks: {
                            precision: 0,
                            font: { size: 10 }
                        }
                    }
                }
            }
        });
    }

    // Initialize chart on load
    document.addEventListener('DOMContentLoaded', () => {
        // Load external script dynamically if not present (although normally injected by layout or Stats)
        if (typeof Chart === 'undefined') {
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/chart.js';
            script.onload = () => loadPingData('24h');
            document.head.appendChild(script);
        } else {
            loadPingData('24h');
        }
    });

</script>
