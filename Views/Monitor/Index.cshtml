                        {
                            <tr>
                                <td colspan="3" class="px-6 py-8 text-center text-text-secondary font-medium text-xs opacity-50 border-dashed border border-white/5 rounded-xl block m-4 bg-white/[0.01]">
                                    No active integrations. 
                                    <a href="/project/@project?.Slug/integrations" class="text-blue hover:underline ml-1">Manage Integrations</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <!-- Logs -->
    <section class="glass-card rounded-2xl overflow-hidden w-full bg-navy/10">
        <div class="px-6 py-4 flex items-center justify-between mb-0 border-b border-white/5 bg-navy/20">
            <h3 class="font-bold text-white text-sm">Recent Activity Log</h3>
            <a href="/monitor/@Model.Slug/logs" class="text-[10px] uppercase font-bold text-blue hover:text-blue-400 transition-colors">View all</a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="text-[9px] uppercase font-black text-text-secondary border-b border-white/5 bg-navy/20">
                        <th class="py-3 px-4 pl-6 w-10">#</th>
                        <th class="py-3 px-4 w-24">Date</th>
                        <th class="py-3 px-4 w-24">Time</th>
                        <th class="py-3 px-4 w-20">Status</th>
                        <th class="py-3 px-4">User Agent</th>
                    </tr>
                </thead>
                <tbody class="text-sm text-text-secondary">
                    @{
                        var userTz = ViewBag.UserTimezone as string ?? "UTC";
                        var pingList = pings?.OrderByDescending(p => p.ReceivedAt).Take(5).ToList();
                        int rowNum = pingList?.Count ?? 0;
                    }
                    @if (pingList != null && pingList.Any())
                    {
                        @foreach (var ping in pingList)
                        {
                            var statusClass = ping.Status == HealthyCron.Models.PingType.Success ? "bg-emerald-500/10 text-emerald-500 border border-emerald-500/20" :
                            (ping.Status == HealthyCron.Models.PingType.Start ? "bg-blue-500/10 text-blue-500 border border-blue-500/20" : "bg-rose-500/10 text-rose-500 border border-rose-500/20");
                            var statusText = ping.Status == HealthyCron.Models.PingType.Success ? "OK" : (ping.Status == HealthyCron.Models.PingType.Start ? "Start" : "Fail");
                            var localTime = TimezoneHelper.ToUserTime(ping.ReceivedAt, userTz);

                            <tr class="hover:bg-white/[0.04] transition-all cursor-pointer group border-b border-white/5 last:border-0" onclick="showPingDetails(this)"
                                data-ping="@System.Text.Json.JsonSerializer.Serialize(new {
                                        id = ping.Id,
                                        receivedAt = ping.ReceivedAt,
                                        timeStr = localTime.ToString("MMM dd, yyyy HH:mm:ss") + " (" + userTz + ")",
                                        dateDisplay = localTime.ToString("MMM dd"),
                                        timeDisplay = localTime.ToString("HH:mm:ss"),
                                        status = ping.Status.ToString(),
                                        message = ping.Message,
                                        ipAddress = ping.IpAddress,
                                        userAgent = ping.UserAgent,
                                        method = ping.HttpMethod,
                                        headers = ping.RequestHeaders,
                                        duration = ping.DurationMs
                                    })">
                                <td class="py-3 px-4 pl-6">
                                    <span class="text-[10px] font-mono text-text-secondary/40">@rowNum</span>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="text-xs text-white font-bold">@localTime.ToString("MMM dd")</span>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="text-[10px] text-text-secondary font-mono">@localTime.ToString("HH:mm:ss")</span>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="@statusClass px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-widest">@statusText</span>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="text-[10px] text-text-secondary font-mono" title="@ping.UserAgent">@(ping.UserAgent ?? "—")</span>
                                </td>
                            </tr>
                            rowNum--;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-8 text-center text-text-secondary italic">
                                No activity recorded yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @* Documentation Sections Removed *@
</div>

<!-- Change Schedule Modal -->
<div id="scheduleModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="fixed inset-0 bg-black/80 transition-opacity" onclick="closeScheduleModal()"></div>
        <div class="inline-block bg-navy-light rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:max-w-lg w-full border border-border-color relative z-10">
            <div class="px-6 py-4 border-b border-border-color flex justify-between items-center bg-navy/50">
                <h3 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="timer" class="text-amber-500"></i>
                    Change Schedule
                </h3>
                <button onclick="closeScheduleModal()" class="text-text-secondary hover:text-white transition-colors">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>
            <form id="updateScheduleForm">
                <input type="hidden" name="Id" value="@Model.Id">
                <div class="p-8 space-y-8">
                    <!-- Schedule Type -->
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-text-secondary mb-3 px-1">1. Choose Schedule Type</label>
                        <div class="grid grid-cols-3 bg-navy p-1.5 rounded-2xl border border-white/5">
                            <button type="button" onclick="setScheduleType(0)" id="btn-sch-0" class="py-3 rounded-xl text-xs font-black uppercase tracking-widest transition-all schedule-btn @(Model.ScheduleType == HealthyCron.Models.ScheduleType.Interval ? "active-sch text-white" : "text-text-secondary opacity-50 hover:opacity-100")">Interval</button>
                            <button type="button" onclick="setScheduleType(1)" id="btn-sch-1" class="py-3 rounded-xl text-xs font-black uppercase tracking-widest transition-all schedule-btn @(Model.ScheduleType == HealthyCron.Models.ScheduleType.Cron ? "active-sch text-white" : "text-text-secondary opacity-50 hover:opacity-100")">Cron</button>
                            <button type="button" onclick="setScheduleType(2)" id="btn-sch-2" class="py-3 rounded-xl text-xs font-black uppercase tracking-widest transition-all schedule-btn @(Model.ScheduleType == HealthyCron.Models.ScheduleType.Calendar ? "active-sch text-white" : "text-text-secondary opacity-50 hover:opacity-100")">Calendar</button>
                            <input type="hidden" name="ScheduleType" id="schedule-type-input" value="@((int)Model.ScheduleType)">
                        </div>
                    </div>

                    <!-- Configuration Area -->
                    <div class="bg-navy/50 rounded-2xl p-6 border border-white/5 space-y-4">
                        <div id="config-sch-0" class="@(Model.ScheduleType != HealthyCron.Models.ScheduleType.Interval ? "hidden" : "")">
                            <label class="block text-[10px] font-black uppercase tracking-widest text-text-secondary mb-3">Health Check Interval</label>
                            <div class="flex gap-3">
                                <div class="w-24 bg-navy border border-white/10 rounded-xl focus-within:ring-2 focus-within:ring-blue/50 transition-all overflow-hidden">
                                    <input type="number" name="PeriodValue" value="@(Model.PeriodSeconds >= 3600 ? Model.PeriodSeconds / 3600 : (Model.PeriodSeconds >= 60 ? Model.PeriodSeconds / 60 : Model.PeriodSeconds))" min="1" class="w-full bg-transparent px-4 py-3.5 text-white outline-none text-center font-bold">
                                </div>
                                <div class="flex-1 relative">
                                    <select name="PeriodUnit" class="w-full bg-navy border border-white/10 rounded-xl px-4 py-3.5 text-white focus:ring-2 focus:ring-blue/50 outline-none font-bold text-xs uppercase tracking-widest appearance-none cursor-pointer">
                                        <option value="seconds" selected="@(Model.PeriodSeconds < 60 ? "selected" : null)">Seconds</option>
                                        <option value="minutes" selected="@(Model.PeriodSeconds >= 60 && Model.PeriodSeconds < 3600 ? "selected" : null)">Minutes</option>
                                        <option value="hours" selected="@(Model.PeriodSeconds >= 3600 ? "selected" : null)">Hours</option>
                                    </select>
                                    <i data-lucide="chevron-down" class="absolute right-4 top-1/2 -translate-y-1/2 w-4 h-4 text-text-secondary pointer-events-none opacity-50"></i>
                                </div>
                            </div>
                        </div>

                        <div id="config-sch-1" class="@(Model.ScheduleType != HealthyCron.Models.ScheduleType.Cron ? "hidden" : "")">
                            <label class="block text-[10px] font-black uppercase tracking-widest text-text-secondary mb-3">Cron Expression</label>
                            <input type="text" name="CronExpression" value="@Model.CronExpression" placeholder="0 0 * * *" class="w-full bg-navy border border-white/10 rounded-xl px-4 py-3.5 text-white focus:ring-2 focus:ring-blue/50 outline-none font-mono tracking-widest text-sm">
                            <div class="mt-3 p-3 bg-white/[0.02] border border-white/5 rounded-xl space-y-2">
                                <p class="text-[10px] text-text-secondary font-black uppercase tracking-widest flex items-center gap-2">
                                    <i data-lucide="info" class="w-3 h-3 text-blue"></i>
                                    Examples
                                </p>
                                <div class="grid grid-cols-2 gap-2">
                                    <div class="text-[9px] font-mono text-white/40"><span class="text-blue">*/15 * * * *</span> Every 15 min</div>
                                    <div class="text-[9px] font-mono text-white/40"><span class="text-blue">0 * * * *</span> Every hour</div>
                                    <div class="text-[9px] font-mono text-white/40"><span class="text-blue">0 0 * * *</span> Every midnight</div>
                                    <div class="text-[9px] font-mono text-white/40"><span class="text-blue">0 0 * * 1</span> Every Monday</div>
                                </div>
                            </div>
                        </div>

                        <div id="config-sch-2" class="@(Model.ScheduleType != HealthyCron.Models.ScheduleType.Calendar ? "hidden" : "")">
                            <label class="block text-[10px] font-black uppercase tracking-widest text-text-secondary mb-3">Calendar Expression</label>
                            <input type="text" name="CalendarExpression" value="@Model.CalendarExpression" placeholder="Mon *-*-* 00:00:00" class="w-full bg-navy border border-white/10 rounded-xl px-4 py-3.5 text-white focus:ring-2 focus:ring-purple/50 outline-none font-mono tracking-widest text-sm">
                            <div class="mt-3 p-3 bg-white/[0.02] border border-white/5 rounded-xl space-y-2">
                                <p class="text-[10px] text-text-secondary font-black uppercase tracking-widest flex items-center gap-2">
                                    <i data-lucide="info" class="w-3 h-3 text-purple"></i>
                                    Examples
                                </p>
                                <div class="grid grid-cols-2 gap-2">
                                    <div class="text-[9px] font-mono text-white/40"><span class="text-purple">*-*-* *:0,15,30,45</span> Every 15 min</div>
                                    <div class="text-[9px] font-mono text-white/40"><span class="text-purple">hourly</span> Every hour</div>
                                    <div class="text-[9px] font-mono text-white/40"><span class="text-purple">daily</span> Every day</div>
                                    <div class="text-[9px] font-mono text-white/40"><span class="text-purple">monthly</span> Every month</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Grace Period -->
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-text-secondary mb-3 px-1">2. Set Grace Period (Time to wait before alerting)</label>
                        <div class="flex gap-3">
                            <div class="w-24 bg-navy border border-white/10 rounded-xl focus-within:ring-2 focus-within:ring-rose-500/50 transition-all overflow-hidden">
                                <input type="number" name="GraceSeconds" value="@(Model.GraceSeconds >= 3600 ? Model.GraceSeconds / 3600 : (Model.GraceSeconds >= 60 ? Model.GraceSeconds / 60 : Model.GraceSeconds))" min="1" class="w-full bg-transparent px-4 py-3.5 text-white outline-none text-center font-bold">
                            </div>
                            <div class="flex-1 relative">
                                <select name="GraceUnit" class="w-full bg-navy border border-white/10 rounded-xl px-4 py-3.5 text-white focus:ring-2 focus:ring-rose-500/50 outline-none font-bold text-xs uppercase tracking-widest appearance-none cursor-pointer">
                                    <option value="seconds" selected="@(Model.GraceSeconds < 60 ? "selected" : null)">Seconds</option>
                                    <option value="minutes" selected="@(Model.GraceSeconds >= 60 && Model.GraceSeconds < 3600 ? "selected" : null)">Minutes</option>
                                    <option value="hours" selected="@(Model.GraceSeconds >= 3600 ? "selected" : null)">Hours</option>
                                </select>
                                <i data-lucide="chevron-down" class="absolute right-4 top-1/2 -translate-y-1/2 w-4 h-4 text-text-secondary pointer-events-none opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-navy/50 px-6 py-4 flex items-center justify-end gap-3 border-t border-white/5">
                    <button type="button" onclick="closeScheduleModal()" class="px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest text-text-secondary hover:text-white transition-all">Cancel</button>
                    <button type="submit" class="bg-amber-600 hover:bg-amber-500 text-white px-8 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all shadow-lg shadow-amber-600/20 active:scale-95">
                        Apply Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Details Modal -->
<div id="editModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="fixed inset-0 bg-black/80 transition-opacity" onclick="closeEditModal()"></div>
        <div class="inline-block bg-navy-light rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:max-w-lg w-full border border-border-color relative z-10">
            <div class="px-6 py-4 border-b border-border-color flex justify-between items-center bg-navy/50">
                <h3 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="edit-3" class="text-blue"></i>
                    Edit Details
                </h3>
                <button onclick="closeEditModal()" class="text-text-secondary hover:text-white transition-colors">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
