@model HealthyCron.Models.Monitor
@{
    var project = ViewBag.Project as HealthyCron.Models.Project;
    var pings = (ViewBag.RecentPings as IEnumerable<HealthyCron.Models.MonitorPing> ?? Enumerable.Empty<HealthyCron.Models.MonitorPing>()).ToList();
    var graphData = ViewBag.GraphData as int[];
    var monitorIntegrations = ViewBag.MonitorIntegrations as List<HealthyCron.Models.ViewModels.IntegrationListItemViewModel> ?? new List<HealthyCron.Models.ViewModels.IntegrationListItemViewModel>();
    var monthlyStats = ViewBag.MonthlyStats as List<HealthyCron.Models.DTOs.MonthlyUptimeDto> ?? new List<HealthyCron.Models.DTOs.MonthlyUptimeDto>();
    ViewData["Title"] = $"{Model.Name} - Monitor Details";
    Layout = "_DashboardLayout";
    
    // Calculate display values for schedule
    string FormatMinutes(int? seconds) {
        if (!seconds.HasValue) return "0m";
        if (seconds >= 86400) return $"{seconds / 86400}d";
        if (seconds >= 3600) return $"{seconds / 3600}h";
        return $"{seconds / 60}m";
    }

    string scheduleDisplay = Model.ScheduleType switch {
        HealthyCron.Models.ScheduleType.Interval => $"Every {FormatMinutes(Model.PeriodSeconds)}",
        HealthyCron.Models.ScheduleType.Cron => $"Cron: {Model.CronExpression}",
        HealthyCron.Models.ScheduleType.Calendar => $"Calendar: {Model.CalendarExpression}",
        _ => "Unknown"
    };
    string graceDisplay = $"Grace: {FormatMinutes(Model.GraceSeconds)}";
}

<div id="loading-overlay" class="fixed inset-0 z-[100] bg-black/60 backdrop-blur-sm hidden flex flex-col items-center justify-center transition-all duration-300 opacity-0">
    <div class="relative">
        <div class="w-16 h-16 border-4 border-blue-500/20 border-t-blue rounded-full animate-spin"></div>
        <div class="absolute inset-0 flex items-center justify-center">
            <i data-lucide="activity" class="w-6 h-6 text-blue-500 animate-pulse"></i>
        </div>
    </div>
    <p class="mt-4 text-white font-black uppercase tracking-[0.2em] text-[10px] animate-pulse">Processing Request</p>
</div>

<div class="max-w-5xl ml-0 pb-20 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 sm:gap-0 mb-8">
        <div class="flex flex-wrap items-center gap-2 text-hc-muted text-sm tracking-wider font-semibold">
            <a href="/dashboard" class="hover:text-blue-500 transition-colors flex items-center gap-1">
                <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
                Projects
            </a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <a href="/@project?.Slug/monitors" class="hover:text-white transition-colors">@project?.Name</a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <span class="text-white">@Model.Name</span>
        </div>
        @if (ViewBag.IsOwner == true || (ViewBag.ProjectRole != null && (HealthyCron.Enums.ProjectRole)ViewBag.ProjectRole == HealthyCron.Enums.ProjectRole.Manager))
        {
            <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
                <a href="/project/@project?.Slug/settings" class="inline-flex items-center gap-1.5 text-sm font-medium text-[#8A8A93] hover:text-white bg-white/5 hover:bg-white/8 border border-white/8 rounded-lg px-3 py-1.5 transition-all" title="Settings">
                    <i data-lucide="settings" class="w-3.5 h-3.5"></i>
                    Settings
                </a>
                <a href="/project/@project?.Slug/integrations" class="inline-flex items-center gap-1.5 text-sm font-medium text-[#8A8A93] hover:text-white bg-white/5 hover:bg-white/8 border border-white/8 rounded-lg px-3 py-1.5 transition-all">
                    <i data-lucide="zap" class="w-3.5 h-3.5"></i>
                    Integrations
                </a>
            </div>
        }
    </div>

    <!-- Simple Header -->
    <div class="flex flex-col gap-6 mb-10 pb-8 border-b border-white/5">
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
            <div class="flex items-start gap-4 sm:gap-5">
                <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-blue-600/10 border border-blue-500/20 flex items-center justify-center shrink-0">
                    <i data-lucide="monitor" class="w-7 h-7 sm:w-8 sm:h-8 text-blue-500"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-xl sm:text-2xl font-semibold text-white mb-2 break-words tracking-tight">@Model.Name</h1>
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                        @{
                            var isNew = Model.LastPingAt == null;
                            var isLate = Model.LastPingAt != null && Model.NextExpectedAt.HasValue && DateTime.UtcNow > Model.NextExpectedAt.Value;
                        }

                        @if (isNew)
                        {
                            <span class="hc-badge hc-badge-neutral">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#8A8A93]"></span>
                                New
                            </span>
                        }
                        else if (Model.LastStatus == HealthyCron.Models.MonitorStatus.Paused)
                        {
                            <span class="hc-badge hc-badge-warning">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                                Paused
                            </span>
                        }
                        else if (Model.LastStatus == HealthyCron.Models.MonitorStatus.Failed)
                        {
                            <span class="hc-badge hc-badge-danger">
                                <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
                                Down
                            </span>
                        }
                        else if (isLate)
                        {
                            <span class="hc-badge hc-badge-warning">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                                Late
                            </span>
                        }
                        else
                        {
                            <span class="hc-badge hc-badge-success">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                Healthy
                            </span>
                        }
                    </div>
                </div>
            </div>

            @if (ViewBag.CanManage != false)
            {
                <!-- Action Buttons - Stack on mobile -->
                <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-2.5 w-full md:w-auto mt-4 md:mt-0 pt-4 md:pt-0 border-t md:border-t-0 border-white/5">
                    <button onclick="openEditModal()" class="hc-btn-secondary flex items-center justify-center gap-1.5 w-full sm:w-auto">
                        <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                        <span>Edit</span>
                    </button>
                    <button onclick="togglePause()" id="pause-btn" class="hc-btn-secondary flex items-center justify-center gap-1.5 w-full sm:w-auto">
                        <i data-lucide="@(Model.LastStatus == HealthyCron.Models.MonitorStatus.Paused ? "play" : "pause")" class="w-3.5 h-3.5"></i>
                        <span>@(Model.LastStatus == HealthyCron.Models.MonitorStatus.Paused ? "Resume" : "Pause")</span>
                    </button>
                    <button onclick="deleteMonitor()" class="hc-btn-secondary flex items-center justify-center gap-1.5 w-full sm:w-auto !text-red-400 hover:!text-red-300 hover:!bg-red-400/5">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        <span>Delete</span>
                    </button>
                </div>
            }
        </div>

        <!-- How To Ping Section -->
        <div class="space-y-4 max-w-2xl">
            <!-- URL Card -->
            <div class="space-y-2">
                <div class="flex items-center justify-between gap-4">
                    <p class="hc-label mb-0">How To Ping</p>
                    <div class="flex items-center gap-0.5 p-0.5 bg-white/5 rounded-md">
                        <button onclick="switchEndpoint('uuid')" id="tab-uuid" class="px-2.5 py-1 rounded text-[9px] font-medium uppercase tracking-widest transition-all endpoint-tab active bg-white/10 text-white">UUID</button>
                        <button onclick="switchEndpoint('slug')" id="tab-slug" class="px-2.5 py-1 rounded text-[9px] font-medium uppercase tracking-widest transition-all endpoint-tab text-[#8A8A93] hover:text-white">Slug</button>
                    </div>
                </div>

                <div class="w-full space-y-2">
                    <!-- UUID Version -->
                    <div id="endpoint-uuid" class="endpoint-content space-y-1.5">
                        <!-- Success -->
                        <div class="flex items-center gap-3 px-3 py-2.5 bg-[#111114] border border-white/5 rounded-lg">
                            <span class="hc-badge hc-badge-success shrink-0">Success</span>
                            <div id="url-uuid-success" class="font-mono text-xs text-[#8A8A93] flex-1 truncate select-all">
                                @Context.Request.Scheme://@Context.Request.Host/ping/@Model.Id
                            </div>
                            <button onclick="copyUrl('url-uuid-success')" class="text-[#8A8A93] hover:text-white transition-colors shrink-0">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                        <!-- Start -->
                        <div class="flex items-center gap-3 px-3 py-2.5 bg-[#111114] border border-white/5 rounded-lg">
                            <span class="hc-badge hc-badge-info shrink-0">Start</span>
                            <div id="url-uuid-start" class="font-mono text-xs text-[#8A8A93] flex-1 truncate select-all">
                                @Context.Request.Scheme://@Context.Request.Host/ping/@Model.Id/start
                            </div>
                            <button onclick="copyUrl('url-uuid-start')" class="text-[#8A8A93] hover:text-white transition-colors shrink-0">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                        <!-- Fail -->
                        <div class="flex items-center gap-3 px-3 py-2.5 bg-[#111114] border border-white/5 rounded-lg">
                            <span class="hc-badge hc-badge-danger shrink-0">Fail</span>
                            <div id="url-uuid-fail" class="font-mono text-xs text-[#8A8A93] flex-1 truncate select-all">
                                @Context.Request.Scheme://@Context.Request.Host/ping/@Model.Id/fail
                            </div>
                            <button onclick="copyUrl('url-uuid-fail')" class="text-[#8A8A93] hover:text-white transition-colors shrink-0">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Slug Version -->
                    <div id="endpoint-slug" class="endpoint-content hidden space-y-1.5">
                        <!-- Success -->
                        <div class="flex items-center gap-3 px-3 py-2.5 bg-[#111114] border border-white/5 rounded-lg">
                            <span class="hc-badge hc-badge-success shrink-0">Success</span>
                            <div id="url-slug-success" class="font-mono text-xs text-[#8A8A93] flex-1 truncate select-all">
                                @Context.Request.Scheme://@Context.Request.Host/ping/@(ViewBag.PingKey)/@Model.Slug
                            </div>
                            <button onclick="copyUrl('url-slug-success')" class="text-[#8A8A93] hover:text-white transition-colors shrink-0">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                        <!-- Start -->
                        <div class="flex items-center gap-3 px-3 py-2.5 bg-[#111114] border border-white/5 rounded-lg">
                            <span class="hc-badge hc-badge-info shrink-0">Start</span>
                            <div id="url-slug-start" class="font-mono text-xs text-[#8A8A93] flex-1 truncate select-all">
                                @Context.Request.Scheme://@Context.Request.Host/ping/@(ViewBag.PingKey)/@Model.Slug/start
                            </div>
                            <button onclick="copyUrl('url-slug-start')" class="text-[#8A8A93] hover:text-white transition-colors shrink-0">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                        <!-- Fail -->
                        <div class="flex items-center gap-3 px-3 py-2.5 bg-[#111114] border border-white/5 rounded-lg">
                            <span class="hc-badge hc-badge-danger shrink-0">Fail</span>
                            <div id="url-slug-fail" class="font-mono text-xs text-[#8A8A93] flex-1 truncate select-all">
                                @Context.Request.Scheme://@Context.Request.Host/ping/@(ViewBag.PingKey)/@Model.Slug/fail
                            </div>
                            <button onclick="copyUrl('url-slug-fail')" class="text-[#8A8A93] hover:text-white transition-colors shrink-0">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Heartbeat Chart -->
    <section class="glass-card rounded-2xl p-6 mb-8 w-full border border-white/5 overflow-hidden relative">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <h2 class="font-black text-white uppercase tracking-widest text-xs opacity-50 flex items-center gap-2">
                <i data-lucide="activity" class="w-4 h-4 text-blue-500"></i>
                Response Time & Status
            </h2>
            <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-widest bg-hc-black border border-white/5 rounded-xl p-1">
                <button onclick="loadPingData('24h')" id="btn-24h" class="px-3 py-1.5 rounded-lg text-white bg-blue-600/20 text-blue-400 transition-colors">24H</button>
                <button onclick="loadPingData('3d')" id="btn-3d" class="px-3 py-1.5 rounded-lg text-hc-muted hover:text-white transition-colors">3D</button>
                <button onclick="loadPingData('7d')" id="btn-7d" class="px-3 py-1.5 rounded-lg text-hc-muted hover:text-white transition-colors">7D</button>
            </div>
        </div>
        
        <div class="h-48 relative">
            <div id="chart-loading" class="absolute inset-0 z-10 bg-hc-black/50 flex flex-col items-center justify-center rounded-lg backdrop-blur-sm hidden">
                <div class="w-8 h-8 border-2 border-blue-500/30 border-t-blue-500 rounded-full animate-spin mb-2"></div>
                <span class="text-[10px] font-black uppercase tracking-widest text-blue-500 animate-pulse">Loading Data...</span>
            </div>
            <div id="chart-error" class="absolute inset-0 z-10 bg-hc-black/80 flex flex-col items-center justify-center rounded-lg backdrop-blur-sm hidden">
                <i data-lucide="alert-circle" class="w-6 h-6 text-red-500 mb-2"></i>
                <span class="text-[10px] font-black uppercase tracking-widest text-red-500">Failed to load data</span>
                <button onclick="loadPingData()" class="mt-2 text-[10px] text-white underline hover:text-blue-400 transition-colors">Retry</button>
            </div>
            <canvas id="monitorChart"></canvas>
        </div>
    </section>

    <!-- Main Content Grid -->
    <div class="space-y-8 mb-8">
        <!-- Top Row: Uptime & Scheduling -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            
            <!-- Monthly Status Table -->
            <section class="glass-card rounded-2xl p-5 border border-white/5 h-full">
                 <h3 class="font-black text-white uppercase tracking-widest text-[10px] mb-4 flex items-center gap-2 opacity-50 px-1">
                    <i data-lucide="calendar" class="w-3.5 h-3.5 text-blue-500"></i>
                    Monthly Uptime
                </h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-[9px] uppercase font-black text-hc-muted border-b border-white/5">
                                <th class="px-2 py-2">Month</th>
                                <th class="px-2 py-2 text-right">Downtime</th>
                                <th class="px-2 py-2 text-right">Uptime</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            @foreach (var stat in monthlyStats.Take(5)) 
                            {
                                <tr class="group hover:bg-white/[0.02] transition-colors">
                                    <td class="px-2 py-2">
                                        <div class="flex items-center gap-2">
                                            <div class="w-1.5 h-1.5 rounded-full @(stat.UptimePercentage >= 99.9 ? "bg-green-500" : (stat.UptimePercentage >= 99 ? "bg-green-400" : "bg-hc-amber"))"></div>
                                            <span class="text-[10px] font-bold text-white/80 group-hover:text-white transition-colors">@stat.Month</span>
                                        </div>
                                    </td>
                                    <td class="px-2 py-2 text-right">
                                        <span class="text-[10px] font-mono text-white/40 group-hover:text-white/60 transition-colors">@stat.DowntimeDuration</span>
                                    </td>
                                    <td class="px-2 py-2 text-right">
                                        <span class="text-[10px] font-mono font-bold @(stat.UptimePercentage >= 99.9 ? "text-green-500" : (stat.UptimePercentage >= 99 ? "text-green-400" : "text-hc-amber"))">@stat.UptimePercentage%</span>
                                    </td>
                                </tr>
                            }
                            @if (!monthlyStats.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-[10px] text-hc-muted italic opacity-50">No data available yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Scheduling Rules Table -->
            <section class="glass-card rounded-2xl p-5 border border-white/5 h-full">
                 <h3 class="font-black text-white uppercase tracking-widest text-[10px] mb-4 flex items-center gap-2 opacity-50 px-1">
                    <i data-lucide="timer" class="w-3.5 h-3.5 text-blue-500"></i>
                    Scheduling Rules
                </h3>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <tbody class="divide-y divide-white/5">
                             <tr class="group hover:bg-white/[0.02] transition-colors">
                                <td class="px-2 py-3 w-1/3">
                                    <span class="text-[10px] font-black text-hc-muted uppercase tracking-widest">Schedule</span>
                                </td>
                                <td class="px-2 py-3 text-right">
                                    <span class="text-[11px] font-bold text-white">@scheduleDisplay</span>
                                </td>
                            </tr>
                            <tr class="group hover:bg-white/[0.02] transition-colors">
                                <td class="px-2 py-3">
                                    <span class="text-[10px] font-black text-hc-muted uppercase tracking-widest">Grace Period</span>
                                </td>
                                <td class="px-2 py-3 text-right">
                                    <span class="text-[11px] font-bold text-white">@FormatMinutes(Model.GraceSeconds)</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                @if (ViewBag.CanManage != false)
                {
                    <div class="mt-4 flex justify-end">
                         <button onclick="openScheduleModal()" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-blue-600/10 border border-white/10 hover:border-blue-500/20 text-hc-muted hover:text-blue-500 transition-all text-[10px] font-black uppercase tracking-widest flex items-center gap-2">
                            <i data-lucide="edit-2" class="w-3 h-3"></i>
                            Edit Rules
                        </button>
                    </div>
                }
            </section>
        </div>

        <!-- Notification Section (Full Width Table) -->
        <section class="glass-card flex flex-col rounded-2xl border border-white/5 overflow-hidden">
             <div class="px-6 py-4 flex items-center justify-between mb-0 border-b border-white/5 bg-hc-black/20">
                <h3 class="font-bold text-white text-sm flex items-center gap-2">
                    <i data-lucide="bell" class="w-4 h-4 text-blue-500"></i>
                    Active Notifications
                </h3>
            </div>
            <div class="w-full overflow-auto">
                <table class="w-full caption-bottom text-sm">
                    <thead class="[&_tr]:border-b border-white/5 bg-hc-black/10">
                        <tr class="border-b border-white/5 transition-colors hover:bg-white/[0.02]">
                            <th class="h-10 px-4 pl-6 text-left align-middle font-medium text-hc-muted uppercase text-[10px] tracking-widest w-full">Integration</th>
                            <th class="h-10 px-4 text-right align-middle font-medium text-hc-muted uppercase text-[10px] tracking-widest whitespace-nowrap pr-6">Status</th>
                        </tr>
                    </thead>
                    <tbody class="[&_tr:last-child]:border-0 divide-y divide-white/5">
                         @if (monitorIntegrations.Any(x => x.IsEnabledForMonitor))
                        {
                            foreach (var item in monitorIntegrations.Where(x => x.IsEnabledForMonitor))
                            {
                                <tr class="border-b transition-colors hover:bg-white/[0.02] border-white/5 group">
                                    <td class="p-4 pl-6 align-middle">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-lg bg-hc-black-light border border-white/5 flex items-center justify-center shrink-0 overflow-hidden">
                                                @switch(item.Integration.Type)
                                                {
                                                    case HealthyCron.Enums.IntegrationType.Slack:
                                                        <img src="/images/slack.png" class="w-4 h-4 object-contain" alt="Slack" />
                                                        break;
                                                    case HealthyCron.Enums.IntegrationType.PagerDuty:
                                                        <img src="/images/pagerduty.png" class="w-4 h-4 object-contain" alt="PagerDuty" />
                                                        break;
                                                    case HealthyCron.Enums.IntegrationType.Email:
                                                        <img src="/images/gmail.png" class="w-4 h-4 object-contain" alt="Email" />
                                                        break;
                                                    case HealthyCron.Enums.IntegrationType.Discord:
                                                        <img src="/images/discord.png" class="w-4 h-4 object-contain" alt="Discord" />
                                                        break;
                                                    case HealthyCron.Enums.IntegrationType.Teams:
                                                        <img src="/images/teams.png" class="w-4 h-4 object-contain" alt="Teams" />
                                                        break;
                                                    case HealthyCron.Enums.IntegrationType.GoogleChat:
                                                        <i data-lucide="message-square" class="w-3.5 h-3.5 text-[#00897B]"></i>
                                                        break;
                                                    case HealthyCron.Enums.IntegrationType.WhatsApp:
                                                        <img src="/images/whatsapp.png" class="w-4 h-4 object-contain" alt="WhatsApp" />
                                                        break;
                                                    case HealthyCron.Enums.IntegrationType.Call:
                                                        <img src="/images/telephone.png" class="w-4 h-4 object-contain" alt="Call" />
                                                        break;
                                                    case HealthyCron.Enums.IntegrationType.Telegram:
                                                        <img src="/images/telegram.png" class="w-4 h-4 object-contain" alt="Telegram" />
                                                        break;
                                                    case HealthyCron.Enums.IntegrationType.Pushover:
                                                        <img src="/images/pushover.png" class="w-4 h-4 object-contain" alt="Pushover" />
                                                        break;
                                                    case HealthyCron.Enums.IntegrationType.Spike:
                                                        <img src="/images/spike.webp" class="w-4 h-4 object-contain" alt="Spike.sh" />
                                                        break;
                                                    case HealthyCron.Enums.IntegrationType.Webhook:
                                                        <img src="/images/webhook.png" class="w-4 h-4 object-contain" alt="Webhook" />
                                                        break;
                                                    default:
                                                        <i data-lucide="bell" class="w-4 h-4 text-blue-500"></i>
                                                        break;
                                                }
                                            </div>

                                            <div class="flex flex-col">
                                                <span class="text-sm font-medium text-white truncate">@item.Integration.Name</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="p-4 pr-6 align-middle text-right">
                                        <button onclick="toggleMonitorIntegration('@item.Integration.Id', this)" 
                                                data-enabled="true"
                                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md transition-all text-xs font-medium bg-green-500/10 border border-green-500/20 text-green-500 hover:bg-red-500/10 hover:text-red-500 hover:border-red-500/20 group-hover/btn:content-['Disable'] whitespace-nowrap">
                                            <i data-lucide="check" class="w-3 h-3"></i>
                                            <span>Enabled</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="p-8 text-center text-hc-muted font-medium text-xs opacity-50 bg-white/[0.01]">
                                    No active integrations. 
                                    <a href="/project/@project?.Slug/integrations" class="text-blue-500 hover:underline hover:text-blue-400 ml-1">Manage Integrations</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <!-- Logs -->
    <section class="glass-card rounded-2xl overflow-hidden w-full bg-hc-black/10">
        <div class="px-6 py-4 flex items-center justify-between mb-0 border-b border-white/5 bg-hc-black/20">
            <h3 class="font-bold text-white text-sm">Recent Activity Log</h3>
            <a href="/monitor/@Model.Slug/logs" class="text-[10px] uppercase font-bold text-blue-500 hover:text-blue-400 transition-colors">View all</a>
        </div>

        <div class="w-full overflow-auto">
            <table class="w-full caption-bottom text-sm text-left">
                <thead class="[&_tr]:border-b border-white/5 bg-hc-black/10">
                    <tr class="border-b border-white/5 transition-colors hover:bg-white/[0.02]">
                        <th class="h-10 px-4 pl-6 align-middle font-medium text-hc-muted uppercase text-[10px] tracking-widest w-10">#</th>
                        <th class="h-10 px-4 align-middle font-medium text-hc-muted uppercase text-[10px] tracking-widest w-28">Date</th>
                        <th class="h-10 px-4 align-middle font-medium text-hc-muted uppercase text-[10px] tracking-widest w-24">Time</th>
                        <th class="h-10 px-4 align-middle font-medium text-hc-muted uppercase text-[10px] tracking-widest w-24">Status</th>
                        <th class="h-10 px-4 pr-6 align-middle font-medium text-hc-muted uppercase text-[10px] tracking-widest">User Agent</th>
                    </tr>
                </thead>
                <tbody class="text-sm text-hc-muted">
                    @{
                        var userTz = ViewBag.UserTimezone as string ?? "UTC";
                        var pingList = pings?.OrderByDescending(p => p.ReceivedAt).Take(5).ToList();
                        int rowNum = pingList?.Count ?? 0;
                    }
                    @if (pingList != null && pingList.Any())
                    {
                        @foreach (var ping in pingList)
                        {
                            var statusClass = ping.Status == HealthyCron.Models.PingType.Success ? "bg-green-500/10 text-green-500 border border-green-500/20" :
                            (ping.Status == HealthyCron.Models.PingType.Start ? "bg-blue-500/10 text-blue-500 border border-blue-500/20" : 
                            (ping.Status == HealthyCron.Models.PingType.Paused || ping.Status == HealthyCron.Models.PingType.Resumed ? "bg-hc-amber/10 text-hc-amber border border-hc-amber/20" : "bg-red-500/10 text-red-500 border border-red-500/20"));
                            
                            var statusText = ping.Status switch {
                                HealthyCron.Models.PingType.Success => "OK",
                                HealthyCron.Models.PingType.Start => "Start",
                                HealthyCron.Models.PingType.Paused => "Paused",
                                HealthyCron.Models.PingType.Resumed => "Resumed",
                                _ => "Fail"
                            };
                            var localTime = TimezoneHelper.ToUserTime(ping.ReceivedAt, userTz);

                            <tr class="hover:bg-white/[0.02] transition-colors cursor-pointer group border-b border-white/5" onclick="showPingDetails(this)"
                                data-ping="@System.Text.Json.JsonSerializer.Serialize(new {
                                        id = ping.Id,
                                        receivedAt = ping.ReceivedAt,
                                        timeStr = localTime.ToString("MMM dd, yyyy HH:mm:ss") + " (" + userTz + ")",
                                        dateDisplay = localTime.ToString("MMM dd"),
                                        timeDisplay = localTime.ToString("HH:mm:ss"),
                                        status = ping.Status.ToString(),
                                        message = ping.Message,
                                        ipAddress = ping.IpAddress,
                                        userAgent = ping.UserAgent,
                                        method = ping.HttpMethod,
                                        headers = ping.RequestHeaders
                                    })"
                                data-id="@ping.Id" data-time="@localTime.ToString("MMM dd, yyyy HH:mm:ss")" data-status="@statusText" data-message="@ping.Message" data-ip="@ping.IpAddress" data-ua="@ping.UserAgent" data-method="@ping.HttpMethod" data-headers="@ping.RequestHeaders">
                                <td class="p-4 pl-6 align-middle text-center">
                                    <span class="text-[10px] text-hc-muted font-black opacity-30 group-hover:opacity-100 transition-opacity">@(rowNum--)</span>
                                </td>
                                <td class="p-4 align-middle">
                                     <span class="text-sm text-white font-medium whitespace-nowrap">@localTime.ToString("MMM dd")</span>
                                </td>
                                <td class="p-4 align-middle">
                                    <span class="text-xs text-hc-muted font-mono whitespace-nowrap">@localTime.ToString("HH:mm:ss")</span>
                                </td>
                                <td class="p-4 align-middle">
                                    <span class="px-2 py-0.5 rounded-md text-[9px] font-black uppercase tracking-widest @statusClass">
                                        @statusText
                                    </span>
                                </td>
                                <td class="p-4 pr-6 align-middle">
                                    <div class="flex items-center gap-1.5 opacity-60">
                                        <i data-lucide="globe" class="w-3.5 h-3.5 text-hc-muted shrink-0"></i>
                                        <span class="text-xs text-white font-mono truncate" title="@ping.UserAgent">@(string.IsNullOrEmpty(ping.UserAgent) ? "N/A" : ping.UserAgent)</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="p-8 text-center text-hc-muted font-medium text-xs opacity-50 bg-white/[0.01]">
                                No activity recorded yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @* Documentation Sections Removed *@
</div>

