@model HealthyCron.Models.Monitor
@{
    var project = ViewBag.Project as HealthyCron.Models.Project;
    var pings = (ViewBag.RecentPings as IEnumerable<HealthyCron.Models.MonitorPing> ?? Enumerable.Empty<HealthyCron.Models.MonitorPing>()).ToList();
    var graphData = ViewBag.GraphData as int[];
    var monitorIntegrations = ViewBag.MonitorIntegrations as List<HealthyCron.Models.ViewModels.IntegrationListItemViewModel> ?? new List<HealthyCron.Models.ViewModels.IntegrationListItemViewModel>();
    var monthlyStats = ViewBag.MonthlyStats as List<HealthyCron.Models.DTOs.MonthlyUptimeDto> ?? new List<HealthyCron.Models.DTOs.MonthlyUptimeDto>();
    ViewData["Title"] = $"{Model.Name} - Monitor Details";
    Layout = "_DashboardLayout";
    
    // Calculate display values for schedule
    string FormatMinutes(int? seconds) {
        if (!seconds.HasValue) return "0m";
        if (seconds >= 86400) return $"{seconds / 86400}d";
        if (seconds >= 3600) return $"{seconds / 3600}h";
        return $"{seconds / 60}m";
    }

    string scheduleDisplay = Model.ScheduleType switch {
        HealthyCron.Models.ScheduleType.Interval => $"Every {FormatMinutes(Model.PeriodSeconds)}",
        HealthyCron.Models.ScheduleType.Cron => $"Cron: {Model.CronExpression}",
        HealthyCron.Models.ScheduleType.Calendar => $"Calendar: {Model.CalendarExpression}",
        _ => "Unknown"
    };
    string graceDisplay = $"Grace: {FormatMinutes(Model.GraceSeconds)}";
}

<div id="loading-overlay" class="fixed inset-0 z-[100] bg-black/60 backdrop-blur-sm hidden flex flex-col items-center justify-center transition-all duration-300 opacity-0">
    <div class="relative">
        <div class="w-16 h-16 border-4 border-blue/20 border-t-blue rounded-full animate-spin"></div>
        <div class="absolute inset-0 flex items-center justify-center">
            <i data-lucide="activity" class="w-6 h-6 text-blue animate-pulse"></i>
        </div>
    </div>
    <p class="mt-4 text-white font-black uppercase tracking-[0.2em] text-[10px] animate-pulse">Processing Request</p>
</div>

<div class="max-w-6xl mx-auto pb-20 px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <div class="flex items-center justify-between mb-8">
        <div class="flex flex-wrap items-center gap-2 text-text-secondary text-sm tracking-wider font-semibold">
            <a href="/dashboard" class="hover:text-blue transition-colors flex items-center gap-1">
                <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
                Projects
            </a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <a href="/@project?.Slug/monitors" class="hover:text-white transition-colors">@project?.Name</a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <span class="text-white">@Model.Name</span>
        </div>
        <div class="flex items-center gap-4">
        </div>
    </div>

    <!-- Simple Header -->
    <div class="flex flex-col gap-6 mb-10 pb-8 border-b border-white/5">
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
            <div class="flex items-start gap-4 sm:gap-5">
                <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-blue/10 border border-blue/20 flex items-center justify-center shrink-0">
                    <i data-lucide="activity" class="w-7 h-7 sm:w-8 sm:h-8 text-blue"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <h1 class="text-xl sm:text-2xl font-black text-white mb-2 break-words">@Model.Name</h1>
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                        @if (Model.LastStatus == HealthyCron.Models.MonitorStatus.Paused)
                        {
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest bg-amber-500/10 text-amber-500 shrink-0 w-fit">
                                <i data-lucide="pause-circle" class="w-3 h-3"></i>
                                Paused
                            </span>
                        }
                        else if (Model.LastStatus == HealthyCron.Models.MonitorStatus.Success)
                        {
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest bg-emerald-500/10 text-emerald-500 shrink-0 w-fit">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                Healthy
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest bg-rose-500/10 text-rose-500 shrink-0 w-fit">
                                <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                                Down
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Action Buttons - Stack on mobile -->
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 w-full sm:w-auto mt-4 sm:mt-0">
                <button onclick="openEditModal()" class="flex items-center justify-center gap-2 px-3 sm:px-4 py-2.5 rounded-xl bg-navy border border-white/10 text-white hover:border-blue transition-all text-xs font-bold w-full sm:w-auto">
                    <i data-lucide="edit-3" class="w-4 h-4 text-blue"></i>
                    <span class="inline">Edit</span>
                </button>
                <button onclick="togglePause()" id="pause-btn" class="flex items-center justify-center gap-2 px-3 sm:px-4 py-2.5 rounded-xl bg-navy border border-white/10 text-white hover:border-amber-500 transition-all text-xs font-bold w-full sm:w-auto">
                    <i data-lucide="@(Model.LastStatus == HealthyCron.Models.MonitorStatus.Paused ? "play" : "pause")" class="w-4 h-4 text-amber-500"></i>
                    <span>@(Model.LastStatus == HealthyCron.Models.MonitorStatus.Paused ? "Resume" : "Pause")</span>
                </button>
                <button onclick="deleteMonitor()" class="flex items-center justify-center gap-2 px-3 sm:px-4 py-2.5 rounded-xl bg-navy border border-white/10 text-white hover:border-rose-500 transition-all text-xs font-bold w-full sm:w-auto">
                    <i data-lucide="trash-2" class="w-4 h-4 text-rose-500"></i>
                    <span class="inline">Delete</span>
                </button>
            </div>
        </div>

        <!-- How To Ping Section -->
        <div class="space-y-4 max-w-2xl">
            <!-- URL Card -->
            <div class="space-y-2">
                <div class="flex items-center justify-between gap-4">
                    <p class="text-[10px] font-black uppercase tracking-widest text-text-secondary">How To Ping</p>
                    <div class="flex items-center gap-1 p-0.5 bg-black/40 border border-white/10 rounded-lg">
                        <button onclick="switchEndpoint('uuid')" id="tab-uuid" class="px-2 py-1 rounded-md text-[9px] font-black uppercase tracking-widest transition-all endpoint-tab active bg-blue/10 text-blue">UUID</button>
                        <button onclick="switchEndpoint('slug')" id="tab-slug" class="px-2 py-1 rounded-md text-[9px] font-black uppercase tracking-widest transition-all endpoint-tab text-text-secondary opacity-50">Slug</button>
                    </div>
                </div>

                <div class="w-full space-y-2">
                    <!-- UUID Version -->
                    <div id="endpoint-uuid" class="endpoint-content space-y-2">
                         <!-- Success -->
                        <div class="flex items-center gap-2 bg-black/40 border border-white/10 rounded-xl p-1 pr-2 group hover:border-emerald-500/20 transition-all">
                            <div class="bg-emerald-500/10 px-2 py-1.5 rounded-lg border border-emerald-500/20 shrink-0 text-[10px] font-black text-emerald-500 uppercase w-16 text-center">Success</div>
                            <div class="flex-1 overflow-hidden px-2 min-w-0">
                                <div id="url-uuid-success" class="text-white/80 font-mono text-[10px] truncate select-all">
                                    @Context.Request.Scheme://@Context.Request.Host/ping/@Model.Id
                                </div>
                            </div>
                            <button onclick="copyUrl('url-uuid-success')" class="p-1.5 hover:bg-white/5 rounded-lg text-text-secondary hover:text-white transition-all shrink-0">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                         <!-- Start -->
                        <div class="flex items-center gap-2 bg-black/40 border border-white/10 rounded-xl p-1 pr-2 group hover:border-blue/20 transition-all">
                            <div class="bg-blue/10 px-2 py-1.5 rounded-lg border border-blue/20 shrink-0 text-[10px] font-black text-blue uppercase w-16 text-center">Start</div>
                            <div class="flex-1 overflow-hidden px-2 min-w-0">
                                <div id="url-uuid-start" class="text-white/80 font-mono text-[10px] truncate select-all">
                                    @Context.Request.Scheme://@Context.Request.Host/ping/@Model.Id/start
                                </div>
                            </div>
                            <button onclick="copyUrl('url-uuid-start')" class="p-1.5 hover:bg-white/5 rounded-lg text-text-secondary hover:text-white transition-all shrink-0">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                         <!-- Fail -->
                        <div class="flex items-center gap-2 bg-black/40 border border-white/10 rounded-xl p-1 pr-2 group hover:border-rose-500/20 transition-all">
                            <div class="bg-rose-500/10 px-2 py-1.5 rounded-lg border border-rose-500/20 shrink-0 text-[10px] font-black text-rose-500 uppercase w-16 text-center">Fail</div>
                            <div class="flex-1 overflow-hidden px-2 min-w-0">
                                <div id="url-uuid-fail" class="text-white/80 font-mono text-[10px] truncate select-all">
                                    @Context.Request.Scheme://@Context.Request.Host/ping/@Model.Id/fail
                                </div>
                            </div>
                            <button onclick="copyUrl('url-uuid-fail')" class="p-1.5 hover:bg-white/5 rounded-lg text-text-secondary hover:text-white transition-all shrink-0">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Slug Version -->
                    <div id="endpoint-slug" class="endpoint-content hidden space-y-2">
                        <!-- Success -->
                        <div class="flex items-center gap-2 bg-black/40 border border-white/10 rounded-xl p-1 pr-2 group hover:border-purple/20 transition-all">
                            <div class="bg-purple/10 px-2 py-1.5 rounded-lg border border-purple/20 shrink-0 text-[10px] font-black text-purple uppercase w-16 text-center">Success</div>
                            <div class="flex-1 overflow-hidden px-2 min-w-0">
                                <div id="url-slug-success" class="text-white/80 font-mono text-[10px] truncate select-all">
                                    @Context.Request.Scheme://@Context.Request.Host/ping/@(ViewBag.PingKey)/@Model.Slug
                                </div>
                            </div>
                            <button onclick="copyUrl('url-slug-success')" class="p-1.5 hover:bg-white/5 rounded-lg text-text-secondary hover:text-white transition-all shrink-0">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                         <!-- Start -->
                        <div class="flex items-center gap-2 bg-black/40 border border-white/10 rounded-xl p-1 pr-2 group hover:border-blue/20 transition-all">
                            <div class="bg-blue/10 px-2 py-1.5 rounded-lg border border-blue/20 shrink-0 text-[10px] font-black text-blue uppercase w-16 text-center">Start</div>
                            <div class="flex-1 overflow-hidden px-2 min-w-0">
                                <div id="url-slug-start" class="text-white/80 font-mono text-[10px] truncate select-all">
                                    @Context.Request.Scheme://@Context.Request.Host/ping/@(ViewBag.PingKey)/@Model.Slug/start
                                </div>
                            </div>
                            <button onclick="copyUrl('url-slug-start')" class="p-1.5 hover:bg-white/5 rounded-lg text-text-secondary hover:text-white transition-all shrink-0">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                         <!-- Fail -->
                        <div class="flex items-center gap-2 bg-black/40 border border-white/10 rounded-xl p-1 pr-2 group hover:border-rose-500/20 transition-all">
                            <div class="bg-rose-500/10 px-2 py-1.5 rounded-lg border border-rose-500/20 shrink-0 text-[10px] font-black text-rose-500 uppercase w-16 text-center">Fail</div>
                            <div class="flex-1 overflow-hidden px-2 min-w-0">
                                <div id="url-slug-fail" class="text-white/80 font-mono text-[10px] truncate select-all">
                                    @Context.Request.Scheme://@Context.Request.Host/ping/@(ViewBag.PingKey)/@Model.Slug/fail
                                </div>
                            </div>
                            <button onclick="copyUrl('url-slug-fail')" class="p-1.5 hover:bg-white/5 rounded-lg text-text-secondary hover:text-white transition-all shrink-0">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Heartbeat Chart -->
    <section class="glass-card rounded-2xl p-6 mb-8 w-full border border-white/5 overflow-hidden">
        <div class="flex items-center justify-between mb-8">
            <h2 class="font-black text-white uppercase tracking-widest text-xs opacity-50">Last 24 Hours Heartbeats</h2>
            <div class="flex items-center gap-4 text-[10px] text-text-secondary uppercase tracking-widest font-bold">
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue"></span> Ping Received</span>
            </div>
        </div>
        <div class="h-32 flex items-end gap-px sm:gap-1 px-2">
            @if (graphData != null)
            {
                for (int i = 0; i < 24; i++)
                {
                    var pingsCount = graphData[i];
                    <div class="flex-1 group relative h-full flex items-end">
                        <div class="bg-blue/10 rounded-t-sm w-full transition-all group-hover:bg-blue/30 relative" style="height: @(Math.Max(5, Math.Min(100, (pingsCount * 20) + 5)))%">
                            @if (pingsCount > 0)
                            {
                                <div class="bg-blue rounded-t-sm w-full h-full opacity-60"></div>
                            }
                        </div>
                        <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-2 bg-navy-light border border-white/10 rounded-xl text-[10px] text-white opacity-0 group-hover:opacity-100 pointer-events-none transition-all shadow-2xl whitespace-nowrap z-30">
                            <div class="font-black mb-1">@(23 - i)h ago</div>
                            <div class="text-blue">@pingsCount pings</div>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="flex justify-between mt-6 text-[10px] text-text-secondary font-black uppercase tracking-widest px-2 border-t border-white/5 pt-4">
            <span>24h ago</span>
            <span>Now</span>
        </div>
    </section>

    <!-- Main Content Grid -->
    <div class="space-y-8 mb-8">
        <!-- Top Row: Uptime & Scheduling -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            
            <!-- Monthly Status Table -->
            <section class="glass-card rounded-2xl p-5 border border-white/5 h-full">
                 <h3 class="font-black text-white uppercase tracking-widest text-[10px] mb-4 flex items-center gap-2 opacity-50 px-1">
                    <i data-lucide="calendar" class="w-3.5 h-3.5 text-blue"></i>
                    Monthly Uptime
                </h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-[9px] uppercase font-black text-text-secondary border-b border-white/5">
                                <th class="px-2 py-2">Month</th>
                                <th class="px-2 py-2 text-right">Downtime</th>
                                <th class="px-2 py-2 text-right">Uptime</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            @foreach (var stat in monthlyStats.Take(5)) 
                            {
                                <tr class="group hover:bg-white/[0.02] transition-colors">
                                    <td class="px-2 py-2">
                                        <div class="flex items-center gap-2">
                                            <div class="w-1.5 h-1.5 rounded-full @(stat.UptimePercentage >= 99.9 ? "bg-emerald-500" : (stat.UptimePercentage >= 99 ? "bg-emerald-400" : "bg-amber-500"))"></div>
                                            <span class="text-[10px] font-bold text-white/80 group-hover:text-white transition-colors">@stat.Month</span>
                                        </div>
                                    </td>
                                    <td class="px-2 py-2 text-right">
                                        <span class="text-[10px] font-mono text-white/40 group-hover:text-white/60 transition-colors">@stat.DowntimeDuration</span>
                                    </td>
                                    <td class="px-2 py-2 text-right">
                                        <span class="text-[10px] font-mono font-bold @(stat.UptimePercentage >= 99.9 ? "text-emerald-500" : (stat.UptimePercentage >= 99 ? "text-emerald-400" : "text-amber-500"))">@stat.UptimePercentage%</span>
                                    </td>
                                </tr>
                            }
                            @if (!monthlyStats.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-[10px] text-text-secondary italic opacity-50">No data available yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Scheduling Rules Table -->
            <section class="glass-card rounded-2xl p-5 border border-white/5 h-full">
                 <h3 class="font-black text-white uppercase tracking-widest text-[10px] mb-4 flex items-center gap-2 opacity-50 px-1">
                    <i data-lucide="timer" class="w-3.5 h-3.5 text-blue"></i>
                    Scheduling Rules
                </h3>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <tbody class="divide-y divide-white/5">
                             <tr class="group hover:bg-white/[0.02] transition-colors">
                                <td class="px-2 py-3 w-1/3">
                                    <span class="text-[10px] font-black text-text-secondary uppercase tracking-widest">Schedule</span>
                                </td>
                                <td class="px-2 py-3 text-right">
                                    <span class="text-[11px] font-bold text-white">@scheduleDisplay</span>
                                </td>
                            </tr>
                            <tr class="group hover:bg-white/[0.02] transition-colors">
                                <td class="px-2 py-3">
                                    <span class="text-[10px] font-black text-text-secondary uppercase tracking-widest">Grace Period</span>
                                </td>
                                <td class="px-2 py-3 text-right">
                                    <span class="text-[11px] font-bold text-white">@FormatMinutes(Model.GraceSeconds)</span>
                                </td>
                            </tr>
                            <tr class="group hover:bg-white/[0.02] transition-colors">
                                <td class="px-2 py-3">
                                    <span class="text-[10px] font-black text-text-secondary uppercase tracking-widest">Next Run</span>
                                </td>
                                <td class="px-2 py-3 text-right">
                                    <!-- Placeholder, not passed in Model yet, showing generic info or removing -->
                                    <span class="text-[10px] font-mono text-white/50">Calculating...</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <div class="mt-4 flex justify-end">
                     <button onclick="openScheduleModal()" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-blue/10 border border-white/10 hover:border-blue/20 text-text-secondary hover:text-blue transition-all text-[10px] font-black uppercase tracking-widest flex items-center gap-2">
                        <i data-lucide="edit-2" class="w-3 h-3"></i>
                        Edit Rules
                    </button>
                </div>
            </section>
        </div>

        <!-- Notification Section (Full Width Table) -->
        <section class="glass-card rounded-2xl p-5 border border-white/5">
             <h3 class="font-black text-white uppercase tracking-widest text-[10px] mb-4 flex items-center gap-2 opacity-50 px-1">
                <i data-lucide="bell" class="w-3.5 h-3.5 text-blue"></i>
                Active Notifications
            </h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-[9px] uppercase font-black text-text-secondary border-b border-white/5">
                            <th class="px-4 py-3">Integration</th>
                            <th class="px-4 py-3">Type</th>
                            <th class="px-4 py-3 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                         @if (monitorIntegrations.Any(x => x.IsEnabledForMonitor))
                        {
                            foreach (var item in monitorIntegrations.Where(x => x.IsEnabledForMonitor))
                            {
                                <tr class="group hover:bg-white/[0.02] transition-colors">
                                    <td class="px-4 py-3">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-lg bg-navy-light border border-white/5 flex items-center justify-center shrink-0 overflow-hidden">
                                                @switch(item.Integration.Type)
                                                {
                                                    case HealthyCron.Enums.IntegrationType.Slack:
                                                        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                            <path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z" fill="#E01E5A"/>
                                                        </svg>
                                                        break;
                                                    case HealthyCron.Enums.IntegrationType.PagerDuty:
                                                        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="#06AC38" xmlns="http://www.w3.org/2000/svg">
                                                            <path d="M16.667 0H11.4L9.733 9.667h4.6c2.467 0 4.2-.4 5.4-1.333C21 7.333 21.667 5.8 21.667 3.8c0-1.267-.4-2.2-1.133-2.8C19.8.333 18.467 0 16.667 0zM9.333 11.733 8.267 18H3.733L6.667 0H2.333L0 14.933 1.333 24h6.8L9.8 18h4.2l1.667-6.267H9.333z"/>
                                                        </svg>
                                                        break;
                                                    case HealthyCron.Enums.IntegrationType.Email:
                                                        <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
