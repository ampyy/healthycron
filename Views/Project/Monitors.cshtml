@model HealthyCron.Models.ViewModels.ProjectMonitorsViewModel
@{
    var project = Model.Project!;
    ViewData["Title"] = $"{(project != null ? project.Name : "Project")} - Monitors";
    Layout = "_DashboardLayout";
}

<!-- Breadcrumbs -->
<div class="flex items-center gap-2 text-text-secondary text-sm tracking-wider font-semibold mb-4">
    <a href="/dashboard/projects" class="hover:text-blue transition-colors flex items-center gap-1">
        <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
        Projects
    </a>
    <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
    <span class="text-white">@project.Name</span>
</div>

<!-- Project Header -->
<div class="mb-8">
    <div class="glass-card rounded-2xl p-6 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div class="min-w-0">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue/10 border border-blue/20 flex items-center justify-center">
                    <i data-lucide="folder" class="text-blue shrink-0"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white leading-none mb-1">@project.Name</h1>
                    <p class="text-[10px] text-text-secondary uppercase tracking-widest font-bold">Project Overview</p>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
            @if (Model.CanManage)
            {
                <a href="/project/@project.Slug/settings"
                    class="p-2.5 rounded-xl bg-hc-black-light border border-border-color text-text-secondary hover:text-white hover:border-white/20 transition-all active:scale-95 group"
                    title="Project Settings">
                    <i data-lucide="settings" class="w-5 h-5 group-hover:rotate-45 transition-transform duration-500"></i>
                </a>
            }
            <a href="/project/@project.Slug/integrations"
                class="p-2.5 px-4 rounded-xl bg-hc-black-light border border-border-color text-text-secondary hover:text-white hover:border-white/20 transition-all active:scale-95 flex items-center gap-2 group">
                <i data-lucide="zap" class="w-5 h-5 group-hover:text-blue-500 transition-colors"></i>
                <span class="font-bold text-sm hidden sm:inline">Integrations</span>
            </a>
            @if (Model.CanManage)
            {
                <button onclick="openCreateModal()"
                    class="bg-blue hover:bg-blue/80 text-white px-4 sm:px-5 py-2.5 rounded-xl font-bold flex items-center gap-2 transition-all shadow-lg shadow-blue/20 active:scale-95 text-xs sm:text-sm">
                    <i data-lucide="plus" class="w-4 h-4 sm:w-5 sm:h-5"></i>
                    <span>New Monitor</span>
                </button>
            }
        </div>
    </div>
</div>

<!-- Stats Overview -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="glass-card rounded-2xl p-4 border border-white/5">
        <p class="text-[10px] uppercase tracking-widest font-black text-text-secondary opacity-50 mb-1">Total</p>
        <div class="text-xl font-black text-white">@Model.Monitors.Count</div>
    </div>
    <div class="glass-card rounded-2xl p-4 border border-white/5">
        <p class="text-[10px] uppercase tracking-widest font-black text-emerald-500/80 mb-1">Healthy</p>
        <div class="text-xl font-black text-white">@Model.Monitors.Count(m => m.Monitor.LastStatus == HealthyCron.Models.MonitorStatus.Success)</div>
    </div>
    <div class="glass-card rounded-2xl p-4 border border-white/5">
        <p class="text-[10px] uppercase tracking-widest font-black text-rose-500/80 mb-1">Down</p>
        <div class="text-xl font-black text-white">@Model.Monitors.Count(m => m.Monitor.LastStatus == HealthyCron.Models.MonitorStatus.Failed)</div>
    </div>
</div>

@if (!Model.Monitors.Any())
{
    <!-- Empty State -->
    <div class="glass-card rounded-3xl overflow-hidden text-center py-24 border-dashed border-2 border-white/5">
        <div class="w-20 h-20 rounded-2xl bg-blue/10 flex items-center justify-center mx-auto mb-6">
            <i data-lucide="folder" class="w-10 h-10 text-blue"></i>
        </div>
        <h3 class="text-2xl font-black text-white mb-2">No monitors found</h3>
        <p class="text-text-secondary mb-8 max-w-sm mx-auto font-medium">Start monitoring your first cron job by
            creating a monitor for this project.</p>
        <button onclick="openCreateModal()"
            class="bg-blue hover:bg-blue/80 text-white px-8 py-3 rounded-2xl font-bold transition-all shadow-xl shadow-blue/20 active:scale-95">
            Create First Monitor
        </button>
    </div>
}
else
{
    <div class="grid grid-cols-1 gap-4">
        @foreach (var item in Model.Monitors)
        {
            var monitor = item.Monitor;
            var integrations = item.Integrations;
            var isNew = monitor.LastPingAt == null;
            var isLate = monitor.LastPingAt != null && monitor.NextExpectedAt.HasValue && DateTime.UtcNow > monitor.NextExpectedAt.Value;
            
            var statusColor = isNew ? "slate" :
                             (monitor.LastStatus == HealthyCron.Models.MonitorStatus.Paused ? "yellow" :
                             (monitor.LastStatus == HealthyCron.Models.MonitorStatus.Failed ? "red" :
                             (isLate ? "orange" : "green")));

            var statusLabel = isNew ? "New" :
                             (monitor.LastStatus == HealthyCron.Models.MonitorStatus.Paused ? "Paused" :
                             (monitor.LastStatus == HealthyCron.Models.MonitorStatus.Failed ? "Down" :
                             (isLate ? "Late" : "Healthy")));

            <div class="glass-card rounded-2xl p-0 hover:border-blue-500/30 transition-all group relative">
                <!-- Status Glow -->
                <div class="absolute -left-1 top-6 bottom-6 w-1 rounded-full bg-@statusColor-500 shadow-[0_0_15px_rgba(var(--status-rgb),0.4)]"
                     style="--status-rgb: @(statusColor == "green" ? "16,185,129" : (statusColor == "red" ? "244,63,94" : (statusColor == "yellow" ? "245,158,11" : (statusColor == "orange" ? "249,115,22" : "100,116,139"))))">
                </div>

                    <div class="p-4 sm:p-6 flex flex-col lg:flex-row lg:items-center justify-between gap-4 sm:gap-6 w-full">
                        <div class="flex items-start gap-3 sm:gap-5 flex-1 min-w-0 w-full">
                            <!-- Type Icon -->
                            <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-hc-black-light border border-white/5 flex items-center justify-center flex-shrink-0 shadow-inner group-hover:scale-105 transition-transform">
                                <i data-lucide="monitor" class="w-6 h-6 sm:w-7 sm:h-7 text-blue-500"></i>
                            </div>

                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
                                    <a href="/monitor/@monitor.Slug"
                                        class="text-lg sm:text-xl font-bold text-white hover:text-blue-500 transition-colors truncate block">
                                        @monitor.Name
                                    </a>
                                    <span class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full text-[9px] sm:text-[10px] uppercase font-black border tracking-wider
                                        @(statusColor == "green" ? "bg-green-500/10 text-green-400 border-green-500/20" :
                                          statusColor == "red" ? "bg-red-500/10 text-red-400 border-red-500/20" :
                                          statusColor == "yellow" ? "bg-yellow-500/10 text-yellow-500 border-yellow-500/20" :
                                          statusColor == "orange" ? "bg-orange-500/10 text-orange-500 border-orange-500/20" :
                                          "bg-slate-500/10 text-slate-400 border-slate-500/20")">
                                        @statusLabel
                                    </span>

                                    <!-- Integrations -->
                                    <div class="flex items-center gap-1 ml-auto lg:ml-0">
                                        @if (!integrations.Any()) {
                                            <span class="text-[8px] sm:text-[9px] font-black text-text-secondary/30 uppercase tracking-widest hidden sm:block">No Integrations</span>
                                        } else {
                                            @foreach(var integration in integrations.Take(3)) {
                                                <div class="w-5 h-5 sm:w-6 sm:h-6 rounded-md bg-hc-black-light border border-white/5 flex items-center justify-center overflow-hidden"
                                                     title="@integration.Integration.Name">
                                                    @switch(integration.Integration.Type)
                                                    {
                                                        case HealthyCron.Enums.IntegrationType.Slack:
                                                            <img src="/images/slack.png" class="w-3.5 h-3.5 sm:w-4 sm:h-4 object-contain" alt="Slack" />
                                                            break;
                                                        case HealthyCron.Enums.IntegrationType.PagerDuty:
                                                            <img src="/images/pagerduty.png" class="w-3.5 h-3.5 sm:w-4 sm:h-4 object-contain" alt="PagerDuty" />
                                                            break;
                                                        case HealthyCron.Enums.IntegrationType.Email:
                                                            <img src="/images/gmail.png" class="w-3.5 h-3.5 sm:w-4 sm:h-4 object-contain" alt="Email" />
                                                            break;
                                                        case HealthyCron.Enums.IntegrationType.Discord:
                                                            <img src="/images/discord.png" class="w-3.5 h-3.5 sm:w-4 sm:h-4 object-contain" alt="Discord" />
                                                            break;
                                                        case HealthyCron.Enums.IntegrationType.Teams:
                                                            <img src="/images/teams.png" class="w-3.5 h-3.5 sm:w-4 sm:h-4 object-contain" alt="Teams" />
                                                            break;
                                                        case HealthyCron.Enums.IntegrationType.WhatsApp:
                                                            <img src="/images/whatsapp.png" class="w-3.5 h-3.5 sm:w-4 sm:h-4 object-contain" alt="WhatsApp" />
                                                            break;
                                                        case HealthyCron.Enums.IntegrationType.Call:
                                                            <img src="/images/telephone.png" class="w-3.5 h-3.5 sm:w-4 sm:h-4 object-contain" alt="Call" />
                                                            break;
                                                        default:
                                                            <i data-lucide="bell" class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-text-secondary"></i>
                                                            break;
                                                    }
                                                </div>
                                            }
                                            @if (integrations.Count > 3) {
                                                <div class="w-5 h-5 sm:w-6 sm:h-6 rounded-md bg-white/5 border border-white/5 flex items-center justify-center text-[8px] sm:text-[9px] font-bold text-text-secondary cursor-help"
                                                    title="+@(integrations.Count - 3) more integrations">
                                                    +@(integrations.Count - 3)
                                                </div>
                                            }
                                        }
                                    </div>

                                </div>

                                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs sm:text-sm text-text-secondary mt-2">
                                    <!-- Ping URL -->
                                    <div class="flex items-center gap-2 bg-black/20 rounded-lg px-2 py-0.5 sm:px-2.5 sm:py-1 border border-white/5">
                                        <code class="text-[10px] sm:text-xs font-mono text-blue-500/80">/ping/@monitor.Id</code>
                                        <button onclick="copyPingUrl('@monitor.Id', this)"
                                            class="hover:text-white transition-colors">
                                            <i data-lucide="copy" class="w-3 sm:w-3.5 h-3 sm:h-3.5"></i>
                                        </button>
                                    </div>

                                    <!-- Schedule + Grace -->
                                    <div class="flex items-center gap-2 whitespace-nowrap">
                                        <i data-lucide="timer" class="w-3.5 h-3.5 sm:w-4 sm:h-4 opacity-50"></i>
                                        <span class="font-medium text-[11px] sm:text-sm">
                                            @if (monitor.ScheduleType == HealthyCron.Models.ScheduleType.Interval)
                                            {
                                                @:Every @(monitor.PeriodSeconds >= 60 ? (monitor.PeriodSeconds / 60) + "m" :
                                            monitor.PeriodSeconds + "s")
                                            }
                                            else
                                            {
                                                @:Cron: @monitor.CronExpression
                                            }
                                        </span>
                                        <span class="opacity-20">|</span>
                                        <span class="text-[10px] sm:text-xs">Grace: @((monitor.GraceSeconds ?? 0) / 60)m</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Side: Stats & Actions -->
                        <div class="flex items-center justify-between lg:justify-end gap-6 sm:gap-8 border-t lg:border-t-0 border-white/5 pt-3 sm:pt-4 lg:pt-0 w-full lg:w-auto mt-2 lg:mt-0">
                            <div class="flex flex-col items-start lg:items-end">
                                <p class="text-[9px] sm:text-[10px] uppercase tracking-widest text-text-secondary mb-0.5 sm:mb-1">Last Beat</p>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs sm:text-sm font-bold text-white">@(monitor.LastPingAt?.ToString("MMM dd, HH:mm") ?? "N/A")</span>
                                    @if (monitor.LastPingAt.HasValue)
                                    {
                                        <div class="w-1.5 h-1.5 rounded-full bg-@statusColor-500 animate-pulse"></div>
                                    }
                                </div>
                            </div>

                            <div class="flex items-center gap-2">
                                <a href="/monitor/@monitor.Slug"
                                    class="p-2.5 sm:p-3 bg-hc-black-light border border-white/5 rounded-xl hover:bg-blue-600 hover:text-white transition-all transform hover:scale-105 shadow-xl active:scale-95">
                                    <i data-lucide="arrow-right" class="w-4 h-4 sm:w-5 sm:h-5"></i>
                                </a>
                            </div>
                        </div>
                    </div>
            </div>
        }
    </div>
}

<script>
    function copyPingUrl(id, btn) {
        const url = `http://${window.location.host}/ping/${id}`;
        navigator.clipboard.writeText(url).then(() => {
            const icon = btn.querySelector('i');
            const originalIcon = icon.getAttribute('data-lucide');
            btn.innerHTML = '<i data-lucide="check" class="w-3.5 h-3.5 text-green-500"></i>';
            lucide.createIcons();
            setTimeout(() => {
                btn.innerHTML = `<i data-lucide="${originalIcon}" class="w-3.5 h-3.5"></i>`;
                lucide.createIcons();
            }, 2000);
        });
    }

    function openCreateModal() {
        document.getElementById('createMonitorModal').classList.remove('hidden');
    }
</script>

<!-- Create Monitor Modal -->
<div id="createMonitorModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen p-4">
        <!-- Overlay -->
        <div class="fixed inset-0 bg-black/80 transition-opacity"
            onclick="document.getElementById('createMonitorModal').classList.add('hidden')"></div>

        <!-- Modal Panel -->
        <div class="inline-block bg-hc-black-light rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:max-w-md w-full border border-border-color relative z-10">
            <div class="px-6 py-4 border-b border-border-color flex justify-between items-center bg-hc-black/50">
                <h3 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="plus-circle" class="text-blue-500"></i>
                    Add New Monitor
                </h3>
                <button type="button" onclick="document.getElementById('createMonitorModal').classList.add('hidden')"
                    class="text-text-secondary hover:text-white transition-colors">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>

            <form id="createMonitorForm">
                <div class="p-6 space-y-5">
                    <!-- Monitor Name -->
                    <div>
                        <label class="block text-xs font-black uppercase tracking-widest text-text-secondary mb-2">Monitor Name</label>
                        <input type="text" name="Name" id="monitor-name" required
                            class="w-full bg-hc-black border border-border-color rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-blue-500/50 outline-none transition-all"
                            placeholder="e.g. Daily Database Backup">
                    </div>

                    <!-- Slug -->
                    <div>
                        <label class="block text-xs font-black uppercase tracking-widest text-text-secondary mb-2">Slug</label>
                        <div class="relative">
                            <input type="text" name="Slug" id="monitor-slug"
                                class="w-full bg-hc-black border border-border-color rounded-xl px-4 py-3 pr-24 text-white focus:ring-2 focus:ring-blue-500/50 outline-none transition-all font-mono text-sm"
                                placeholder="daily-db-backup">
                            <button type="button" onclick="suggestSlug()"
                                class="absolute right-2 top-1.5 px-3 py-1.5 bg-white/5 border border-white/10 rounded-lg text-text-secondary hover:text-white text-[10px] font-black uppercase tracking-widest transition-all">
                                Suggest
                            </button>
                        </div>
                    </div>

                    <!-- Schedule Type -->
                    <div>
                        <label class="block text-xs font-black uppercase tracking-widest text-text-secondary mb-3">Check Schedule</label>
                        <div class="space-y-2">
                            <!-- Interval Option -->
                            <div class="relative">
                                <label class="flex items-center gap-3 p-4 bg-hc-black border border-border-color rounded-xl cursor-pointer hover:border-blue/30 transition-all group">
                                    <input type="radio" name="ScheduleType" value="0" checked onchange="updateScheduleConfigs()"
                                        class="w-4 h-4 border-white/10 bg-hc-black-light text-blue-500 focus:ring-blue-500/50">
                                    <div class="flex-1">
                                        <span class="block text-sm font-bold text-white">Interval</span>
                                        <span class="text-[10px] text-text-secondary uppercase font-black tracking-widest">Run every X minutes/hours</span>
                                    </div>
                                </label>
                                <div id="config-sch-0" class="mt-2 p-4 bg-black/20 rounded-xl border border-white/5 flex items-center gap-3">
                                    <input type="number" name="PeriodValue" value="1" min="1"
                                        class="w-20 bg-hc-black border border-border-color rounded-lg px-3 py-2 text-white text-center font-bold outline-none focus:border-blue/50">
                                    <select name="PeriodUnit"
                                        class="bg-hc-black border border-border-color rounded-lg px-3 py-2 text-white font-bold outline-none focus:border-blue/50">
                                        <option value="minutes">minutes</option>
                                        <option value="hours">hours</option>
                                        <option value="days">days</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Cron Option -->
                            <div class="relative">
                                <label class="flex items-center gap-3 p-4 bg-hc-black border border-border-color rounded-xl cursor-pointer hover:border-blue/30 transition-all group">
                                    <input type="radio" name="ScheduleType" value="1" onchange="updateScheduleConfigs()"
                                        class="w-4 h-4 border-white/10 bg-hc-black-light text-blue-500 focus:ring-blue-500/50">
                                    <div class="flex-1">
                                        <span class="block text-sm font-bold text-white">Cron Expression</span>
                                        <span class="text-[10px] text-text-secondary uppercase font-black tracking-widest">Advanced custom scheduling</span>
                                    </div>
                                </label>
                                <div id="config-sch-1" class="hidden mt-2 p-4 bg-black/20 rounded-xl border border-white/5">
                                    <input type="text" name="CronExpression" placeholder="0 0 * * *"
                                        class="w-full bg-hc-black border border-border-color rounded-lg px-4 py-3 text-white font-mono tracking-widest outline-none focus:border-blue/50">
                                    <p class="mt-2 text-[10px] text-text-secondary font-black uppercase tracking-widest flex items-center gap-1.5">
                                        <i data-lucide="info" class="w-3 h-3 text-blue-500"></i>
                                        minute hour day month day-of-week
                                    </p>
                                </div>
                            </div>

                            <!-- Calendar Option -->
                            <div class="relative opactiy-50">
                                <label class="flex items-center gap-3 p-4 bg-hc-black border border-border-color rounded-xl cursor-not-allowed transition-all opacity-50">
                                    <input type="radio" name="ScheduleType" value="2" disabled
                                        class="w-4 h-4 border-white/10 bg-hc-black-light text-blue-500 focus:ring-blue-500/50">
                                    <div class="flex-1">
                                        <span class="block text-sm font-bold text-white">OnCalendar</span>
                                        <span class="text-[10px] text-amber-500/80 uppercase font-black tracking-widest">Coming Soon</span>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Grace Period -->
                    <div class="pt-4 border-t border-white/5">
                        <label class="block text-xs font-black uppercase tracking-widest text-text-secondary mb-3">Grace Period</label>
                        <div class="flex items-center gap-3">
                            <input type="number" name="GraceSeconds" value="5" min="1"
                                class="w-20 bg-hc-black border border-border-color rounded-xl px-3 py-3 text-white text-center font-bold outline-none focus:ring-2 focus:ring-rose-500/50">
                            <select name="GraceUnit"
                                class="flex-1 bg-hc-black border border-border-color rounded-xl px-3 py-3 text-white font-bold outline-none focus:ring-2 focus:ring-rose-500/50">
                                <option value="minutes">minutes bonus</option>
                                <option value="hours">hours bonus</option>
                            </select>
                        </div>
                        <p class="mt-2 text-[10px] text-rose-400 font-bold uppercase tracking-wider leading-tight">
                            Extra time to wait before alerting if late.
                        </p>
                    </div>
                </div>

                <div class="bg-hc-black/50 px-6 py-4 flex flex-col gap-2 border-t border-border-color">
                    <button type="submit"
                        class="bg-blue hover:bg-blue/80 text-white w-full py-3.5 rounded-xl font-black transition-all shadow-lg shadow-blue/20 uppercase tracking-widest text-xs">
                        Create Monitor
                    </button>
                    <button type="button"
                        onclick="document.getElementById('createMonitorModal').classList.add('hidden')"
                        class="w-full py-3 rounded-xl border border-border-color text-text-secondary hover:text-white transition-all font-bold text-xs uppercase tracking-widest">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function suggestSlug() {
        const name = document.getElementById('monitor-name').value;
        if (!name) return;
        const slug = name.toLowerCase()
            .replace(/[^\w\s-]/g, '')
            .replace(/[\s_-]+/g, '-')
            .replace(/^-+|-+$/g, '');
        document.getElementById('monitor-slug').value = slug;
    }

    function updateScheduleConfigs() {
        const type = document.querySelector('input[name="ScheduleType"]:checked').value;
        document.getElementById('config-sch-0').classList.toggle('hidden', type !== '0');
        document.getElementById('config-sch-1').classList.toggle('hidden', type !== '1');
    }

    document.getElementById('createMonitorForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const form = e.target;
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        // Process Timing Conversion
        data.ScheduleType = parseInt(data.ScheduleType);
        
        // Interval Calculation
        let periodVal = parseInt(data.PeriodValue || 1);
        let periodUnit = data.PeriodUnit;
        if (periodUnit === 'minutes') data.PeriodSeconds = periodVal * 60;
        else if (periodUnit === 'hours') data.PeriodSeconds = periodVal * 3600;
        else if (periodUnit === 'days') data.PeriodSeconds = periodVal * 86400;

        // Grace Calculation - FIX: Convert to seconds properly
        let graceVal = parseInt(data.GraceSeconds || 0);
        let graceUnit = data.GraceUnit;
        if (graceUnit === 'minutes') data.GraceSeconds = graceVal * 60;
        else if (graceUnit === 'hours') data.GraceSeconds = graceVal * 3600;

        data.ProjectSlug = '@project.Slug';

        try {
            const response = await fetch('/monitor/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                const result = await response.json();
                window.location.href = result.redirectUrl || window.location.href;
            } else {
                const err = await response.text();
                alert('Error: ' + err);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('An unexpected error occurred');
        }
    });

</script>
