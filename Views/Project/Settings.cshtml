@{
    var project = (ViewBag.Project as HealthyCron.Models.Project)!;
    var user = (ViewBag.User as HealthyCron.Models.User)!;
    var keys = (ViewBag.AccessKeys as IEnumerable<HealthyCron.Models.ProjectAccessKey>) ?? Enumerable.Empty<HealthyCron.Models.ProjectAccessKey>();
    ViewData["Title"] = $"{(project != null ? project.Name : "Project")} - Settings";
    Layout = "_DashboardLayout";
}

<div class="max-w-4xl mx-auto pb-20">
    <!-- Breadcrumbs -->
    <div class="flex items-center gap-2 text-hc-muted text-sm mb-6 tracking-wider font-semibold">
        <a href="/dashboard" class="hover:text-blue-500 transition-colors flex items-center gap-1">
            <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
            Projects
        </a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <a href="/project/@project.Slug/monitors" class="hover:text-white transition-colors">@project.Name</a>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        <span class="text-white">Settings</span>
    </div>

    <div class="flex items-center justify-between mb-8">
        <h1 class="text-xl font-semibold text-white tracking-tight">Project Settings</h1>
    </div>

    <!-- General Settings -->
    <section class="glass-card rounded-2xl overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-white/5 bg-white/5 flex items-center gap-2">
            <i data-lucide="info" class="w-5 h-5 text-blue-500"></i>
            <h2 class="font-bold text-white">General Information</h2>
        </div>
        <form action="/project/@project.Slug/update" method="POST" class="p-6">
            <div class="grid grid-cols-1 gap-6">
                <div>
                    <label class="hc-label">Project Name</label>
                    <input type="text" name="name" value="@project.Name" required class="hc-input">
                </div>
            </div>
            <div class="pt-6 mt-6 border-t border-white/5 flex justify-end">
                <button type="submit" class="hc-btn-primary">
                    Save Changes
                </button>
            </div>
        </form>
    </section>

    <!-- API Keys Section -->
    <section class="glass-card rounded-2xl overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-white/5 bg-white/5 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i data-lucide="key" class="w-5 h-5 text-blue"></i>
                <h2 class="font-bold text-white">Project Access Keys</h2>
            </div>
        </div>
        <div class="p-0">
            <div class="overflow-x-auto -mx-6 sm:mx-0">
                <div class="inline-block min-w-full align-middle">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-[10px] uppercase font-black text-hc-muted border-b border-white/5 bg-white/[0.02]">
                                <th class="px-6 py-4">Type</th>
                                <th class="px-6 py-4">Status</th>
                                <th class="px-6 py-4">Prefix</th>
                                <th class="px-6 py-4">Created</th>
                                <th class="px-6 py-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            @{
                                var keyTypes = new[] { 
                                    new { Type = HealthyCron.Models.ApiKeyType.Ping, Label = "Ping Key", Desc = "Used for updating check status" },
                                    new { Type = HealthyCron.Models.ApiKeyType.FullAccess, Label = "Access Key", Desc = "Full access to project data" },
                                    new { Type = HealthyCron.Models.ApiKeyType.ReadAccess, Label = "Read-only Key", Desc = "View access to project data" }
                                };
                            }
                            @foreach (var kt in keyTypes)
                            {
                                var activeKey = keys.OrderByDescending(k => k.CreatedAt).FirstOrDefault(k => k.KeyType == kt.Type && !k.RevokedAt.HasValue);
                                <tr class="hover:bg-white/[0.01] transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="font-bold text-white text-sm sm:text-base whitespace-nowrap">@kt.Label</div>
                                        <div class="text-[10px] text-hc-muted">@kt.Desc</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (activeKey != null)
                                        {
                                            <span class="hc-badge hc-badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="hc-badge hc-badge-neutral">Not Generated</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (activeKey != null)
                                        {
                                            <div class="flex items-center gap-2">
                                                @if (kt.Type == HealthyCron.Models.ApiKeyType.Ping && !string.IsNullOrEmpty(activeKey.PlaintextKey))
                                                {
                                                    <code class="text-[11px] bg-black/30 px-2 py-1 rounded border border-white/5 text-blue-400 font-mono">@activeKey.PlaintextKey</code>
                                                    <button onclick="copyText('@activeKey.PlaintextKey')" class="p-1.5 hover:bg-white/5 rounded text-hc-muted hover:text-white transition-all" title="Copy Key">
                                                        <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <code class="text-[11px] bg-black/30 px-2 py-1 rounded border border-white/5 text-hc-muted font-mono">@activeKey.KeyPrefix...</code>
                                                    <button onclick="copyText('@activeKey.KeyPrefix')" class="p-1.5 hover:bg-white/5 rounded text-hc-muted hover:text-white transition-all" title="Copy Prefix">
                                                        <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-hc-muted">---</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-[11px] text-hc-muted whitespace-nowrap">
                                        @(activeKey?.CreatedAt.ToString("MMM dd, yyyy") ?? "---")
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        @if (activeKey != null)
                                        {
                                            <button onclick="confirmRevoke('@activeKey.Id')" class="text-rose-500 hover:text-rose-400 p-2 hover:bg-rose-500/10 rounded-lg transition-all" title="Revoke Key">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button onclick="confirmGenerate(@((int)kt.Type), '@kt.Label')" class="text-blue hover:opacity-80 p-2 hover:bg-blue/10 rounded-lg transition-all" title="Generate Key">
                                                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="px-6 py-4 bg-hc-black/50 border-t border-white/5 flex items-center gap-2">
            <i data-lucide="book-open" class="w-4 h-4 text-hc-muted"></i>
            <p class="text-xs text-hc-muted">
                Learn how to use API keys in our <a href="/docs/api" class="text-blue hover:underline">documentation</a>.
            </p>
        </div>
    </section>

    <!-- Team Management -->
    @{
        var members = (ViewBag.Members as List<HealthyCron.Models.ProjectMember>) ?? new List<HealthyCron.Models.ProjectMember>();
        var invitations = (ViewBag.Invitations as List<HealthyCron.Models.ProjectInvitation>) ?? new List<HealthyCron.Models.ProjectInvitation>();
        var isOwner = (bool)(ViewBag.IsOwner ?? false);
    }
    <section class="glass-card rounded-2xl overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-white/5 bg-white/5 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i data-lucide="users" class="w-5 h-5 text-blue-500"></i>
                <h2 class="font-bold text-white">Team Members</h2>
            </div>
            <button onclick="openInviteModal()" class="bg-blue hover:bg-blue/80 text-white px-4 py-2 rounded-xl font-bold text-xs transition-all shadow-lg shadow-blue/20 flex items-center gap-1.5">
                <i data-lucide="user-plus" class="w-3.5 h-3.5"></i>
                Invite
            </button>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="mx-6 mt-4 bg-emerald-500/10 border border-emerald-500/20 rounded-xl px-4 py-2.5 flex items-center gap-2 text-hc-green text-sm">
                <i data-lucide="check-circle" class="w-4 h-4 shrink-0"></i>
                @TempData["Success"]
            </div>
        }

        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="text-[10px] uppercase font-black text-hc-muted border-b border-white/5 bg-white/[0.02]">
                        <th class="px-6 py-3">Member</th>
                        <th class="px-6 py-3">Role</th>
                        <th class="px-6 py-3">Joined</th>
                        @if (isOwner) { <th class="px-6 py-3 text-right">Actions</th> }
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    <!-- Owner row -->
                    <tr class="hover:bg-white/[0.01] transition-colors">
                        <td class="px-6 py-3">
                            <div class="flex items-center gap-3">
                                <div class="w-7 h-7 rounded-full bg-hc-amber/20 flex items-center justify-center text-hc-amber font-bold text-xs">@(user.Email.Substring(0, 1).ToUpper())</div>
                                <div>
                                    <div class="text-white font-medium text-sm">@user.Email</div>
                                    <div class="text-hc-muted text-[10px]">You</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-3"><span class="px-2 py-0.5 bg-hc-amber/10 text-hc-amber text-[10px] rounded uppercase font-bold">Owner</span></td>
                        <td class="px-6 py-3 text-hc-muted text-xs">—</td>
                        @if (isOwner) { <td class="px-6 py-3"></td> }
                    </tr>
                    @foreach (var member in members)
                    {
                        var (badgeClass, label) = member.Role switch {
                            HealthyCron.Enums.ProjectRole.Manager  => ("bg-blue-500/10 text-blue-400", "Manager"),
                            HealthyCron.Enums.ProjectRole.ReadOnly => ("bg-slate-500/10 text-slate-400", "Read Only"),
                            _                                      => ("bg-emerald-500/10 text-hc-green", "Team Member")
                        };
                        <tr class="hover:bg-white/[0.01] transition-colors">
                            <td class="px-6 py-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-7 h-7 rounded-full bg-white/5 flex items-center justify-center text-hc-muted font-bold text-xs">@(member.UserEmail?.Substring(0, 1).ToUpper())</div>
                                    <span class="text-hc-muted text-sm">@member.UserEmail</span>
                                </div>
                            </td>
                            <td class="px-6 py-3"><span class="px-2 py-0.5 @badgeClass text-[10px] rounded uppercase font-bold">@label</span></td>
                            <td class="px-6 py-3 text-hc-muted text-xs">@member.JoinedAt.ToString("MMM dd, yyyy")</td>
                            @if (isOwner)
                            {
                                <td class="px-6 py-3 text-right">
                                    <form action="/project/@project.Slug/team/members/@member.UserId/remove" method="POST" onsubmit="return confirm('Remove @member.UserEmail from this project?')">
                                        <button type="submit" class="text-rose-500 hover:text-rose-400 p-1.5 hover:bg-rose-500/10 rounded-lg transition-all" title="Remove member">
                                            <i data-lucide="user-minus" class="w-4 h-4"></i>
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                    @if (!members.Any())
                    {
                        <tr><td colspan="4" class="px-6 py-6 text-center text-hc-muted text-sm">No members yet. Invite someone to get started.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (invitations.Any())
        {
            <div class="border-t border-white/5 px-6 py-3 flex items-center gap-2">
                <i data-lucide="mail" class="w-4 h-4 text-hc-amber"></i>
                <span class="text-xs font-bold text-hc-muted uppercase tracking-widest">Pending Invitations</span>
            </div>
            <table class="w-full text-left">
                <tbody class="divide-y divide-white/5">
                    @foreach (var inv in invitations)
                    {
                        var (badgeClass, label) = inv.Role switch {
                            HealthyCron.Enums.ProjectRole.Manager  => ("bg-blue-500/10 text-blue-400", "Manager"),
                            HealthyCron.Enums.ProjectRole.ReadOnly => ("bg-slate-500/10 text-slate-400", "Read Only"),
                            _                                      => ("bg-emerald-500/10 text-hc-green", "Team Member")
                        };
                        <tr class="hover:bg-white/[0.01] transition-colors">
                            <td class="px-6 py-3 text-hc-muted text-sm w-1/2">
                                <div class="flex items-center gap-2">
                                    <i data-lucide="clock" class="w-3.5 h-3.5 text-hc-amber/70"></i>
                                    @inv.Email
                                </div>
                            </td>
                            <td class="px-6 py-3"><span class="px-2 py-0.5 @badgeClass text-[10px] rounded uppercase font-bold">@label</span></td>
                            <td class="px-6 py-3 text-hc-muted text-xs">Expires @inv.ExpiresAt.ToString("MMM dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <!-- Danger Zone -->

    <section class="border border-rose-500/20 rounded-2xl overflow-hidden bg-rose-500/5">
        <div class="px-6 py-4 border-b border-rose-500/10 bg-rose-500/10 flex items-center gap-2 text-rose-500">
            <i data-lucide="alert-triangle" class="w-5 h-5"></i>
            <h2 class="font-bold">Danger Zone</h2>
        </div>
        <div class="p-6 space-y-6">
            <!-- Transfer -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h3 class="font-bold text-white mb-1">Transfer Project</h3>
                    <p class="text-sm text-hc-muted">Transfer this project to another user's email address.</p>
                </div>
                <button onclick="openTransferModal()" class="px-6 py-2.5 bg-hc-black-light hover:bg-white/5 text-white rounded-xl font-bold transition-all text-sm">
                    Transfer
                </button>
            </div>
            
            <div class="h-px bg-rose-500/10"></div>

            <!-- Delete -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h3 class="font-bold text-rose-500 mb-1">Delete Project</h3>
                    <p class="text-sm text-hc-muted">Permanently delete this project and all its monitors, pings, and data.</p>
                </div>
                                <form id="deleteProjectForm" action="/project/@project.Slug/delete" method="POST">
                                    <button type="button" onclick="confirmDeleteProject()" class="px-6 py-2.5 bg-rose-500/10 hover:bg-rose-500 hover:text-white text-rose-500 rounded-xl font-bold transition-all text-sm">
                                        Delete Project
                                    </button>
                                </form>
            </div>
        </div>
    </section>
</div>

<!-- Key Result Modal -->
<div id="keyResultModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="fixed inset-0 bg-black/80 transition-opacity" onclick="closeKeyResultModal()"></div>
        <div class="inline-block bg-hc-black-light rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:max-w-lg w-full border border-hc-border relative z-10">
            <div class="px-6 py-4 border-b border-hc-border flex justify-between items-center bg-hc-black/50">
                <h3 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="key" class="text-blue"></i>
                    API Key Generated
                </h3>
                <button onclick="closeKeyResultModal()" class="text-hc-muted hover:text-white transition-colors">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>
            <div class="p-6">
                <div class="space-y-6">
                    <div class="bg-emerald-500/10 border border-emerald-500/20 p-4 rounded-xl flex items-start gap-3">
                        <i data-lucide="check-circle" class="w-5 h-5 text-emerald-500 shrink-0"></i>
                        <div>
                            <h4 class="text-emerald-500 font-bold text-sm" id="keyResultTitle">Key Generated Successfully</h4>
                            <p class="text-xs text-emerald-500/70">Copy this key now. For security reasons, we cannot show it to you again.</p>
                        </div>
                    </div>
                    <div class="relative group">
                        <input type="text" id="fullKeyDisplay" readonly
                            class="w-full bg-black/50 border border-white/10 rounded-xl px-4 py-4 pr-12 text-white font-mono text-sm outline-none">
                        <button onclick="copyGeneratedKey()" class="absolute right-3 top-1/2 -translate-y-1/2 p-2 hover:bg-white/10 rounded-lg text-hc-muted hover:text-white transition-all">
                            <i data-lucide="copy" class="w-5 h-5"></i>
                        </button>
                    </div>
                    <button onclick="window.location.reload()" class="w-full bg-white/5 hover:bg-white/10 text-white py-3 rounded-xl font-bold transition-all border border-white/10">
                        I've copied it, close.
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Global Toast Notification -->
<div id="toast" class="fixed bottom-8 right-8 z-[100] transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <div class="bg-hc-black-light border border-white/10 rounded-2xl p-4 shadow-2xl flex items-center gap-3 min-w-[300px]">
        <div id="toastIcon" class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"></div>
        <div class="overflow-hidden">
            <div id="toastTitle" class="font-bold text-white text-sm"></div>
            <div id="toastMessage" class="text-xs text-hc-muted truncate"></div>
        </div>
    </div>
</div>

<!-- Custom Confirmation Modal -->
<div id="confirmModal" class="fixed inset-0 z-[60] hidden overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="fixed inset-0 bg-black/80 transition-opacity" onclick="closeConfirmModal()"></div>
        <div class="inline-block bg-hc-black-light rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:max-w-md w-full border border-hc-border relative z-10">
            <div class="p-6">
                <div class="flex items-center gap-4 mb-6">
                    <div id="confirmIconBg" class="w-12 h-12 rounded-2xl flex items-center justify-center shrink-0">
                        <i id="confirmIcon" data-lucide="help-circle" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h3 id="confirmTitle" class="text-xl font-black text-white">Confirm Action</h3>
                        <p id="confirmDescription" class="text-sm text-hc-muted mt-1">Are you sure you want to proceed?</p>
                    </div>
                </div>
                <div class="flex gap-3">
                    <button onclick="closeConfirmModal()" class="flex-1 bg-white/5 hover:bg-white/10 text-white py-3 rounded-xl font-bold transition-all border border-white/10">
                        Cancel
                    </button>
                    <button id="confirmActionBtn" class="flex-1 py-3 rounded-xl font-bold transition-all shadow-lg">
                        Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Invite Member Modal -->
<div id="inviteModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="fixed inset-0 bg-black/80 transition-opacity" onclick="closeInviteModal()"></div>
        <div class="inline-block bg-hc-black-light rounded-2xl text-left overflow-hidden shadow-2xl sm:max-w-md w-full border border-hc-border relative z-10">
            <div class="px-6 py-4 border-b border-hc-border flex justify-between items-center bg-hc-black/50">
                <h3 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-lucide="user-plus" class="text-blue w-5 h-5"></i>
                    Invite Team Member
                </h3>
                <button onclick="closeInviteModal()" class="text-hc-muted hover:text-white transition-colors">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>
            <form action="/project/@project.Slug/team/invite" method="POST" class="p-6 space-y-5">
                <div>
                    <label class="block text-xs font-black uppercase tracking-widest text-hc-muted mb-2">Email Address</label>
                    <input type="email" name="email" required placeholder="colleague@example.com"
                        class="w-full bg-hc-black border border-white/5 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-blue/50 outline-none transition-all placeholder-hc-muted/50">
                </div>
                <div>
                    <label class="block text-xs font-black uppercase tracking-widest text-hc-muted mb-2">Role</label>
                    <select name="role" class="w-full bg-hc-black border border-white/5 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-blue/50 outline-none transition-all">
                        <option value="0">Team Member — create/edit/delete monitors &amp; integrations</option>
                        <option value="1">Manager — all of Team Member + invite/remove members</option>
                        <option value="2">Read Only — view monitors and logs only</option>
                    </select>
                </div>
                <div class="bg-blue/5 border border-blue/10 rounded-xl p-3 text-xs text-hc-muted">
                    <i data-lucide="info" class="w-3.5 h-3.5 inline-block mr-1 text-blue-400"></i>
                    An invitation email will be sent. The link expires in 7 days.
                </div>
                <div class="pt-2 flex gap-3">
                    <button type="button" onclick="closeInviteModal()" class="flex-1 bg-white/5 hover:bg-white/10 text-white py-3 rounded-xl font-bold transition-all border border-white/10">
                        Cancel
                    </button>
                    <button type="submit" class="flex-1 bg-blue hover:bg-blue/80 text-white py-3 rounded-xl font-bold transition-all shadow-lg shadow-blue/20">
                        Send Invite
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openInviteModal() { document.getElementById('inviteModal').classList.remove('hidden'); lucide.createIcons(); }
    function closeInviteModal() { document.getElementById('inviteModal').classList.add('hidden'); }

    let activeKeyType = null;

    let activeKeyLabel = '';
    let activeKeyId = null;

    function showToast(title, message, type = 'success') {
        const toast = document.getElementById('toast');
        const icon = document.getElementById('toastIcon');
        const titleEl = document.getElementById('toastTitle');
        const messageEl = document.getElementById('toastMessage');

        titleEl.innerText = title;
        messageEl.innerText = message;

        if (type === 'success') {
            icon.className = 'w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-emerald-500/10 text-emerald-500';
            icon.innerHTML = '<i data-lucide="check-circle" class="w-5 h-5"></i>';
        } else {
            icon.className = 'w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-rose-500/10 text-rose-500';
            icon.innerHTML = '<i data-lucide="alert-circle" class="w-5 h-5"></i>';
        }

        lucide.createIcons();
        
        toast.classList.remove('translate-y-20', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
            toast.classList.add('translate-y-20', 'opacity-0');
            toast.classList.remove('translate-y-0', 'opacity-100');
        }, 5000);
    }

    function closeConfirmModal() {
        document.getElementById('confirmModal').classList.add('hidden');
    }

    function confirmGenerate(type, label) {
        activeKeyType = type;
        activeKeyLabel = label;
        
        document.getElementById('confirmTitle').innerText = 'Generate ' + label;
        document.getElementById('confirmDescription').innerText = 'Are you sure? Any existing active ' + label + ' will be revoked immediately.';
        document.getElementById('confirmIcon').setAttribute('data-lucide', 'key');
        document.getElementById('confirmIconBg').className = 'w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 bg-blue/10 text-blue';
        
        const btn = document.getElementById('confirmActionBtn');
        btn.className = 'flex-1 bg-blue hover:bg-blue/80 text-white py-3 rounded-xl font-bold transition-all shadow-lg shadow-blue/20';
        btn.onclick = performGenerate;
        
        document.getElementById('confirmModal').classList.remove('hidden');
        lucide.createIcons();
    }

    function confirmRevoke(keyId) {
        activeKeyId = keyId;
        
        document.getElementById('confirmTitle').innerText = 'Revoke API Key';
        document.getElementById('confirmDescription').innerText = 'This will permanently disable this key. Any applications using it will lose access immediately.';
        document.getElementById('confirmIcon').setAttribute('data-lucide', 'trash-2');
        document.getElementById('confirmIconBg').className = 'w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 bg-rose-500/10 text-rose-500';
        
        const btn = document.getElementById('confirmActionBtn');
        btn.className = 'flex-1 bg-rose-600 hover:bg-rose-500 text-white py-3 rounded-xl font-bold transition-all shadow-lg shadow-rose-500/20';
        btn.onclick = performRevoke;
        
        document.getElementById('confirmModal').classList.remove('hidden');
        lucide.createIcons();
    }

    function confirmDeleteProject() {
        document.getElementById('confirmTitle').innerText = 'Delete Project';
        document.getElementById('confirmDescription').innerText = 'Are you absolutely sure? This will hide the project and all its monitors. This action is permanent.';
        document.getElementById('confirmIcon').setAttribute('data-lucide', 'alert-triangle');
        document.getElementById('confirmIconBg').className = 'w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 bg-rose-500/10 text-rose-500';
        
        const btn = document.getElementById('confirmActionBtn');
        btn.className = 'flex-1 bg-rose-600 hover:bg-rose-500 text-white py-3 rounded-xl font-bold transition-all shadow-lg shadow-rose-500/20';
        btn.onclick = () => document.getElementById('deleteProjectForm').submit();
        
        document.getElementById('confirmModal').classList.remove('hidden');
        lucide.createIcons();
    }

    async function performGenerate() {
        closeConfirmModal();
        const formData = new FormData();
        formData.append('type', activeKeyType);

        try {
            const response = await fetch('/projects/@project.Id/access-keys', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const result = await response.json();
                openKeyResultModal(result.key, activeKeyLabel);
            } else {
                showToast('Error', 'Failed to generate key', 'error');
            }
        } catch (error) {
            showToast('Error', 'An unexpected error occurred', 'error');
        }
    }

    async function performRevoke() {
        closeConfirmModal();
        try {
            const response = await fetch(`/projects/@project.Id/access-keys/${activeKeyId}/revoke`, {
                method: 'POST'
            });

            if (response.ok) {
                showToast('Key Revoked', 'The API key has been disabled');
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showToast('Error', 'Failed to revoke key', 'error');
            }
        } catch (error) {
            showToast('Error', 'An unexpected error occurred', 'error');
        }
    }

    function copyText(text) {
        navigator.clipboard.writeText(text).then(() => {
            showToast('Copied', 'Copied to clipboard');
        });
    }

    function openKeyResultModal(key, label) {
        document.getElementById('keyResultModal').classList.remove('hidden');
        document.getElementById('fullKeyDisplay').value = key;
        document.getElementById('keyResultTitle').innerText = label + ' Generated Successfully';
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function closeKeyResultModal() {
        document.getElementById('keyResultModal').classList.add('hidden');
    }

    function copyGeneratedKey() {
        const key = document.getElementById('fullKeyDisplay').value;
        copyText(key);
    }

    function openTransferModal() {
        showToast('Info', 'Transfer functionality coming soon!');
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>
