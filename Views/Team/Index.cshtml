@{
    ViewData["Title"] = "Teams";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="space-y-6 animate-fade-in">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Team Members</h1>
            <p class="text-text-secondary mt-1">Manage your team access and permissions</p>
        </div>
        <button class="flex items-center gap-2 bg-blue hover:bg-blue-600 text-white px-4 py-2 rounded-xl font-medium transition-all active:scale-95 shadow-lg shadow-blue/20">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Add Team Member</span>
        </button>
    </div>

    <!-- Team List (Placeholder) -->
    <div class="glass-card rounded-2xl overflow-hidden bg-navy/10 border border-white/5">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="text-[10px] uppercase font-bold text-text-secondary border-b border-white/5 bg-navy/20">
                        <th class="px-6 py-4">User</th>
                        <th class="px-6 py-4">Role</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    <!-- Current User -->
                    <tr class="group hover:bg-white/[0.02] transition-colors">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue to-purple flex items-center justify-center text-xs font-bold text-white">
                                    ME
                                </div>
                                <div>
                                    <div class="text-sm font-medium text-white">@ViewBag.UserEmail</div>
                                    <div class="text-xs text-text-secondary">@ViewBag.UserEmail</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2 py-1 rounded bg-blue/10 text-blue text-xs font-medium border border-blue/20">
                                Owner
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <span class="flex items-center gap-1.5 text-xs text-emerald-500">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                Active
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <button class="text-text-secondary hover:text-white transition-colors" disabled>
                                <i data-lucide="more-horizontal" class="w-4 h-4"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <!-- Empty State Message -->
        <div class="p-8 text-center border-t border-white/5 bg-navy/20">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/5 text-text-secondary mb-3">
                <i data-lucide="users" class="w-5 h-5"></i>
            </div>
            <h3 class="text-sm font-medium text-white">Invite your team</h3>
            <p class="text-xs text-text-secondary mt-1 max-w-sm mx-auto">
                Collaborate with your team members by inviting them to this project.
            </p>
        </div>
    </div>
</div>
