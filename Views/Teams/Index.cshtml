@{
    var members = (ViewBag.Members as List<HealthyCron.Models.ProjectMember>) ?? new();
    ViewData["Title"] = "Teams";
    Layout = "_DashboardLayout";

    // Group by project
    var byProject = members
        .GroupBy(m => new { m.ProjectSlug, m.ProjectName })
        .OrderBy(g => g.Key.ProjectName)
        .ToList();
}

<div class="max-w-4xl mx-auto pb-20">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-bold text-white flex items-center gap-3">
            <i data-lucide="users" class="text-blue"></i>
            Teams
        </h1>
    </div>

    @if (!byProject.Any())
    {
        <div class="glass-card rounded-2xl p-12 text-center">
            <i data-lucide="users" class="w-12 h-12 text-hc-muted mx-auto mb-4"></i>
            <h2 class="text-white font-bold text-lg mb-2">No team members yet</h2>
            <p class="text-hc-muted text-sm mb-6">Go into any project's Settings to invite collaborators.</p>
            <a href="/dashboard/projects" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white text-black font-bold text-sm hover:bg-white/90 transition-all">
                View Projects
            </a>
        </div>
    }
    else
    {
        @foreach (var group in byProject)
        {
            <section class="glass-card rounded-2xl overflow-hidden mb-6">
                <!-- Project header -->
                <div class="px-6 py-4 border-b border-white/5 bg-white/5 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center">
                            <i data-lucide="folder" class="w-4 h-4 text-white/50"></i>
                        </div>
                        <div>
                            <h2 class="font-bold text-white">@group.Key.ProjectName</h2>
                            <p class="text-[10px] text-hc-muted">@group.Count() member@(group.Count() == 1 ? "" : "s")</p>
                        </div>
                    </div>
                    <a href="/project/@group.Key.ProjectSlug/settings" class="text-xs text-white/50 hover:text-white transition-colors flex items-center gap-1">
                        <i data-lucide="settings" class="w-3 h-3"></i>
                        Manage
                    </a>
                </div>

                <div class="w-full overflow-auto">
                    <table class="w-full caption-bottom text-sm text-left">
                        <thead class="[&_tr]:border-b border-white/5 bg-hc-black/10">
                            <tr class="border-b border-white/5 transition-colors hover:bg-white/[0.02]">
                                <th class="h-10 px-4 pl-6 align-middle font-medium text-hc-muted uppercase text-[10px] tracking-widest">Member</th>
                                <th class="h-10 px-4 align-middle font-medium text-hc-muted uppercase text-[10px] tracking-widest">Role</th>
                                <th class="h-10 px-4 align-middle font-medium text-hc-muted uppercase text-[10px] tracking-widest">Joined</th>
                            </tr>
                        </thead>
                        <tbody class="[&_tr:last-child]:border-0 divide-y divide-white/5">
                            @foreach (var member in group.OrderBy(m => m.JoinedAt))
                            {
                                var (badgeCls, roleLabel) = member.Role switch {
                                    HealthyCron.Enums.ProjectRole.Manager  => ("bg-white/10 text-white border border-white/20", "Manager"),
                                    HealthyCron.Enums.ProjectRole.ReadOnly => ("bg-white/5 text-white/40 border border-white/10", "Read Only"),
                                    _                                      => ("bg-white/5 text-white/60 border border-white/10", "Member")
                                };
                                <tr class="border-b border-white/5 transition-colors hover:bg-white/[0.02] group">
                                    <td class="p-4 pl-6 align-middle">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-hc-muted font-bold text-xs shrink-0">
                                                @(member.UserEmail?.Substring(0,1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="text-white text-sm font-medium">@member.UserEmail</div>
                                                <div class="text-hc-muted text-[10px] font-mono">@member.UserId.ToString().Substring(0,8)…</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="p-4 align-middle">
                                        <span class="px-2.5 py-1 @badgeCls text-[9px] rounded-md uppercase font-black tracking-widest">@roleLabel</span>
                                    </td>
                                    <td class="p-4 align-middle text-hc-muted text-xs">
                                        @member.JoinedAt.ToString("MMM dd, yyyy")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => { if (typeof lucide !== 'undefined') lucide.createIcons(); });
</script>
