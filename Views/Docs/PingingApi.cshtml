@{
    Layout = "_DocsLayout";
    ViewData["Title"] = "Pinging API - HealthyCron Documentation";
}

<div class="space-y-12">
    <header>
        <h1 class="text-4xl font-black text-white mb-6">Pinging API</h1>
        <p class="text-lg text-text-secondary leading-relaxed">
            Each monitor in HealthyCron has a unique Ping URL. Your jobs and scripts send HTTP requests to this URL to signal their status.
        </p>
    </header>

    <section class="space-y-6">
        <h2 class="text-2xl font-black text-white">Ping URL Formats</h2>
        <p class="text-text-secondary leading-relaxed">
            HealthyCron supports two flexible formats for identifying which monitor you are pinging.
        </p>

        <div class="space-y-6">
            <div class="bg-navy-light border border-white/5 rounded-2xl p-6">
                <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
                    <i data-lucide="fingerprint" class="w-5 h-5 text-blue"></i>
                    Unique ID Format
                </h3>
                <code class="text-blue text-sm block bg-black/30 p-4 rounded-xl border border-white/5 break-all font-mono">
                    https://healthycron.com/ping/&lt;uuid&gt;
                </code>
                <p class="text-text-secondary text-sm mt-4 leading-relaxed">
                    The simplest way to ping. Every monitor is assigned a unique UUID upon creation. This ID never changes, even if you rename the monitor or move it between projects.
                </p>
            </div>

            <div class="bg-navy-light border border-white/5 rounded-2xl p-6">
                <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
                    <i data-lucide="layout-template" class="w-5 h-5 text-blue"></i>
                    Slug Format (SEO Friendly)
                </h3>
                <code class="text-blue text-sm block bg-black/30 p-4 rounded-xl border border-white/5 break-all font-mono">
                    https://healthycron.com/ping/&lt;project-ping-key&gt;/&lt;name-slug&gt;
                </li>
                <p class="text-text-secondary text-sm mt-4 leading-relaxed">
                    Identify monitors by a project-wide <strong>Ping Key</strong> and a user-defined <strong>Slug</strong> (e.g., <code>daily-backup</code>). This format is ideal for version-controlled scripts where you want to keep the URL readable.
                </p>
            </div>
        </div>
    </section>

    <section class="space-y-6">
        <h2 class="text-2xl font-black text-white">Signaling Success, Start, and Failure</h2>
        <p class="text-text-secondary leading-relaxed">
            You can append status suffixes to your Ping URL to provide more context about the job's execution.
        </p>

        <div class="grid grid-cols-1 gap-4">
            <div class="glass-card border border-white/5 p-6 rounded-2xl">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-bold text-white">Success (Check-in)</h3>
                    <span class="px-2 py-1 rounded bg-emerald-500/10 text-emerald-500 text-[10px] uppercase font-black font-mono">Default</span>
                </div>
                <p class="text-sm text-text-secondary mb-4 leading-relaxed">
                    The primary signal. It tells HealthyCron the job finished successfully and resets the "Late" timer.
                </p>
                <code class="text-blue-200 text-xs bg-black/20 p-2 rounded block font-mono">https://healthycron.com/ping/&lt;id&gt;</code>
            </div>

            <div class="glass-card border border-white/5 p-6 rounded-2xl">
                <h3 class="text-lg font-bold text-white mb-2">Job Start</h3>
                <p class="text-sm text-text-secondary mb-4 leading-relaxed">
                    Send this at the beginning of your script. HealthyCron uses this to measure execution time and can alert you if a job gets stuck (starts but never succeeds within Grace Time).
                </p>
                <code class="text-blue-200 text-xs bg-black/20 p-2 rounded block font-mono">https://healthycron.com/ping/&lt;id&gt;/start</code>
            </div>

            <div class="glass-card border border-white/5 p-6 rounded-2xl">
                <h3 class="text-lg font-bold text-white mb-2">Signaling Failure</h3>
                <p class="text-sm text-text-secondary mb-4 leading-relaxed">
                    If your script catches an error, send a <code>/fail</code> ping to trigger immediate notifications, even if the scheduled time hasn't passed yet.
                </p>
                <code class="text-blue-200 text-xs bg-black/20 p-2 rounded block font-mono">https://healthycron.com/ping/&lt;id&gt;/fail</code>
            </div>

            <div class="glass-card border border-white/5 p-6 rounded-2xl">
                <h3 class="text-lg font-bold text-white mb-2">Exit Codes</h3>
                <p class="text-sm text-text-secondary mb-4 leading-relaxed">
                    You can append an integer exit code. Any non-zero code is treated as a failure.
                </p>
                <code class="text-blue-200 text-xs bg-black/20 p-2 rounded block font-mono">https://healthycron.com/ping/&lt;id&gt;/1</code>
            </div>
        </div>
    </section>

    <section class="space-y-4 bg-navy-light border border-white/10 rounded-2xl p-8">
        <h2 class="text-2xl font-black text-white mb-2">Technical Details</h2>
        <div class="space-y-4">
            <div class="flex gap-4">
                <div class="w-10 h-10 rounded-xl bg-blue/10 flex items-center justify-center shrink-0">
                    <i data-lucide="globe" class="w-5 h-5 text-blue"></i>
                </div>
                <div>
                    <h4 class="text-white font-bold mb-1">HTTP Methods</h4>
                    <p class="text-sm text-text-secondary leading-relaxed">
                        HealthyCron accepts <code>GET</code>, <code>POST</code>, <code>PUT</code>, and <code>HEAD</code> requests. Use whichever is most convenient for your environment.
                    </p>
                </div>
            </div>
            
            <div class="flex gap-4 pt-4 border-t border-white/5">
                <div class="w-10 h-10 rounded-xl bg-blue/10 flex items-center justify-center shrink-0">
                    <i data-lucide="file-json" class="w-5 h-5 text-blue"></i>
                </div>
                <div>
                    <h4 class="text-white font-bold mb-1">Capturing Logs</h4>
                    <p class="text-sm text-text-secondary leading-relaxed">
                        If you use <code>POST</code>, HealthyCron will capture the request body (up to 10KB) and store it in your ping logs. This is perfect for capturing stack traces or error messages from failed jobs.
                    </p>
                </div>
            </div>
        </div>
    </section>
</div>
