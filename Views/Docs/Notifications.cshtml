<h2 class="text-base font-medium text-white mb-4 mt-8">Webhook Payload Example</h2>
<p class="text-sm font-normal text-[#8A8A93] leading-relaxed mb-6">
    Webhooks receive a standard JSON payload that you can parse on your servers to trigger custom automation.
</p>

<div class="code-container bg-[#111114] border border-white/6 rounded-xl overflow-hidden mb-12">
    <div class="flex items-center justify-between px-4 py-2.5 border-b border-white/6">
        <span class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52]">JSON PAYLOAD</span>
        <button onclick="copyCode(this)" class="text-[#4A4A52] hover:text-white transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
        </button>
    </div>
    <div class="p-5 overflow-x-auto">
<pre><code class="font-mono text-sm text-[#F2F2F2]">{
  <span class="text-[#60A5FA]">"event"</span>: <span class="text-[#22C55E]">"monitor_failed"</span>,
  <span class="text-[#60A5FA]">"monitor"</span>: {
    <span class="text-[#60A5FA]">"id"</span>: <span class="text-[#22C55E]">"m_123456789"</span>,
    <span class="text-[#60A5FA]">"name"</span>: <span class="text-[#22C55E]">"Nightly Database Backup"</span>,
    <span class="text-[#60A5FA]">"slug"</span>: <span class="text-[#22C55E]">"nightly-database-backup"</span>,
    <span class="text-[#60A5FA]">"project"</span>: <span class="text-[#22C55E]">"Production"</span>
  },
  <span class="text-[#60A5FA]">"details"</span>: {
    <span class="text-[#60A5FA]">"last_ping_at"</span>: <span class="text-[#22C55E]">"2026-03-05T08:00:00Z"</span>,
    <span class="text-[#60A5FA]">"expected_at"</span>: <span class="text-[#22C55E]">"2026-03-06T08:00:00Z"</span>,
    <span class="text-[#60A5FA]">"grace_period_mins"</span>: <span class="text-amber-500">10</span>,
    <span class="text-[#60A5FA]">"time_late_seconds"</span>: <span class="text-amber-500">845</span>
  }
}</code></pre>
    </div>
</div>
