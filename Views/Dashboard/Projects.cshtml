@model IEnumerable<HealthyCron.Models.Project>
@{
    ViewData["Title"] = "My Projects";
    Layout = "_DashboardLayout";
}

<!-- Page Header -->
<!-- Page Header -->
<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="text-3xl font-bold text-white mb-2">My Projects</h1>
        <p class="text-hc-muted">Organize and manage your monitoring tasks.</p>
    </div>
    <button onclick="document.getElementById('createProjectModal').classList.remove('hidden')"
        class="hc-btn-primary px-5 py-2.5">
        <i data-lucide="plus" class="w-4 h-4 text-white/80"></i>
        New Project
    </button>
</div>

<!-- Projects List -->
@if (!Model.Any())
{
    <!-- Empty State -->
    <div class="glass-card rounded-xl overflow-hidden text-center py-24 border-dashed border-2 border-white/5">
        <div class="w-20 h-20 rounded-2xl bg-blue/10 flex items-center justify-center mx-auto mb-6">
            <i data-lucide="folder-plus" class="w-10 h-10 text-blue"></i>
        </div>
        <h3 class="text-2xl font-bold text-white mb-2">No projects yet</h3>
        <p class="text-hc-muted mb-8 max-w-sm mx-auto">Create a project to group your monitors by application or
            environment.</p>
        <button onclick="document.getElementById('createProjectModal').classList.remove('hidden')"
            class="hc-btn-primary px-6 py-2.5">
            Create Project
        </button>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var project in Model)
        {
            <a href="/@project.Slug/monitors"
                class="glass-card rounded-2xl p-6 group border border-hc-border hover:border-blue-500/50 transition-all duration-300 relative overflow-hidden">

                <!-- Dynamic Gradient Background -->
                <div
                    class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity">
                </div>

                <div class="relative z-10">
                    <div class="flex items-center justify-between mb-6">
                        <!-- Project Icon -->
                        <div
                            class="w-12 h-12 rounded-xl bg-blue/10 border border-blue/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                            <i data-lucide="folder" class="w-6 h-6 text-blue"></i>
                        </div>

                        <!-- Arrow Icon -->
                        <div
                            class="p-2 rounded-lg bg-hc-black-light/50 border border-hc-border group-hover:border-blue/30 group-hover:translate-x-1 transition-all">
                            <i data-lucide="arrow-right"
                                class="w-4 h-4 text-hc-muted group-hover:text-blue transition-colors"></i>
                        </div>
                    </div>

                    <h3 class="text-xl font-bold text-white mb-1 group-hover:text-blue transition-colors">@project.Name</h3>
                    <div class="flex items-center gap-1.5 text-hc-muted text-xs">
                        <i data-lucide="user" class="w-3 h-3"></i>
                        <span class="truncate">@(project.OwnerEmail ?? "—")</span>
                        @if (project.UserId != ViewBag.CurrentUserId) {
                            <span class="ml-1 px-1.5 py-0.5 bg-blue/10 text-blue text-[9px] rounded uppercase font-bold">Member</span>
                        }
                    </div>

                    <div class="flex items-center justify-between mt-4 pt-4 border-t border-white/5">
                        <div class="flex items-center gap-4 text-sm text-hc-muted">
                            <div class="flex items-center gap-1.5">
                                <i data-lucide="activity" class="w-4 h-4"></i>
                                <span>@project.MonitorCount Monitors</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <i data-lucide="zap" class="w-4 h-4"></i>
                                <span>@project.InteractionsCount Beats</span>
                            </div>
                        </div>
                        <span class="text-xs font-bold text-blue uppercase tracking-widest">View</span>
                    </div>
                </div>
            </a>
        }
    </div>
}

<!-- Create Project Modal -->
<div id="createProjectModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="fixed inset-0 bg-black/70 transition-opacity"
            onclick="document.getElementById('createProjectModal').classList.add('hidden')"></div>

        <div
            class="relative bg-[#111114] border border-white/5 rounded-2xl shadow-xl w-full sm:max-w-md z-10">
            <div class="px-6 py-5 border-b border-white/5 flex justify-between items-center">
                <h3 class="text-base font-semibold text-white">Create New Project</h3>
                <button onclick="document.getElementById('createProjectModal').classList.add('hidden')"
                    class="text-[#8A8A93] hover:text-white transition-colors">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <form action="/project/create" method="POST">
                <div class="p-6 space-y-5">
                    <div>
                        <label for="name" class="hc-label">Project Name</label>
                        <input type="text" name="name" id="name" required
                            class="hc-input"
                            placeholder="e.g. My Website, API Service">
                    </div>
                    <div class="bg-[#22C55E]/10 rounded-xl p-4 border border-[#22C55E]/20">
                        <p class="text-xs text-[#22C55E] flex gap-2">
                            <i data-lucide="info" class="w-4 h-4 shrink-0"></i>
                            Projects help you organize your monitors and control access for different teams or
                            applications.
                        </p>
                    </div>
                </div>
                <div class="p-6 border-t border-white/5 flex justify-end gap-3 bg-[rgba(0,0,0,0.2)]">
                    <button type="button"
                        onclick="document.getElementById('createProjectModal').classList.add('hidden')"
                        class="hc-btn-secondary px-5 py-2">
                        Cancel
                    </button>
                    <button type="submit"
                        class="hc-btn-primary px-6 py-2">
                        Create Project
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        lucide.createIcons();
    </script>
}
