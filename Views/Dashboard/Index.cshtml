@model IEnumerable<HealthyCron.Models.Project>
@{
    ViewData["Title"] = "My Projects";
    Layout = "_DashboardLayout";
}

<!-- Page Header -->
<div class="mb-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-semibold text-white mb-1 tracking-tight">My Projects</h1>
            <p class="text-sm text-[#8A8A93] font-normal">Manage your monitors and alerts</p>
        </div>
        <button onclick="document.getElementById('createProjectModal').classList.remove('hidden')"
            class="hc-btn-primary">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            New Project
        </button>
    </div>
</div>

<!-- Projects List -->
@if (!Model.Any())
{
    <!-- Empty State -->
    <div class="glass-card rounded-xl overflow-hidden text-center py-16">
        <div class="w-16 h-16 rounded-full bg-blue/10 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">No projects found</h3>
        <p class="text-hc-muted mb-6 max-w-sm mx-auto">Create your first project to start monitoring your cron jobs
            and background tasks.</p>
        <button onclick="document.getElementById('createProjectModal').classList.remove('hidden')"
            class="hc-btn-primary px-6 py-2.5">
            Create Project
        </button>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var project in Model)
        {
            <a href="/@project.Slug/monitors"
                class="glass-card rounded-xl p-6 group border border-hc-border hover:border-blue/50 transition-all duration-300 relative overflow-hidden">

                <!-- Dynamic Gradient Background -->
                <div
                    class="absolute inset-0 bg-gradient-to-br from-blue/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity">
                </div>

                <div class="relative z-10">
                    <div class="flex items-center justify-between mb-6">
                        <!-- Project Icon -->
                        <div
                            class="w-12 h-12 rounded-xl bg-blue/10 border border-blue/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                            <i data-lucide="folder" class="w-6 h-6 text-blue"></i>
                        </div>

                        <!-- Arrow Icon -->
                        <div
                            class="p-2 rounded-lg bg-hc-black-light/50 border border-hc-border group-hover:border-blue/30 group-hover:translate-x-1 transition-all">
                            <svg class="w-4 h-4 text-hc-muted group-hover:text-blue transition-colors" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </div>
                    </div>

                    <h3 class="text-xl font-bold text-white mb-2 group-hover:text-blue transition-colors">@project.Name
                    </h3>

                    <div class="flex items-center justify-between mt-4 pt-4 border-t border-white/5">
                        <div class="flex items-center gap-4 text-sm text-hc-muted">
                            <div class="flex items-center gap-1.5">
                                <i data-lucide="activity" class="w-4 h-4"></i>
                                <span>@project.MonitorCount Monitors</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <i data-lucide="zap" class="w-4 h-4"></i>
                                <span>@project.InteractionsCount Beats</span>
                            </div>
                        </div>
                        <span class="text-xs font-bold text-blue uppercase tracking-widest">View</span>
                    </div>
                </div>
            </a>
        }
    </div>

    <!-- Lucide Icons Script (ensure this is included in layout or here) -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        lucide.createIcons();
    </script>
}

<!-- Create Project Modal -->
<div id="createProjectModal" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="fixed inset-0 bg-black/75" onclick="document.getElementById('createProjectModal').classList.add('hidden')"></div>
        <div class="relative bg-[#111114] border border-white/5 rounded-2xl shadow-xl w-full sm:max-w-md z-10">
            <form action="/dashboard/create-project" method="POST">
                <div class="px-6 py-5 border-b border-white/5 flex items-center justify-between">
                    <h3 class="text-base font-semibold text-white" id="modal-title">New Project</h3>
                    <button type="button" onclick="document.getElementById('createProjectModal').classList.add('hidden')" class="text-[#8A8A93] hover:text-white transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>
                <div class="p-6">
                    <label class="hc-label">Project Name</label>
                    <input type="text" name="name" id="name" required class="hc-input" placeholder="e.g. My Website, API Service">
                </div>
                <div class="p-6 border-t border-white/5 flex items-center justify-end gap-3 bg-[rgba(0,0,0,0.2)]">
                    <button type="button" onclick="document.getElementById('createProjectModal').classList.add('hidden')" class="hc-btn-secondary px-5 py-2">Cancel</button>
                    <button type="submit" class="hc-btn-primary px-6 py-2">Create Project</button>
                </div>
            </form>
        </div>
    </div>
</div>
