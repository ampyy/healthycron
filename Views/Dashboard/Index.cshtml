@model IEnumerable<HealthyCron.Models.Project>
@{
    ViewData["Title"] = "My Projects";
    Layout = "_DashboardLayout";
}

<!-- Page Header -->
<div class="mb-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-white mb-2">My Projects</h1>
            <p class="text-text-secondary">Manage your monitors and alerts</p>
        </div>
        <button onclick="document.getElementById('createProjectModal').classList.remove('hidden')"
            class="glow-btn px-4 py-2.5 rounded-lg text-sm font-semibold flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            New Project
        </button>
    </div>
</div>

<!-- Projects List -->
@if (!Model.Any())
{
    <!-- Empty State -->
    <div class="glass-card rounded-xl overflow-hidden text-center py-16">
        <div class="w-16 h-16 rounded-full bg-blue/10 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">No projects found</h3>
        <p class="text-text-secondary mb-6 max-w-sm mx-auto">Create your first project to start monitoring your cron jobs
            and background tasks.</p>
        <button onclick="document.getElementById('createProjectModal').classList.remove('hidden')"
            class="glow-btn px-6 py-2.5 rounded-lg text-sm font-semibold">
            Create Project
        </button>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var project in Model)
        {
            var colorClass = project.Color ?? "blue";
            var iconName = project.Icon ?? "folder";

            <a href="/@project.Slug/monitors"
                class="glass-card rounded-xl p-6 group border border-border-color hover:border-@colorClass/50 transition-all duration-300 relative overflow-hidden">

                <!-- Dynamic Gradient Background -->
                <div
                    class="absolute inset-0 bg-gradient-to-br from-@colorClass/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity">
                </div>

                <div class="relative z-10">
                    <div class="flex items-center justify-between mb-6">
                        <!-- Project Icon -->
                        <div
                            class="w-12 h-12 rounded-xl bg-@colorClass/10 border border-@colorClass/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                            <i data-lucide="@iconName" class="w-6 h-6 text-@colorClass"></i>
                        </div>

                        <!-- Arrow Icon -->
                        <div
                            class="p-2 rounded-lg bg-navy-light/50 border border-border-color group-hover:border-@colorClass/30 group-hover:translate-x-1 transition-all">
                            <svg class="w-4 h-4 text-text-secondary group-hover:text-@colorClass transition-colors" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </div>
                    </div>

                    <h3 class="text-xl font-bold text-white mb-2 group-hover:text-@colorClass transition-colors">@project.Name
                    </h3>

                    <div class="flex items-center justify-between mt-4 pt-4 border-t border-white/5">
                        <div class="flex items-center gap-4 text-sm text-text-secondary">
                            <div class="flex items-center gap-1.5">
                                <i data-lucide="activity" class="w-4 h-4"></i>
                                <span>@project.MonitorCount Monitors</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <i data-lucide="zap" class="w-4 h-4"></i>
                                <span>@project.InteractionsCount Beats</span>
                            </div>
                        </div>
                        <span class="text-xs font-bold text-@colorClass uppercase tracking-widest">View</span>
                    </div>
                </div>
            </a>
        }
    </div>

    <!-- Lucide Icons Script (ensure this is included in layout or here) -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        lucide.createIcons();
    </script>
}

<!-- Create Project Modal -->
<div id="createProjectModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title"
    role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <!-- Overlay -->
        <div class="fixed inset-0 bg-black/70 transition-opacity" aria-hidden="true"
            onclick="document.getElementById('createProjectModal').classList.add('hidden')"></div>

        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

        <!-- Modal Panel -->
        <div
            class="inline-block align-bottom bg-navy-light rounded-xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full border border-border-color">
            <form action="/dashboard/create-project" method="POST">
                <div class="px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                    <h3 class="text-xl font-bold text-white mb-4" id="modal-title">Create New Project</h3>
                    <div class="mt-2">
                        <label for="name" class="block text-sm font-medium text-text-secondary mb-2">Project
                            Name</label>
                        <input type="text" name="name" id="name" required
                            class="w-full bg-navy border border-border-color rounded-lg px-4 py-2.5 text-white placeholder-text-secondary focus:outline-none focus:ring-2 focus:ring-blue/50 focus:border-transparent transition-all"
                            placeholder="e.g. My Website, API Service">
                    </div>
                </div>
                <div class="bg-navy px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse border-t border-border-color">
                    <button type="submit"
                        class="glow-btn w-full inline-flex justify-center rounded-lg border border-transparent shadow-sm px-4 py-2 text-base font-medium text-white sm:ml-3 sm:w-auto sm:text-sm">
                        Create Project
                    </button>
                    <button type="button"
                        onclick="document.getElementById('createProjectModal').classList.add('hidden')"
                        class="mt-3 w-full inline-flex justify-center rounded-lg border border-border-color shadow-sm px-4 py-2 bg-transparent text-base font-medium text-text-secondary hover:text-white sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm hover:bg-white/5 transition-colors">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
