@model HealthyCron.Models.ViewModels.DashboardStats
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DashboardLayout";

    var chartData = ViewBag.ChartData as IEnumerable<HealthyCron.Models.ViewModels.ProjectPingStats> ?? new List<HealthyCron.Models.ViewModels.ProjectPingStats>();
}

<div class="space-y-8">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4">
        <div>
            <h1 class="text-3xl font-bold text-white mb-2">Dashboard Overview</h1>
            <p class="text-text-secondary">Global metrics across all your projects.</p>
        </div>
        <div class="flex">
            <span class="px-3 py-1 bg-green-500/10 text-green-500 border border-green-500/20 rounded-full text-[10px] font-black uppercase tracking-widest flex items-center gap-1.5">
                <div class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></div>
                System Live
            </span>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="glass-card rounded-2xl p-5 border border-white/5 relative overflow-hidden group">
            <p class="text-[10px] font-black text-text-secondary uppercase tracking-widest mb-1">Projects</p>
            <h2 class="text-3xl font-black text-white">@Model.TotalProjects</h2>
            <div class="absolute right-4 top-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <i data-lucide="folder" class="w-8 h-8 text-blue-500"></i>
            </div>
        </div>

        <div class="glass-card rounded-2xl p-5 border border-white/5 relative overflow-hidden group">
            <p class="text-[10px] font-black text-text-secondary uppercase tracking-widest mb-1">Monitors</p>
            <h2 class="text-3xl font-black text-white">@Model.TotalMonitors</h2>
            <div class="absolute right-4 top-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <i data-lucide="activity" class="w-8 h-8 text-blue-500"></i>
            </div>
        </div>

        <div class="glass-card rounded-2xl p-5 border border-white/5 relative overflow-hidden group">
            <p class="text-[10px] font-black text-text-secondary uppercase tracking-widest mb-1">Total Beats</p>
            <h2 class="text-3xl font-black text-white">@Model.TotalBeats.ToString("N0")</h2>
            <div class="absolute right-4 top-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <i data-lucide="zap" class="w-8 h-8 text-yellow"></i>
            </div>
        </div>

        <div class="glass-card rounded-2xl p-5 border border-white/5 relative overflow-hidden group">
            <p class="text-[10px] font-black text-green-500 uppercase tracking-widest mb-1">Healthy</p>
            <h2 class="text-3xl font-black text-white">@Model.HealthyMonitors</h2>
            <div class="absolute right-4 top-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <i data-lucide="check-circle" class="w-8 h-8 text-green-500"></i>
            </div>
        </div>

        <div class="glass-card rounded-2xl p-5 border border-white/5 relative overflow-hidden group">
            <p class="text-[10px] font-black text-red-500 uppercase tracking-widest mb-1">Missed/Failed</p>
            <h2 class="text-3xl font-black text-white">@(Model.MissedMonitors + Model.FailedMonitors)</h2>
            <div class="absolute right-4 top-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <i data-lucide="alert-circle" class="w-8 h-8 text-red-500"></i>
            </div>
        </div>
    </div>

    <!-- Middle Section: Quotas & Analytics -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Usage Quotas -->
        <div class="glass-card rounded-2xl p-8 border border-white/5 lg:col-span-1">
            <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
                <i data-lucide="pie-chart" class="text-blue-500 w-5 h-5"></i>
                Usage Quotas
            </h3>

            <div class="space-y-6">
                <!-- Projects Quota -->
                <div>
                    <div class="flex justify-between items-end mb-2">
                        <span class="text-xs font-bold text-white uppercase tracking-tight">Projects</span>
                        <span class="text-[10px] text-text-secondary font-mono">@Model.TotalProjects / @Model.ProjectQuota</span>
                    </div>
                    <div class="h-1.5 w-full bg-white/5 rounded-full overflow-hidden">
                        <div class="h-full bg-blue-600 transition-all duration-1000"
                            style="width: @(Math.Min(100, (Model.TotalProjects * 100) / Model.ProjectQuota))%"></div>
                    </div>
                </div>

                <!-- Monitors Quota -->
                <div>
                    <div class="flex justify-between items-end mb-2">
                        <span class="text-xs font-bold text-white uppercase tracking-tight">Monitors</span>
                        <span class="text-[10px] text-text-secondary font-mono">@Model.TotalMonitors / @Model.MonitorQuota</span>
                    </div>
                    <div class="h-1.5 w-full bg-white/5 rounded-full overflow-hidden">
                        <div class="h-full bg-blue-600 transition-all duration-1000"
                            style="width: @(Math.Min(100, (Model.TotalMonitors * 100) / Model.MonitorQuota))%"></div>
                    </div>
                </div>

                <div class="pt-4">
                    <div class="p-4 bg-hc-black/50 rounded-xl border border-white/5 flex items-center justify-between group cursor-pointer hover:border-blue-500/30 transition-all">
                        <div>
                            <p class="text-sm font-bold text-white">Starter Plan</p>
                            <p class="text-[10px] text-text-secondary uppercase font-black">Free Tier</p>
                        </div>
                        <button class="px-3 py-1.5 bg-white text-hc-black text-[10px] font-black rounded-lg group-hover:bg-blue-600 group-hover:text-white transition-all uppercase tracking-tighter">Upgrade</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activity Graph -->
        <div class="glass-card rounded-2xl p-8 border border-white/5 lg:col-span-2 relative overflow-hidden">
            <div class="flex justify-between items-center mb-8">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <i data-lucide="trending-up" class="text-green-500 w-5 h-5"></i>
                    Ping Volume (Last 24h)
                </h3>
                <div class="flex gap-3">
                    @foreach(var project in chartData) {
                        <div class="flex items-center gap-1.5">
                            <div class="w-1.5 h-1.5 rounded-full" style="background-color: @project.Color"></div>
                            <span class="text-[9px] font-black text-text-secondary uppercase tracking-widest">@project.ProjectName</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Chart Container -->
            <div class="h-64 relative mt-4">
                <canvas id="pingChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof lucide !== 'undefined') lucide.createIcons();
            
            // Prepare Data from Razor
            const rawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartData, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
            
            // Generate last 24h labels
            const labels = [];
            const now = new Date();
            for (let i = 23; i >= 0; i--) {
                const d = new Date(now.getTime() - i * 60 * 60 * 1000);
                labels.push(d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }));
            }

            // Transform rawData into Chart.js datasets
            const datasets = rawData.map(project => {
                // Pad data array to exactly 24 elements if necessary
                let dataPoints = project.data.map(d => d.count);
                while (dataPoints.length < 24) {
                    dataPoints.push(0);
                }
                
                return {
                    label: project.projectName,
                    data: dataPoints,
                    borderColor: project.color,
                    backgroundColor: project.color + '20', // Add transparency for fill
                    borderWidth: 2,
                    pointRadius: 0, // Hide points by default
                    pointHoverRadius: 4,
                    pointBackgroundColor: project.color,
                    fill: false,
                    tension: 0.4, // Smooth curves
                    cubicInterpolationMode: 'monotone'
                };
            });

            const ctx = document.getElementById('pingChart').getContext('2d');
            
            Chart.defaults.color = '#9ca3af';
            Chart.defaults.font.family = 'Inter, system-ui, sans-serif';

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    plugins: {
                        legend: {
                            display: false // We use our custom HTML legend above
                        },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.9)',
                            titleColor: '#fff',
                            bodyColor: '#cbd5e1',
                            borderColor: 'rgba(255, 255, 255, 0.1)',
                            borderWidth: 1,
                            padding: 12,
                            boxPadding: 4,
                            usePointStyle: true,
                            callbacks: {
                                label: function(context) {
                                    return ` ${context.dataset.label}: ${context.parsed.y} pings`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                color: 'rgba(255, 255, 255, 0.05)',
                                drawBorder: false
                            },
                            ticks: {
                                maxTicksLimit: 6,
                                font: { size: 10 }
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(255, 255, 255, 0.05)',
                                drawBorder: false
                            },
                            ticks: {
                                precision: 0,
                                font: { size: 10 }
                            }
                        }
                    }
                }
            });
        });
    </script>
}

