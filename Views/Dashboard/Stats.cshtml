@model IEnumerable<HealthyCron.Models.Project>
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DashboardLayout";

    var totalProjects = Model.Count();
    var totalMonitors = Model.Sum(p => p.MonitorCount);
    var totalBeats = Model.Sum(p => p.InteractionsCount);

    // Quota Logic (Demo)
    var projectQuota = 5;
    var monitorQuota = 20;
}

<div class="space-y-8">
    <!-- Page Header -->
    <div>
        <h1 class="text-3xl font-bold text-white mb-2">Dashboard Overview</h1>
        <p class="text-text-secondary">Summary of your monitoring ecosystem and quotas.</p>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-card rounded-2xl p-6 border border-white/5 relative overflow-hidden group">
            <div class="absolute right-0 top-0 p-8 opacity-5 group-hover:opacity-10 transition-opacity">
                <i data-lucide="folder" class="w-16 h-16 text-blue"></i>
            </div>
            <p class="text-sm font-semibold text-text-secondary uppercase tracking-widest mb-1">Total Projects</p>
            <h2 class="text-4xl font-black text-white">@totalProjects</h2>
            <div
                class="mt-4 flex items-center gap-2 text-xs text-green-500 font-bold bg-green-500/5 px-2 py-1 rounded-full w-fit">
                <i data-lucide="arrow-up-right" class="w-3 h-3"></i>
                Active
            </div>
        </div>

        <div class="glass-card rounded-2xl p-6 border border-white/5 relative overflow-hidden group">
            <div class="absolute right-0 top-0 p-8 opacity-5 group-hover:opacity-10 transition-opacity">
                <i data-lucide="activity" class="w-16 h-16 text-purple"></i>
            </div>
            <p class="text-sm font-semibold text-text-secondary uppercase tracking-widest mb-1">Total Monitors</p>
            <h2 class="text-4xl font-black text-white">@totalMonitors</h2>
            <div
                class="mt-4 flex items-center gap-2 text-xs text-purple-500 font-bold bg-purple-500/5 px-2 py-1 rounded-full w-fit">
                <i data-lucide="check-circle" class="w-3 h-3"></i>
                Monitoring
            </div>
        </div>

        <div class="glass-card rounded-2xl p-6 border border-white/5 relative overflow-hidden group">
            <div class="absolute right-0 top-0 p-8 opacity-5 group-hover:opacity-10 transition-opacity">
                <i data-lucide="zap" class="w-16 h-16 text-amber"></i>
            </div>
            <p class="text-sm font-semibold text-text-secondary uppercase tracking-widest mb-1">Total Beats</p>
            <h2 class="text-4xl font-black text-white">@totalBeats.ToString("N0")</h2>
            <div
                class="mt-4 flex items-center gap-2 text-xs text-amber-500 font-bold bg-amber-500/5 px-2 py-1 rounded-full w-fit">
                <i data-lucide="zap" class="w-3 h-3"></i>
                Interactions
            </div>
        </div>
    </div>

    <!-- Middle Section: Quotas & Analytics -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Usage Quotas -->
        <div class="glass-card rounded-2xl p-8 border border-white/5">
            <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                <i data-lucide="pie-chart" class="text-blue"></i>
                Usage Quotas
            </h3>

            <div class="space-y-6">
                <!-- Projects Quota -->
                <div>
                    <div class="flex justify-between items-end mb-2">
                        <span class="text-sm font-semibold text-white">Projects</span>
                        <span class="text-xs text-text-secondary font-mono">@totalProjects / @projectQuota</span>
                    </div>
                    <div class="h-2 w-full bg-white/5 rounded-full overflow-hidden">
                        <div class="h-full bg-blue transition-all duration-1000"
                            style="width: @(Math.Min(100, (totalProjects * 100) / projectQuota))%"></div>
                    </div>
                </div>

                <!-- Monitors Quota -->
                <div>
                    <div class="flex justify-between items-end mb-2">
                        <span class="text-sm font-semibold text-white">Monitors</span>
                        <span class="text-xs text-text-secondary font-mono">@totalMonitors / @monitorQuota</span>
                    </div>
                    <div class="h-2 w-full bg-white/5 rounded-full overflow-hidden">
                        <div class="h-full bg-purple transition-all duration-1000"
                            style="width: @(Math.Min(100, (totalMonitors * 100) / monitorQuota))%"></div>
                    </div>
                </div>

                <div class="pt-4">
                    <div class="p-4 bg-navy-light rounded-xl border border-white/5 flex items-center justify-between">
                        <div>
                            <p class="text-sm font-bold text-white">Starter Plan</p>
                            <p class="text-xs text-text-secondary">Upgrade for more capacity</p>
                        </div>
                        <button
                            class="px-4 py-2 bg-white text-navy text-xs font-black rounded-lg hover:bg-blue hover:text-white transition-all uppercase tracking-tighter">Upgrade</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activity Graph Placeholder -->
        <div class="glass-card rounded-2xl p-8 border border-white/5 relative overflow-hidden">
            <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                <i data-lucide="trending-up" class="text-green-500"></i>
                Recent Activity
            </h3>

            <div class="h-48 flex items-end gap-1 px-2">
                @for (int i = 0; i < 28; i++)
                {
                    var height = new Random().Next(20, 100);
                    <div class="flex-1 bg-blue/20 rounded-t hover:bg-blue transition-all group relative cursor-pointer"
                        style="height: @height%">
                        <div
                            class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-white text-navy text-[10px] font-bold rounded opacity-0 group-hover:opacity-100 transition-opacity z-10 pointer-events-none whitespace-nowrap">
                            @(new Random().Next(100, 500)) pings
                        </div>
                    </div>
                }
            </div>

            <div
                class="flex justify-between mt-4 text-[10px] text-text-secondary font-mono uppercase tracking-widest px-2">
                <span>4 weeks ago</span>
                <span>Today</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        lucide.createIcons();
    </script>
}
