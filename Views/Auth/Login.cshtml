@{
    ViewData["Title"] = "Sign in to HealthyCron";
}

<style>
    /* Particle canvas animation */
    @@keyframes particle-float {
        0% { transform: translateY(0); opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { transform: translateY(-100vh); opacity: 0; }
    }
    .login-particle {
        position: absolute;
        width: 1px;
        height: 3px;
        background: rgba(255,255,255,0.4);
        animation: particle-float var(--dur, 8s) var(--delay, 0s) linear infinite;
        pointer-events: none;
    }
</style>

<section class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden bg-black py-12 px-4">

    <!-- Dot particle canvas -->
    <canvas id="login-particles" class="absolute inset-0 w-full h-full opacity-40 pointer-events-none z-0"></canvas>

    <!-- Radial vignette (dark center to show form clearly) -->
    <div class="absolute inset-0 z-0 pointer-events-none"
         style="background: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(0,0,0,0.85) 0%, transparent 100%)"></div>

    <!-- Subtle top gradient -->
    <div class="absolute top-0 left-0 right-0 h-1/3 bg-gradient-to-b from-black to-transparent z-0 pointer-events-none"></div>

    <!-- Content -->
    <div class="relative z-10 w-full max-w-sm">

        <!-- Logo -->
        <div class="text-center mb-10">
            <a href="/" class="inline-flex items-center gap-2">
                <img src="/images/logo.png" alt="HealthyCron" class="w-8 h-8 rounded-lg object-contain">
                <span class="text-lg font-bold text-white">HealthyCron</span>
            </a>
        </div>

        <!-- Heading -->
        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-white leading-tight mb-2">Welcome back</h1>
            <p class="text-white/50 font-light text-lg">Sign in to your account</p>
        </div>

        @if (ViewBag.ReturnUrl != null && ((string)ViewBag.ReturnUrl).Contains("invite"))
        {
            <div class="mb-6 bg-blue/10 border border-blue/20 rounded-full px-4 py-2.5 text-center text-sm text-blue-400">
                <span class="font-semibold">Sign in below</span> to accept your project invitation.
            </div>
        }

        <!-- Magic Link Form -->
        <form id="magicLoginForm" class="space-y-4">
            <div class="flex items-center gap-2 rounded-full border border-white/10 bg-transparent px-5 py-3.5 focus-within:border-white/30 transition-colors">
                <svg class="w-4 h-4 text-white/30 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <input type="email" id="magicEmail" name="email" required
                    class="flex-1 bg-transparent text-white text-center placeholder-white/30 focus:outline-none text-sm"
                    placeholder="you@company.com">
            </div>

            <button type="submit" id="magicSubmitBtn"
                class="w-full py-3 rounded-full font-semibold text-sm text-white glow-btn transition-all">
                Continue with Magic Link →
            </button>
        </form>
        <input type="hidden" id="returnUrl" value="@(ViewBag.ReturnUrl ?? string.Empty)">

        <!-- Success state -->
        <div id="magicSuccess" class="hidden mt-5 p-4 rounded-2xl bg-blue/10 border border-blue/20">
            <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-blue flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <div>
                    <p class="text-blue font-semibold mb-1 text-sm">Check your inbox</p>
                    <p class="text-xs text-white/50">We've sent a magic login link to <span id="magicEmailDisplay" class="text-white font-medium"></span></p>
                </div>
            </div>
        </div>

        <!-- Divider -->
        <div class="flex items-center gap-4 my-6">
            <div class="flex-1 h-px bg-white/10"></div>
            <button type="button" onclick="togglePasswordForm()" id="toggleBtn"
                class="text-white/40 hover:text-white/70 text-xs transition-colors whitespace-nowrap">or use password</button>
            <div class="flex-1 h-px bg-white/10"></div>
        </div>

        <!-- Password Form -->
        <form id="passwordLoginForm" class="space-y-4 hidden">
            <div class="flex items-center gap-2 rounded-full border border-white/10 bg-transparent px-5 py-3.5 focus-within:border-white/30 transition-colors">
                <svg class="w-4 h-4 text-white/30 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <input type="email" id="loginEmail" name="email" required
                    class="flex-1 bg-transparent text-white text-center placeholder-white/30 focus:outline-none text-sm"
                    placeholder="you@company.com">
            </div>
            <div class="flex items-center gap-2 rounded-full border border-white/10 bg-transparent px-5 py-3.5 focus-within:border-white/30 transition-colors">
                <svg class="w-4 h-4 text-white/30 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                <input type="password" id="loginPassword" name="password" required
                    class="flex-1 bg-transparent text-white text-center placeholder-white/30 focus:outline-none text-sm"
                    placeholder="••••••••">
            </div>
            <button type="submit" id="passwordSubmitBtn"
                class="w-full py-3 rounded-full font-semibold text-sm text-white glow-btn transition-all">
                Sign in with Password
            </button>
        </form>

        <p class="mt-8 text-center text-xs text-white/40">
            Don't have an account?
            <a href="/signup" class="text-white/70 hover:text-white font-medium ml-1 underline transition-colors">Sign up</a>
        </p>

        <p class="mt-4 text-center text-xs text-white/25">
            By continuing, you agree to our
            <a href="#" class="underline hover:text-white/50 transition-colors">Privacy Policy</a> &amp;
            <a href="#" class="underline hover:text-white/50 transition-colors">Terms</a>
        </p>
    </div>
</section>

<script>
    // Particle animation
    (function() {
        var canvas = document.getElementById('login-particles');
        var ctx = canvas ? canvas.getContext('2d') : null;
        if (!canvas || !ctx) return;

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        resize();
        window.addEventListener('resize', resize);

        var particles = [];
        function makeParticle() {
            return {
                x: Math.random() * canvas.width,
                y: canvas.height + Math.random() * 40,
                speed: Math.random() * 0.4 + 0.1,
                opacity: Math.random() * 0.3 + 0.1
            };
        }
        var count = Math.floor((canvas.width * canvas.height) / 12000);
        for (var i = 0; i < count; i++) {
            var p = makeParticle();
            p.y = Math.random() * canvas.height; // scatter initially
            particles.push(p);
        }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(function(p) {
                p.y -= p.speed;
                if (p.y < -5) {
                    p.x = Math.random() * canvas.width;
                    p.y = canvas.height + 5;
                    p.speed = Math.random() * 0.4 + 0.1;
                    p.opacity = Math.random() * 0.3 + 0.1;
                }
                ctx.fillStyle = 'rgba(255,255,255,' + p.opacity + ')';
                ctx.fillRect(p.x, p.y, 0.7, 2.5);
            });
            requestAnimationFrame(draw);
        }
        draw();
    })();
</script>

    @section Scripts {
    <script>
        const returnUrl = document.getElementById('returnUrl')?.value || '';
        const magicForm = document.getElementById('magicLoginForm');
        const passwordForm = document.getElementById('passwordLoginForm');
        const magicSubmitBtn = document.getElementById('magicSubmitBtn');
        const passwordSubmitBtn = document.getElementById('passwordSubmitBtn');
        const magicSuccess = document.getElementById('magicSuccess');
        const magicEmailDisplay = document.getElementById('magicEmailDisplay');
        const toggleBtn = document.getElementById('toggleBtn');

        function togglePasswordForm() {
            const isHidden = passwordForm.classList.contains('hidden');
            if (isHidden) {
                passwordForm.classList.remove('hidden');
                magicForm.classList.add('hidden');
                magicSuccess.classList.add('hidden');
                toggleBtn.textContent = 'Or use magic link';
            } else {
                passwordForm.classList.add('hidden');
                magicForm.classList.remove('hidden');
                toggleBtn.textContent = 'Or use password';
            }
        }

        // Magic link logic
        magicForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('magicEmail').value;
            magicSubmitBtn.disabled = true;
            magicSubmitBtn.innerHTML = '<span class="flex items-center justify-center gap-2"><svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Sending...</span>';

            try {
                const response = await fetch('/auth/request-magic-link', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, returnUrl: returnUrl || null })
                });

                if (response.ok) {
                    magicForm.classList.add('hidden');
                    magicEmailDisplay.textContent = email;
                    magicSuccess.classList.remove('hidden');
                } else {
                    alert('Something went wrong. Please try again.');
                    magicSubmitBtn.disabled = false;
                    magicSubmitBtn.innerHTML = 'Continue with Magic Link';
                }
            } catch (err) {
                console.error(err);
                alert('Connection error.');
                magicSubmitBtn.disabled = false;
                magicSubmitBtn.innerHTML = 'Continue with Magic Link';
            }
        });

        // Password login logic
        passwordForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('loginEmail').value;
            const password = document.getElementById('loginPassword').value;

            passwordSubmitBtn.disabled = true;
            passwordSubmitBtn.innerHTML = '<span class="flex items-center justify-center gap-2"><svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Signing in...</span>';

            try {
                const response = await fetch('/auth/login-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });

                if (response.ok) {
                    window.location.href = returnUrl || '/dashboard';
                } else {
                    const data = await response.json();
                    alert(data.message || 'Invalid email or password.');
                    passwordSubmitBtn.disabled = false;
                    passwordSubmitBtn.innerHTML = 'Sign in with Password';
                }
            } catch (err) {
                console.error(err);
                alert('Connection error.');
                passwordSubmitBtn.disabled = false;
                passwordSubmitBtn.innerHTML = 'Sign in with Password';
            }
        });
    </script>
}
