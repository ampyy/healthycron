@* Why We're Different — colored icons per card, hairline gap-px grid *@
<section class="py-24">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-14 fade-in">
            <h2 class="text-3xl font-semibold text-white tracking-tight">Power. Speed. Control.</h2>
            <p class="text-sm font-normal text-[#8A8A93] text-center max-w-lg mx-auto mt-3">
                Everything you need to build a reliable job monitoring pipeline — without the ops overhead.
            </p>
        </div>

        <!-- gap-px technique: bg-white/5 on grid creates hairline separators via 1px gaps -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/5 rounded-2xl overflow-hidden fade-in">

            <!-- 1 — Deep Cron Awareness: Amber/yellow for "time" -->
            <div class="p-8 bg-[#0A0A0B] hover:bg-[#111114] transition-colors duration-200 group">
                <div class="w-10 h-10 rounded-xl bg-[#F59E0B]/10 flex items-center justify-center mb-6">
                    <svg class="w-5 h-5 text-[#F59E0B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <h3 class="text-sm font-medium text-white mt-5">Deep Cron Awareness</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Understands cron syntax, grace periods, and missed executions. Not just simple uptime pings.</p>
            </div>

            <!-- 2 — Minimal False Positives: Green for "healthy/ok" -->
            <div class="p-8 bg-[#0A0A0B] hover:bg-[#111114] transition-colors duration-200 group">
                <div class="w-10 h-10 rounded-xl bg-[#22C55E]/10 flex items-center justify-center mb-6">
                    <svg class="w-5 h-5 text-[#22C55E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <h3 class="text-sm font-medium text-white mt-5">Minimal False Positives</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Verification checks before alerts. No more alert fatigue from noisy monitoring systems.</p>
            </div>

            <!-- 3 — Alerts in < 5s: Red for "alert/urgent" -->
            <div class="p-8 bg-[#0A0A0B] hover:bg-[#111114] transition-colors duration-200 group">
                <div class="w-10 h-10 rounded-xl bg-[#E03E2D]/10 flex items-center justify-center mb-6">
                    <svg class="w-5 h-5 text-[#E03E2D]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <h3 class="text-sm font-medium text-white mt-5">Alerts in &lt;5 Seconds</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">When your job fails, you know immediately. Not in minutes — in seconds. Every time.</p>
            </div>

            <!-- 4 — API-First Design: Blue for "developer/code" -->
            <div class="p-8 bg-[#0A0A0B] hover:bg-[#111114] transition-colors duration-200 group">
                <div class="w-10 h-10 rounded-xl bg-[#3B82F6]/10 flex items-center justify-center mb-6">
                    <svg class="w-5 h-5 text-[#3B82F6]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                </div>
                <h3 class="text-sm font-medium text-white mt-5">API-First Design</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">REST API, SDKs, and CLI tools for every language. Integrate in minutes, not days.</p>
            </div>

            <!-- 5 — Environment Tags: Purple for "organization/filter" -->
            <div class="p-8 bg-[#0A0A0B] hover:bg-[#111114] transition-colors duration-200 group">
                <div class="w-10 h-10 rounded-xl bg-[#7C3AED]/10 flex items-center justify-center mb-6">
                    <svg class="w-5 h-5 text-[#7C3AED]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                </div>
                <h3 class="text-sm font-medium text-white mt-5">Environment Tags</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Organize monitors by production, staging, or dev. Full context per environment, at a glance.</p>
            </div>

            <!-- 6 — Detailed Log History: Cyan for "data/analytics" -->
            <div class="p-8 bg-[#0A0A0B] hover:bg-[#111114] transition-colors duration-200 group">
                <div class="w-10 h-10 rounded-xl bg-[#06B6D4]/10 flex items-center justify-center mb-6">
                    <svg class="w-5 h-5 text-[#06B6D4]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                </div>
                <h3 class="text-sm font-medium text-white mt-5">Detailed Log History</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Full execution logs with duration, output, and exit codes. Debug failures without any guessing.</p>
            </div>

        </div>
    </div>
</section>
