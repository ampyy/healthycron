@* Stats Section — redesigned per design system *@
<section class="py-24 border-y border-white/5">
    <div class="max-w-5xl mx-auto px-6">
        <div class="border border-white/6 rounded-2xl overflow-hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y divide-x divide-white/6 fade-in">

            <!-- Card 1 -->
            <div class="bg-[#111114] p-7">
                <p class="text-xs font-normal text-[#8A8A93] uppercase tracking-widest">Checks Per Week</p>
                <p class="text-xs font-normal text-[#4A4A52] mt-0.5 mb-4">Average across all customers</p>
                <div class="flex items-center gap-2">
                    <span class="font-mono text-3xl font-medium text-white">10M+</span>
                    <span class="inline-flex items-center gap-1 text-[9px] font-medium uppercase tracking-wider text-[#22C55E] bg-[#22C55E]/8 border border-[#22C55E]/15 rounded px-1.5 py-0.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#22C55E] animate-pulse"></span>
                        Live
                    </span>
                </div>
                <p class="text-xs text-[#4A4A52] mt-1">and growing every day</p>
            </div>

            <!-- Card 2 -->
            <div class="bg-[#111114] p-7">
                <p class="text-xs font-normal text-[#8A8A93] uppercase tracking-widest">Alert Delivery Rate</p>
                <p class="text-xs font-normal text-[#4A4A52] mt-0.5 mb-4">Across all channels</p>
                <div class="flex items-center gap-2">
                    <span class="font-mono text-3xl font-medium text-white">99.99%</span>
                    <span class="inline-flex items-center gap-1 text-[9px] font-medium uppercase tracking-wider text-[#22C55E] bg-[#22C55E]/8 border border-[#22C55E]/15 rounded px-1.5 py-0.5">SLA</span>
                </div>
                <p class="text-xs text-[#4A4A52] mt-1">Guaranteed by contract</p>
            </div>

            <!-- Card 3 -->
            <div class="bg-[#111114] p-7">
                <p class="text-xs font-normal text-[#8A8A93] uppercase tracking-widest">Dev Teams</p>
                <p class="text-xs font-normal text-[#4A4A52] mt-0.5 mb-4">Already monitoring with us</p>
                <div class="flex items-center gap-2">
                    <span class="font-mono text-3xl font-medium text-white">2,500+</span>
                    <span class="inline-flex items-center gap-1 text-[9px] font-medium uppercase tracking-wider text-[#22C55E] bg-[#22C55E]/8 border border-[#22C55E]/15 rounded px-1.5 py-0.5">Teams</span>
                </div>
                <p class="text-xs text-[#4A4A52] mt-1">From startups to enterprise</p>
            </div>

            <!-- Card 4 -->
            <div class="bg-[#111114] p-7">
                <p class="text-xs font-normal text-[#8A8A93] uppercase tracking-widest">Avg Alert Latency</p>
                <p class="text-xs font-normal text-[#4A4A52] mt-0.5 mb-4">Detection to notification</p>
                <div class="flex items-center gap-2">
                    <span class="font-mono text-3xl font-medium text-white">&lt;5s</span>
                    <span class="inline-flex items-center gap-1 text-[9px] font-medium uppercase tracking-wider text-[#22C55E] bg-[#22C55E]/8 border border-[#22C55E]/15 rounded px-1.5 py-0.5">Fast</span>
                </div>
                <p class="text-xs text-[#4A4A52] mt-1">Fastest in the industry</p>
            </div>

        </div>
    </div>
</section>
