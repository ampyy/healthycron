@* Stats Section — statistic card grid *@
<section class="py-20 border-y border-[#1E293B] relative">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 bg-[#0E1420] rounded-2xl border border-[#1E293B] overflow-hidden fade-in">

            <!-- Card 1 -->
            <div class="p-8 flex flex-col gap-5 border-b sm:border-b sm:border-r lg:border-b-0 border-[#1E293B]">
                <div class="space-y-0.5">
                    <p class="text-base font-semibold text-white">Checks Per Week</p>
                    <p class="text-xs text-[#94A3B8]">Average across all customers</p>
                </div>
                <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2">
                        <span class="text-3xl font-bold text-white stat-counter" data-target="10000000" data-suffix="M+">10M+</span>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-400/10 text-emerald-400 border border-emerald-400/20">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                            Live
                        </span>
                    </div>
                    <p class="text-xs text-[#94A3B8]">and growing every day</p>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="p-8 flex flex-col gap-5 border-b sm:border-b lg:border-b-0 sm:border-r-0 lg:border-r border-[#1E293B]">
                <div class="space-y-0.5">
                    <p class="text-base font-semibold text-white">Alert Delivery Rate</p>
                    <p class="text-xs text-[#94A3B8]">Across all channels</p>
                </div>
                <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2">
                        <span class="text-3xl font-bold text-white">99.99%</span>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-blue/10 text-blue border border-blue/20">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            SLA
                        </span>
                    </div>
                    <p class="text-xs text-[#94A3B8]">Guaranteed by contract</p>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="p-8 flex flex-col gap-5 border-b sm:border-b-0 sm:border-r border-[#1E293B] lg:border-b-0">
                <div class="space-y-0.5">
                    <p class="text-base font-semibold text-white">Dev Teams</p>
                    <p class="text-xs text-[#94A3B8]">Already monitoring with us</p>
                </div>
                <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2">
                        <span class="text-3xl font-bold text-white">2,500+</span>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-purple/10 text-purple border border-purple/20">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            Teams
                        </span>
                    </div>
                    <p class="text-xs text-[#94A3B8]">From startups to enterprise</p>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="p-8 flex flex-col gap-5">
                <div class="space-y-0.5">
                    <p class="text-base font-semibold text-white">Avg Alert Latency</p>
                    <p class="text-xs text-[#94A3B8]">Detection to notification</p>
                </div>
                <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2">
                        <span class="text-3xl font-bold text-white">&lt;5s</span>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-cyan-400/10 text-cyan-400 border border-cyan-400/20">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                            Fast
                        </span>
                    </div>
                    <p class="text-xs text-[#94A3B8]">Fastest in the industry</p>
                </div>
            </div>

        </div>
    </div>
</section>
