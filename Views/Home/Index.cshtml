@{
    ViewData["Title"] = "Cron & Heartbeat Monitoring Reimagined";
}

@* Hero Section *@
<section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden bg-gradient-animated px-4 sm:px-6 lg:px-8">
    <!-- Subtle top vignette -->
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

    <div class="w-full max-w-6xl flex flex-col md:flex-row min-h-[520px] items-center relative">

        <!-- Left: Text Content -->
        <div class="flex-1 flex flex-col justify-center py-16 md:py-20 relative z-10">

            <!-- Status badge -->
            <div class="inline-flex items-center gap-2 rounded-full border border-hc-border bg-hc-surface/70 px-3 py-1 text-xs text-hc-dim mb-6 w-fit">
                <span class="w-1.5 h-1.5 rounded-full bg-hc-green pulse-dot"></span>
                All systems operational
            </div>

            <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-[1.1] mb-4">
                Global Job<br>
                <span class="gradient-text">Monitoring. Simplified.</span>
            </h1>

            <p class="text-sm md:text-base text-hc-dim max-w-md leading-relaxed mb-8">
                Never miss a job run. Monitor cron, heartbeats, queues, and background workers in real-time — with logs, alerts, and performance insights built for engineering teams worldwide.
            </p>

            <!-- CTA Buttons -->
            <div class="flex flex-col sm:flex-row gap-3 mb-10">
                <a href="/signup" class="px-7 py-3 rounded-xl text-sm font-semibold text-center bg-hc-white text-hc-black hover:bg-hc-silver shadow-lg shadow-hc-white/10 transition-all duration-200">
                    Get Started Free
                </a>
                <a href="#contact"
                    class="px-7 py-3 rounded-xl text-sm font-medium text-hc-white/70 bg-hc-white/5 border border-hc-white/10 hover:border-hc-white/30 hover:text-hc-white transition-all flex items-center justify-center gap-2">
                    Talk to Sales
                </a>
            </div>

            <!-- Stats row -->
            <div class="flex items-center gap-6">
                <div>
                    <p class="text-2xl font-bold text-white">150+</p>
                    <p class="text-xs text-hc-dim">Edge Nodes</p>
                </div>
                <div class="w-px h-8 bg-hc-border"></div>
                <div>
                    <p class="text-2xl font-bold text-white">&lt;50ms</p>
                    <p class="text-xs text-hc-dim">Avg Latency</p>
                </div>
                <div class="w-px h-8 bg-hc-border"></div>
                <div>
                    <p class="text-2xl font-bold text-white">99.99%</p>
                    <p class="text-xs text-hc-dim">Uptime SLA</p>
                </div>
            </div>
        </div>

        <!-- Right: Interactive Globe -->
        <div class="flex-1 flex items-center justify-center py-8 md:py-0 min-h-[400px] relative">
            <canvas id="hero-globe"
                style="width:460px;height:460px;cursor:grab;"
                class="relative z-10 max-w-full">
            </canvas>
        </div>

    </div>
</section>

@* Interactive Globe Script *@
<script>
(function () {
    const canvas = document.getElementById('hero-globe');
    if (!canvas) return;

    const MARKERS = [
        { lat: 37.78, lng: -122.42, label: "San Francisco" },
        { lat: 51.51, lng: -0.13,  label: "London" },
        { lat: 35.68, lng: 139.69, label: "Tokyo" },
        { lat: -33.87, lng: 151.21, label: "Sydney" },
        { lat: 1.35,  lng: 103.82, label: "Singapore" },
        { lat: 55.76, lng: 37.62,  label: "Moscow" },
        { lat: -23.55, lng: -46.63, label: "São Paulo" },
        { lat: 19.43, lng: -99.13, label: "Mexico City" },
        { lat: 28.61, lng: 77.21,  label: "Delhi" },
        { lat: 36.19, lng: 44.01,  label: "Erbil" },
    ];

    const CONNECTIONS = [
        { from: [37.78, -122.42], to: [51.51, -0.13] },
        { from: [51.51, -0.13],   to: [35.68, 139.69] },
        { from: [35.68, 139.69],  to: [-33.87, 151.21] },
        { from: [37.78, -122.42], to: [1.35, 103.82] },
        { from: [51.51, -0.13],   to: [28.61, 77.21] },
        { from: [37.78, -122.42], to: [-23.55, -46.63] },
        { from: [1.35, 103.82],   to: [-33.87, 151.21] },
        { from: [28.61, 77.21],   to: [36.19, 44.01] },
        { from: [51.51, -0.13],   to: [36.19, 44.01] },
    ];

    // Pre-generate fibonacci sphere dots
    const DOTS = [];
    const numDots = 1200;
    const goldenRatio = (1 + Math.sqrt(5)) / 2;
    for (let i = 0; i < numDots; i++) {
        const theta = (2 * Math.PI * i) / goldenRatio;
        const phi   = Math.acos(1 - (2 * (i + 0.5)) / numDots);
        DOTS.push([
            Math.cos(theta) * Math.sin(phi),
            Math.cos(phi),
            Math.sin(theta) * Math.sin(phi),
        ]);
    }

    function latLngToXYZ(lat, lng, r) {
        const phi   = ((90 - lat) * Math.PI) / 180;
        const theta = ((lng + 180) * Math.PI) / 180;
        return [
            -(r * Math.sin(phi) * Math.cos(theta)),
             r * Math.cos(phi),
             r * Math.sin(phi) * Math.sin(theta),
        ];
    }

    function rotY(x, y, z, a) {
        const c = Math.cos(a), s = Math.sin(a);
        return [x * c + z * s, y, -x * s + z * c];
    }

    function rotX(x, y, z, a) {
        const c = Math.cos(a), s = Math.sin(a);
        return [x, y * c - z * s, y * s + z * c];
    }

    function project(x, y, z, cx, cy, fov) {
        const scale = fov / (fov + z);
        return [x * scale + cx, y * scale + cy];
    }

    let rotYAngle = 0.4;
    let rotXAngle = 0.3;
    let drag = { active: false, startX: 0, startY: 0, startRotY: 0, startRotX: 0 };
    let animId;
    let time = 0;
    const AUTO_SPEED = 0.002;
    const DOT_COLOR  = 'rgba(79,148,255,ALPHA)';   // matches #4F94FF brand blue
    const ARC_COLOR  = 'rgba(79,148,255,0.45)';
    const MKR_COLOR  = 'rgba(100,220,255,1)';

    function draw() {
        const dpr = window.devicePixelRatio || 1;
        const w   = canvas.clientWidth;
        const h   = canvas.clientHeight;
        canvas.width  = w * dpr;
        canvas.height = h * dpr;

        const ctx = canvas.getContext('2d');
        ctx.scale(dpr, dpr);

        const cx     = w / 2;
        const cy     = h / 2;
        const radius = Math.min(w, h) * 0.38;
        const fov    = 600;

        if (!drag.active) rotYAngle += AUTO_SPEED;
        time += 0.015;

        ctx.clearRect(0, 0, w, h);

        // Outer glow
        const glow = ctx.createRadialGradient(cx, cy, radius * 0.8, cx, cy, radius * 1.5);
        glow.addColorStop(0, 'rgba(79,148,255,0.04)');
        glow.addColorStop(1, 'rgba(79,148,255,0)');
        ctx.fillStyle = glow;
        ctx.fillRect(0, 0, w, h);

        // Globe outline
        ctx.beginPath();
        ctx.arc(cx, cy, radius, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(79,148,255,0.08)';
        ctx.lineWidth = 1;
        ctx.stroke();

        const ry = rotYAngle;
        const rx = rotXAngle;

        // Dots
        for (let i = 0; i < DOTS.length; i++) {
            let [x, y, z] = DOTS[i];
            x *= radius; y *= radius; z *= radius;
            [x, y, z] = rotX(x, y, z, rx);
            [x, y, z] = rotY(x, y, z, ry);
            if (z > 0) continue;
            const [sx, sy] = project(x, y, z, cx, cy, fov);
            const a = Math.max(0.08, 1 - (z + radius) / (2 * radius));
            const ds = 1 + a * 0.8;
            ctx.beginPath();
            ctx.arc(sx, sy, ds, 0, Math.PI * 2);
            ctx.fillStyle = DOT_COLOR.replace('ALPHA', a.toFixed(2));
            ctx.fill();
        }

        // Connections / arcs
        for (const conn of CONNECTIONS) {
            let [x1,y1,z1] = latLngToXYZ(conn.from[0], conn.from[1], radius);
            let [x2,y2,z2] = latLngToXYZ(conn.to[0],   conn.to[1],   radius);
            [x1,y1,z1] = rotX(x1,y1,z1,rx); [x1,y1,z1] = rotY(x1,y1,z1,ry);
            [x2,y2,z2] = rotX(x2,y2,z2,rx); [x2,y2,z2] = rotY(x2,y2,z2,ry);
            if (z1 > radius * 0.3 && z2 > radius * 0.3) continue;
            const [sx1,sy1] = project(x1,y1,z1,cx,cy,fov);
            const [sx2,sy2] = project(x2,y2,z2,cx,cy,fov);
            // Elevated midpoint
            const mX = (x1+x2)/2, mY = (y1+y2)/2, mZ = (z1+z2)/2;
            const mL = Math.sqrt(mX*mX+mY*mY+mZ*mZ);
            const ah = radius * 1.25;
            const [scx,scy] = project((mX/mL)*ah,(mY/mL)*ah,(mZ/mL)*ah,cx,cy,fov);
            ctx.beginPath();
            ctx.moveTo(sx1, sy1);
            ctx.quadraticCurveTo(scx, scy, sx2, sy2);
            ctx.strokeStyle = ARC_COLOR;
            ctx.lineWidth   = 1.2;
            ctx.stroke();
            // Traveling dot
            const t  = (Math.sin(time * 1.2 + conn.from[0] * 0.1) + 1) / 2;
            const tx = (1-t)*(1-t)*sx1 + 2*(1-t)*t*scx + t*t*sx2;
            const ty = (1-t)*(1-t)*sy1 + 2*(1-t)*t*scy + t*t*sy2;
            ctx.beginPath();
            ctx.arc(tx, ty, 2, 0, Math.PI * 2);
            ctx.fillStyle = MKR_COLOR;
            ctx.fill();
        }

        // Markers
        for (const m of MARKERS) {
            let [x,y,z] = latLngToXYZ(m.lat, m.lng, radius);
            [x,y,z] = rotX(x,y,z,rx);
            [x,y,z] = rotY(x,y,z,ry);
            if (z > radius * 0.1) continue;
            const [sx,sy] = project(x,y,z,cx,cy,fov);
            const pulse = Math.sin(time * 2 + m.lat) * 0.5 + 0.5;
            // Pulse ring
            ctx.beginPath();
            ctx.arc(sx, sy, 4 + pulse * 4, 0, Math.PI * 2);
            ctx.strokeStyle = MKR_COLOR.replace('1)', `${(0.2 + pulse * 0.15).toFixed(2)})`);
            ctx.lineWidth = 1;
            ctx.stroke();
            // Core dot
            ctx.beginPath();
            ctx.arc(sx, sy, 2.5, 0, Math.PI * 2);
            ctx.fillStyle = MKR_COLOR;
            ctx.fill();
            // Label
            if (m.label) {
                ctx.font = '10px Inter, system-ui, sans-serif';
                ctx.fillStyle = MKR_COLOR.replace('1)', '0.6)');
                ctx.fillText(m.label, sx + 8, sy + 3);
            }
        }

        animId = requestAnimationFrame(draw);
    }

    // Drag / rotate
    canvas.addEventListener('pointerdown', function (e) {
        drag = { active: true, startX: e.clientX, startY: e.clientY, startRotY: rotYAngle, startRotX: rotXAngle };
        canvas.setPointerCapture(e.pointerId);
        canvas.style.cursor = 'grabbing';
    });
    canvas.addEventListener('pointermove', function (e) {
        if (!drag.active) return;
        const dx = e.clientX - drag.startX;
        const dy = e.clientY - drag.startY;
        rotYAngle = drag.startRotY + dx * 0.005;
        rotXAngle = Math.max(-1, Math.min(1, drag.startRotX + dy * 0.005));
    });
    canvas.addEventListener('pointerup',   function () { drag.active = false; canvas.style.cursor = 'grab'; });
    canvas.addEventListener('pointerleave', function () { drag.active = false; canvas.style.cursor = 'grab'; });

    animId = requestAnimationFrame(draw);
})();
</script>

