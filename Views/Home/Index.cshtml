@* ══════════════════════════════════════════════════════
   FEATURES — Clean tab switcher
   ══════════════════════════════════════════════════════ *@
<section id="features" class="py-24">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12 fade-in">
            <h2 class="text-3xl font-semibold text-white tracking-tight">Everything you need for reliability</h2>
            <p class="text-sm font-normal text-[#8A8A93] text-center mt-3 max-w-md mx-auto">Powerful features built for modern engineering teams.</p>
        </div>

        <div class="grid lg:grid-cols-12 gap-6 fade-in">
            <!-- Left Tabs -->
            <div class="lg:col-span-4 space-y-1">
                <button onclick="switchFeatureTab(0)" class="tab-btn active w-full text-left rounded-xl px-4 py-3 hover:bg-white/4 transition-all" data-tab="0">
                    <div class="flex items-center gap-3">
                        <div class="tab-icon w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
                            <svg class="w-4 h-4 text-[#4A4A52]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
                        </div>
                        <div>
                            <h3 class="tab-title text-sm font-normal text-[#8A8A93]">Unified Dashboard</h3>
                            <p class="tab-sub text-xs font-normal text-[#4A4A52] mt-0.5 hidden">All your jobs in one view</p>
                        </div>
                    </div>
                </button>

                <button onclick="switchFeatureTab(1)" class="tab-btn w-full text-left rounded-xl px-4 py-3 hover:bg-white/4 transition-all" data-tab="1">
