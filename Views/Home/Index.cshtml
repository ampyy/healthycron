<!-- Everything You Need - Interactive Tabs -->
<section id="features" class="py-24 relative">
    <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-px bg-gradient-to-r from-transparent via-blue/50 to-transparent">
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 fade-in">
            <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Everything You Need for Reliability</h2>
            <p class="text-text-secondary max-w-2xl mx-auto">Powerful features built for modern engineering teams.</p>
        </div>

        <div class="grid lg:grid-cols-12 gap-8 fade-in">
            <!-- Left Tabs -->
            <div class="lg:col-span-4 space-y-3">
                <button onclick="switchFeatureTab(0)"
                    class="tab-btn active w-full text-left glass-card rounded-xl p-5 border-l-4 border-transparent hover:border-blue transition-all"
                    data-tab="0">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-blue/10 flex items-center justify-center flex-shrink-0">
                            <svg class="w-6 h-6 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-white">Unified Dashboard</h3>
                            <p class="text-sm text-text-secondary mt-1">All your jobs in one view</p>
                        </div>
                    </div>
                </button>

                <button onclick="switchFeatureTab(1)"
                    class="tab-btn w-full text-left glass-card rounded-xl p-5 border-l-4 border-transparent hover:border-blue transition-all"
                    data-tab="1">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-purple/10 flex items-center justify-center flex-shrink-0">
                            <svg class="w-6 h-6 text-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-white">Smart Alerts</h3>
                            <p class="text-sm text-text-secondary mt-1">Instant multi-channel notifications</p>
                        </div>
                    </div>
                </button>

                <button onclick="switchFeatureTab(2)"
                    class="tab-btn w-full text-left glass-card rounded-xl p-5 border-l-4 border-transparent hover:border-blue transition-all"
                    data-tab="2">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-blue/10 flex items-center justify-center flex-shrink-0">
                            <svg class="w-6 h-6 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-white">Detailed Logs</h3>
                            <p class="text-sm text-text-secondary mt-1">Full execution history & traces</p>
                        </div>
                    </div>
                </button>

                <button onclick="switchFeatureTab(3)"
                    class="tab-btn w-full text-left glass-card rounded-xl p-5 border-l-4 border-transparent hover:border-blue transition-all"
                    data-tab="3">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-purple/10 flex items-center justify-center flex-shrink-0">
                            <svg class="w-6 h-6 text-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-white">Status Pages</h3>
                            <p class="text-sm text-text-secondary mt-1">Public & internal status updates</p>
                        </div>
                    </div>
                </button>
            </div>

            <!-- Right Content Area -->
            <div class="lg:col-span-8">
                <div class="glass-card rounded-2xl p-2 h-full">
                    <div id="feature-content" class="relative">
                        <div class="feature-image active" data-content="0">
                            <img src="/images/dashboard.png"
                                alt="Dashboard Overview" class="w-full rounded-xl">
                            <div
                                class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-navy to-transparent rounded-b-xl">
                                <h4 class="text-lg font-semibold text-white mb-2">Real-Time Dashboard</h4>
                                <p class="text-sm text-text-secondary">Monitor all your cron jobs, heartbeats, and
                                    scheduled tasks from a single unified interface with live status updates.</p>
                            </div>
                        </div>

                        <div class="feature-image absolute inset-0" data-content="1">
                            <img src="https://images.unsplash.com/photo-1563986768609-322da13575f3?w=900&q=80"
                                alt="Alert System" class="w-full rounded-xl">
                            <div
                                class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-navy to-transparent rounded-b-xl">
                                <h4 class="text-lg font-semibold text-white mb-2">Intelligent Alerting</h4>
                                <p class="text-sm text-text-secondary">Get notified via Slack, Email, PagerDuty,
                                    Discord, or custom webhooks the moment something goes wrong.</p>
                            </div>
                        </div>

                        <div class="feature-image absolute inset-0" data-content="2">
                            <img src="/images/logs.png"
                                alt="Execution Logs" class="w-full rounded-xl">
                            <div
                                class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-navy to-transparent rounded-b-xl">
                                <h4 class="text-lg font-semibold text-white mb-2">Complete Audit Trail</h4>
                                <p class="text-sm text-text-secondary">Access detailed execution logs, error traces, and
                                    performance metrics for every job run in your system.</p>
                            </div>
                        </div>

                        <div class="feature-image absolute inset-0" data-content="3">
                            <img src="/images/status.png"
                                alt="Status Page" class="w-full rounded-xl">
                            <div
                                class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-navy to-transparent rounded-b-xl">
                                <h4 class="text-lg font-semibold text-white mb-2">Public Status Pages</h4>
                                <p class="text-sm text-text-secondary">Share real-time status updates with your team or
                                    customers through customizable public and internal status pages.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

