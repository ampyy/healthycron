@* ══════════════════════════════════════════════════════
   FEATURES — Clean tab switcher
   ══════════════════════════════════════════════════════ *@
<section id="features" class="py-24">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12 fade-in">
            <h2 class="text-3xl font-semibold text-white tracking-tight">Everything you need for reliability</h2>
