                        </div>
                        <div>
                            <h3 class="tab-title text-sm font-normal text-[#8A8A93]">Smart Alerts</h3>
                            <p class="tab-sub text-xs font-normal text-[#4A4A52] mt-0.5 hidden">Instant multi-channel notifications</p>
                        </div>
                    </div>
                </button>

                <button onclick="switchFeatureTab(2)" class="tab-btn w-full text-left rounded-xl px-4 py-3 hover:bg-white/4 transition-all" data-tab="2">
                    <div class="flex items-center gap-3">
                        <div class="tab-icon w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
                            <svg class="w-4 h-4 text-[#4A4A52]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" /></svg>
                        </div>
                        <div>
                            <h3 class="tab-title text-sm font-normal text-[#8A8A93]">Detailed Logs</h3>
                            <p class="tab-sub text-xs font-normal text-[#4A4A52] mt-0.5 hidden">Full execution history &amp; traces</p>
                        </div>
                    </div>
                </button>

                <button onclick="switchFeatureTab(3)" class="tab-btn w-full text-left rounded-xl px-4 py-3 hover:bg-white/4 transition-all" data-tab="3">
