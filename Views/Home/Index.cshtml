@{
    ViewData["Title"] = "Cron & Heartbeat Monitoring Reimagined";
}

@* Hero Section *@
<section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-gradient-animated">
    <div class="absolute top-1/4 left-10 w-72 h-72 bg-blue/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 right-10 w-96 h-96 bg-purple/10 rounded-full blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            <div class="text-center lg:text-left">
                <div
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-navy-light border border-border-color mb-6">
                    <span class="w-2 h-2 rounded-full bg-green-400 pulse-dot"></span>
                    <span class="text-sm text-text-secondary">99.99% Uptime Guaranteed</span>
                </div>

                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
                    <span class="text-white">Cron & Background Job</span><br>
                    <span class="gradient-text">Monitoring. Simplified.</span>
                </h1>

                <p class="text-lg text-text-secondary mb-8 max-w-xl mx-auto lg:mx-0">
                    Never miss a job run. Monitor cron, heartbeats, queues, and background workers in real-time — with logs, alerts, and performance insights built for engineering teams.
                </p>

                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="/signup" class="glow-btn px-8 py-4 rounded-xl text-base font-semibold text-white">
                        Signup
                    </a>
                    <button disabled
                        class="px-8 py-4 rounded-xl text-base font-medium text-white bg-navy-light border border-border-color cursor-not-allowed opacity-70 flex items-center justify-center gap-2">
                        Talk to Sales
                    </button>
                </div>
            </div>

            <!-- Dashboard Mockup with Image -->
            <div class="relative">
                <div class="glass-card rounded-2xl overflow-hidden">
                    <img src="/images/dashboard.png"
                        alt="HealthyCron Dashboard" class="w-full h-auto opacity-90">
                    <div class="absolute inset-0 bg-gradient-to-t from-navy via-transparent to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-6">
                        <div class="grid grid-cols-3 gap-3">
                            <div class="bg-navy-light/80 backdrop-blur rounded-lg p-3">
                                <p class="text-xs text-text-secondary">Active Jobs</p>
                                <p class="text-xl font-bold text-white">247</p>
                            </div>
                            <div class="bg-navy-light/80 backdrop-blur rounded-lg p-3">
                                <p class="text-xs text-text-secondary">Success Rate</p>
                                <p class="text-xl font-bold text-green-400">99.8%</p>
                            </div>
                            <div class="bg-navy-light/80 backdrop-blur rounded-lg p-3">
                                <p class="text-xs text-text-secondary">Alerts Today</p>
                                <p class="text-xl font-bold text-blue">3</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="absolute -bottom-4 -left-4 glass-card rounded-xl p-4 border-l-4 border-blue animate-bounce"
                    style="animation-duration: 3s;">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-blue/20 flex items-center justify-center">
                            <svg class="w-5 h-5 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-white">Alert Sent</p>
                            <p class="text-xs text-text-secondary">Slack + PagerDuty</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

