@{
    ViewData["Title"] = "Cron & Heartbeat Monitoring Reimagined";
}

@* ══════════════════════════════════════════════════════
   HERO SECTION
   ══════════════════════════════════════════════════════ *@
<section class="relative pt-32 pb-20 overflow-hidden px-6" style="background-color:#0A0A0B; background-image:radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px); background-size:32px 32px;">

    <div class="max-w-5xl mx-auto">
        <div class="w-full max-w-6xl flex flex-col md:flex-row gap-16 items-center">

            <!-- Left: Text -->
            <div class="flex-1 flex flex-col justify-center">

                <!-- Status badge -->
                <div class="inline-flex items-center gap-2 text-xs font-medium text-[#22C55E] bg-[#22C55E]/8 border border-[#22C55E]/20 rounded-full px-3 py-1 mb-8 w-fit">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#22C55E] animate-pulse"></span>
                    All systems operational
                </div>

                <h1 class="text-5xl font-semibold text-white leading-tight tracking-tight mb-4">
                    Never miss a failing<br>
                    <span class="text-[#22C55E]">cron job again.</span>
                </h1>

                <p class="text-base font-normal text-[#8A8A93] leading-relaxed max-w-lg mb-8">
                    Monitor cron jobs, heartbeats, queues, and background workers in real-time — with logs, alerts, and performance insights built for engineering teams.
                </p>

                <!-- CTA Buttons -->
                <div class="flex flex-col sm:flex-row gap-3 mb-12">
                    <a href="/signup" class="bg-white text-[#0A0A0B] font-medium text-sm rounded-lg px-5 py-2.5 hover:bg-white/90 transition-all text-center">
                        Get Started Free
                    </a>
                    <a href="/docs" class="text-sm font-normal text-[#8A8A93] hover:text-white px-5 py-2.5 transition-colors">
                        View Docs →
                    </a>
                </div>

                <!-- Stats row — no box, just inline -->
                <div class="flex items-center gap-8">
                    <div>
                        <p class="font-mono text-2xl font-medium text-white">150+</p>
                        <p class="text-xs font-normal text-[#8A8A93] mt-1">Edge Nodes</p>
                    </div>
                    <span class="text-[#4A4A52] text-lg">·</span>
                    <div>
                        <p class="font-mono text-2xl font-medium text-white">&lt;50ms</p>
                        <p class="text-xs font-normal text-[#8A8A93] mt-1">Avg Latency</p>
                    </div>
                    <span class="text-[#4A4A52] text-lg">·</span>
                    <div>
                        <p class="font-mono text-2xl font-medium text-white">99.99%</p>
                        <p class="text-xs font-normal text-[#8A8A93] mt-1">Uptime SLA</p>
                    </div>
                </div>
            </div>

            <!-- Right: Terminal mockup -->
            <div class="flex-1 flex items-center justify-center relative">
                <div class="w-full max-w-md bg-[#0D0D0F] border border-white/6 rounded-xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] relative z-10">
                    <!-- Terminal title bar — filename only, no traffic lights -->
                    <div class="flex items-center px-4 py-3 border-b border-white/5 bg-[#0A0A0B]">
                        <span class="font-mono text-xs text-[#4A4A52]">cron-monitor.sh</span>
                    </div>
                    <!-- Terminal body -->
                    <div class="p-5 font-mono text-xs leading-7">
                        <div class="text-[#4A4A52]"># 1. signal job start</div>
                        <div>
                            <span class="text-[#F2F2F2]">curl</span>
                            <span class="text-[#8A8A93]"> -sf https://healthycron.com/ping/</span><span class="text-[#22C55E]">a3f8b2c1</span><span class="text-[#F59E0B]">/start</span>
                        </div>
                        <div class="mt-3 text-[#4A4A52]"># 2. run your job</div>
                        <div class="text-[#F2F2F2]">php artisan send:invoices</div>
                        <div class="mt-3 text-[#4A4A52]"># 3. signal success (or failure)</div>
                        <div>
                            <span class="text-[#F2F2F2]">curl</span>
                            <span class="text-[#8A8A93]"> -sf https://healthycron.com/ping/</span><span class="text-[#22C55E]">a3f8b2c1</span>
                        </div>
                        <div>
                            <span class="text-[#4A4A52]"># on error: </span>
                            <span class="text-[#F2F2F2]">curl</span>
                            <span class="text-[#8A8A93]"> -sf ...ping/</span><span class="text-[#22C55E]">a3f8b2c1</span><span class="text-[#E03E2D]">/fail</span>
                        </div>

                        <!-- Live status indicator -->
                        <div class="mt-5 pt-4 border-t border-white/5 space-y-2">
                            <div class="text-[#4A4A52]"># live status ─────────────────────────</div>
                            <div class="flex items-center gap-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#22C55E] animate-pulse flex-shrink-0"></span>
                                <span class="text-[#F2F2F2] w-28">backup-db</span>
                                <span class="text-[#4A4A52]">· last ping 2m ago   ·</span>
                                <span class="text-[#22C55E]">healthy</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#E03E2D] flex-shrink-0"></span>
                                <span class="text-[#F2F2F2] w-28">sync-reports</span>
                                <span class="text-[#4A4A52]">· missed schedule    ·</span>
                                <span class="text-[#E03E2D]">down</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#F59E0B] flex-shrink-0"></span>
                                <span class="text-[#F2F2F2] w-28">cleanup-cache</span>
                                <span class="text-[#4A4A52]">· due in 4m          ·</span>
                                <span class="text-[#F59E0B]">late</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

