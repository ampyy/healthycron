@{
    ViewData["Title"] = "Cron & Heartbeat Monitoring Reimagined";
}

@* ══════════════════════════════════════════════════════
   HERO SECTION
   ══════════════════════════════════════════════════════ *@
<section class="relative pt-32 pb-20 overflow-hidden px-6" style="background-color:#0A0A0B; background-image:radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px); background-size:32px 32px;">

    <div class="max-w-5xl mx-auto">
        <div class="w-full max-w-6xl flex flex-col md:flex-row gap-16 items-center">

            <!-- Left: Text -->
            <div class="flex-1 flex flex-col justify-center">

                <!-- Status badge -->
                <div class="inline-flex items-center gap-2 text-xs font-medium text-[#22C55E] bg-[#22C55E]/8 border border-[#22C55E]/20 rounded-full px-3 py-1 mb-8 w-fit">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#22C55E] animate-pulse"></span>
                    All systems operational
                </div>

                <h1 class="text-5xl font-semibold text-white leading-tight tracking-tight mb-4">
                    Never miss a failing<br>
                    <span class="bg-gradient-to-r from-indigo-400 via-purple-400 to-cyan-400 bg-clip-text text-transparent drop-shadow-sm">cron job again.</span>
                </h1>

                <p class="text-base font-normal text-[#8A8A93] leading-relaxed max-w-lg mb-8">
                    Monitor cron jobs, heartbeats, queues, and background workers in real-time — with logs, alerts, and performance insights built for engineering teams.
                </p>

                <!-- CTA Buttons -->
                <div class="flex flex-col sm:flex-row gap-3 mb-12">
                    <a href="/signup" class="bg-indigo-600 text-white font-medium text-sm rounded-lg px-5 py-2.5 hover:bg-indigo-500 transition-all text-center shadow-[0_0_20px_rgba(79,70,229,0.3)] border border-indigo-500 overflow-hidden relative group">
                        <span class="relative z-10">Get Started Free</span>
                    </a>
                    <a href="/docs" class="font-medium text-sm text-[#8A8A93] hover:text-white px-5 py-2.5 transition-colors">
                        View Docs →
                    </a>
                </div>

                <!-- Stats row -->
                <div class="bg-[#111114] border border-white/6 rounded-xl px-6 py-5 grid grid-cols-3 divide-x divide-white/6">
                    <div class="pr-6">
                        <p class="font-mono text-xl font-medium text-white">150+</p>
                        <p class="text-xs font-normal text-[#8A8A93] mt-1">Edge Nodes</p>
                    </div>
                    <div class="px-6">
                        <p class="font-mono text-xl font-medium text-white">&lt;50ms</p>
                        <p class="text-xs font-normal text-[#8A8A93] mt-1">Avg Latency</p>
                    </div>
                    <div class="pl-6">
                        <p class="font-mono text-xl font-medium text-white">99.99%</p>
                        <p class="text-xs font-normal text-[#8A8A93] mt-1">Uptime SLA</p>
                    </div>
                </div>
            </div>

            <!-- Right: Terminal mockup -->
            <div class="flex-1 flex items-center justify-center relative">
                <!-- Ambient Glow -->
                <div class="absolute inset-0 bg-gradient-to-tr from-indigo-600/20 via-purple-600/10 to-transparent blur-[80px] rounded-full scale-150 transform -translate-y-8"></div>
                
                <div class="w-full max-w-md bg-[#111114] border border-white/8 rounded-xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] relative z-10 ring-1 ring-white/5">
                    <!-- Terminal title bar -->
                    <div class="flex items-center gap-2 px-4 py-3 border-b border-white/6 bg-[#0A0A0B]">
                        <span class="w-3 h-3 rounded-full bg-[#E03E2D]/70"></span>
                        <span class="w-3 h-3 rounded-full bg-[#F59E0B]/50"></span>
                        <span class="w-3 h-3 rounded-full bg-[#22C55E]/50"></span>
                        <span class="ml-2 text-xs font-mono text-[#4A4A52]">cron-monitor.sh</span>
                    </div>
                    <!-- Terminal body -->
                    <div class="p-5 font-mono text-xs leading-7 space-y-1">
                        <div class="text-[#4A4A52]"># ping on successful run</div>
                        <div>
                            <span class="text-[#22C55E]">curl</span>
                            <span class="text-[#8A8A93]"> -sf </span>
                            <span class="text-white">https://healthycron.com/ping/</span><span class="text-[#22C55E]">a3f8b2c1</span>
                        </div>
                        <div class="text-[#4A4A52] mt-2"># signal start of job</div>
                        <div>
                            <span class="text-[#22C55E]">curl</span>
                            <span class="text-[#8A8A93]"> -sf </span>
                            <span class="text-white">https://healthycron.com/ping/</span><span class="text-[#22C55E]">a3f8b2c1</span><span class="text-[#8A8A93]">/start</span>
                        </div>
                        <div class="text-[#4A4A52] mt-2"># signal failure</div>
                        <div>
                            <span class="text-[#22C55E]">curl</span>
                            <span class="text-[#8A8A93]"> -sf </span>
                            <span class="text-white">https://healthycron.com/ping/</span><span class="text-[#22C55E]">a3f8b2c1</span><span class="text-[#E03E2D]">/fail</span>
                        </div>
                        <!-- Live status indicator -->
                        <div class="flex items-center gap-2 pt-4 mt-2 border-t border-white/6">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#22C55E] animate-pulse"></span>
                            <span class="text-[#22C55E]">backup-db</span>
                            <span class="text-[#4A4A52]">·</span>
                            <span class="text-[#8A8A93]">last ping 2m ago</span>
                            <span class="text-[#4A4A52]">·</span>
                            <span class="text-[#22C55E]">healthy</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#E03E2D] animate-pulse"></span>
                            <span class="text-[#E03E2D]">sync-reports</span>
                            <span class="text-[#4A4A52]">·</span>
                            <span class="text-[#8A8A93]">missed schedule</span>
                            <span class="text-[#4A4A52]">·</span>
                            <span class="text-[#E03E2D]">down</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#F59E0B]"></span>
                            <span class="text-[#F59E0B]">cleanup-cache</span>
                            <span class="text-[#4A4A52]">·</span>
                            <span class="text-[#8A8A93]">due in 4m</span>
                            <span class="text-[#4A4A52]">·</span>
                            <span class="text-[#F59E0B]">late</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

