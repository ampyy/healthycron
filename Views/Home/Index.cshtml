                    </div>
                </button>
            </div>

            <!-- Right Content Area -->
            <div class="lg:col-span-8">
                <div class="bg-[#111114] rounded-xl overflow-hidden shadow-2xl h-full">
                    <div id="feature-content" class="relative min-h-[280px]">
                        <div class="feature-image active" data-content="0">
                            <img src="/images/dashboard.png" alt="Dashboard Overview" class="w-full rounded-t-xl">
