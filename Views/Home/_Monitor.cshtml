@* What Can You Monitor — card-grid style with image cards *@
<section id="monitor" class="py-24 relative overflow-hidden bg-black">

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Header -->
        <div class="mb-12 fade-in">
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
                What You Can Monitor
            </h2>
            <p class="mt-3 text-[#737373] max-w-lg">
                From cron jobs to database tasks — every type of scheduled work, covered.
            </p>
        </div>

        <!-- Card Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 fade-in">

            <!-- Cron Jobs -->
            <a href="#" class="group block overflow-hidden rounded-2xl bg-[#111111] border border-[#1a1a1a] hover:border-[#333333] transition-all duration-300">
                <div class="overflow-hidden bg-[#0a0a0a] h-44 flex items-center justify-center">
                    <img src="https://images.unsplash.com/photo-1555949963-ff9fe0c870eb?w=600&auto=format&fit=crop&q=60"
                        alt="Cron Jobs"
                        class="w-full h-full object-cover opacity-60 group-hover:opacity-80 group-hover:scale-105 transition-all duration-500">
                </div>
                <div class="p-5">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="inline-block w-2 h-2 rounded-full bg-white"></span>
                        <span class="text-[10px] font-bold uppercase tracking-widest text-[#525252]">Scheduled</span>
                    </div>
                    <h3 class="text-base font-semibold text-white mb-2">Cron Jobs</h3>
                    <p class="text-sm text-[#737373] leading-relaxed">Auto-monitor any cron expression — daily reports, cleanups, or data syncs.</p>
                    <div class="flex items-center text-sm font-medium text-white mt-4">
                        Learn more
                        <svg class="ml-2 w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                </div>
            </a>

