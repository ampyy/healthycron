@* What Can You Monitor — icon-based cards, no stock photography *@
<section id="monitor" class="py-24">
    <div class="max-w-5xl mx-auto px-6">

        <!-- Header -->
        <div class="mb-12 fade-in">
            <h2 class="text-3xl font-semibold text-white tracking-tight">What You Can Monitor</h2>
            <p class="text-sm font-normal text-[#8A8A93] mt-3 max-w-md leading-relaxed">
                From cron jobs to database tasks — every type of scheduled work, covered.
            </p>
        </div>

        <!-- Card Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 fade-in">

            <!-- Cron Jobs -->
            <a href="#" class="group block bg-[#111114] border border-white/6 rounded-xl p-6 hover:border-white/12 transition-colors duration-200">
                <svg class="w-10 h-10 text-indigo-400 bg-indigo-500/10 p-2 rounded-lg mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <p class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] mb-2">Scheduled</p>
                <h3 class="text-base font-semibold text-white mt-1">Cron Jobs</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Auto-monitor any cron expression — daily reports, cleanups, or data syncs.</p>
                <span class="inline-flex items-center gap-1 text-xs font-medium text-[#8A8A93] group-hover:text-white mt-4 transition-colors">Learn more <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
            </a>

            <!-- Heartbeats -->
            <a href="#" class="group block bg-[#111114] border border-white/6 rounded-xl p-6 hover:border-white/12 transition-colors duration-200">
                <svg class="w-10 h-10 text-rose-400 bg-rose-500/10 p-2 rounded-lg mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                <p class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] mb-2">Health</p>
                <h3 class="text-base font-semibold text-white mt-1">Heartbeats</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Ping us on a schedule. If we stop hearing from you, we alert your team immediately.</p>
                <span class="inline-flex items-center gap-1 text-xs font-medium text-[#8A8A93] group-hover:text-white mt-4 transition-colors">Learn more <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
            </a>

            <!-- Queue Workers -->
            <a href="#" class="group block bg-[#111114] border border-white/6 rounded-xl p-6 hover:border-white/12 transition-colors duration-200">
                <svg class="w-10 h-10 text-amber-400 bg-amber-500/10 p-2 rounded-lg mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                <p class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] mb-2">Workers</p>
                <h3 class="text-base font-semibold text-white mt-1">Queue Workers</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Know when your background processors stall, fall behind, or stop processing.</p>
                <span class="inline-flex items-center gap-1 text-xs font-medium text-[#8A8A93] group-hover:text-white mt-4 transition-colors">Learn more <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
            </a>

            <!-- Background Jobs -->
            <a href="#" class="group block bg-[#111114] border border-white/6 rounded-xl p-6 hover:border-white/12 transition-colors duration-200">
                <svg class="w-10 h-10 text-emerald-400 bg-emerald-500/10 p-2 rounded-lg mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                <p class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] mb-2">Background</p>
                <h3 class="text-base font-semibold text-white mt-1">Background Jobs</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Track long-running processes across distributed systems with start/finish signals.</p>
                <span class="inline-flex items-center gap-1 text-xs font-medium text-[#8A8A93] group-hover:text-white mt-4 transition-colors">Learn more <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
            </a>

            <!-- Scheduled APIs -->
            <a href="#" class="group block bg-[#111114] border border-white/6 rounded-xl p-6 hover:border-white/12 transition-colors duration-200">
                <svg class="w-10 h-10 text-cyan-400 bg-cyan-500/10 p-2 rounded-lg mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                <p class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] mb-2">API</p>
                <h3 class="text-base font-semibold text-white mt-1">Scheduled APIs</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Ensure your webhook triggers, polling jobs, and API callers run on time, every time.</p>
                <span class="inline-flex items-center gap-1 text-xs font-medium text-[#8A8A93] group-hover:text-white mt-4 transition-colors">Learn more <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
            </a>

            <!-- Database Tasks -->
            <a href="#" class="group block bg-[#111114] border border-white/6 rounded-xl p-6 hover:border-white/12 transition-colors duration-200">
                <svg class="w-10 h-10 text-purple-400 bg-purple-500/10 p-2 rounded-lg mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>
                <p class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] mb-2">Database</p>
                <h3 class="text-base font-semibold text-white mt-1">Database Tasks</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Monitor backups, vacuum runs, index rebuilds and other scheduled database maintenance.</p>
                <span class="inline-flex items-center gap-1 text-xs font-medium text-[#8A8A93] group-hover:text-white mt-4 transition-colors">Learn more <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
            </a>

        </div>
    </div>
</section>
