@* What Can You Monitor — colored icon badges per card *@
<section id="monitor" class="py-24">
    <div class="max-w-5xl mx-auto px-6">

        <!-- Header -->
        <div class="mb-12 fade-in">
            <h2 class="text-3xl font-semibold text-white tracking-tight">What You Can Monitor</h2>
            <p class="text-sm font-normal text-[#8A8A93] mt-3 max-w-md leading-relaxed">
                From cron jobs to database tasks — every type of scheduled work, covered.
            </p>
        </div>

        <!-- Card Grid — colored icon badges, no borders -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 fade-in">

            <!-- Cron Jobs — green (scheduled/automation) -->
            <a href="#" class="group block bg-[#111114] rounded-2xl p-6 hover:ring-1 hover:ring-white/8 transition-all duration-200">
                <div class="w-10 h-10 rounded-xl bg-[#22C55E]/10 flex items-center justify-center mb-4">
                    <svg class="w-5 h-5 text-[#22C55E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
                <p class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] mb-2">Scheduled</p>
                <h3 class="text-base font-semibold text-white mt-1">Cron Jobs</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Auto-monitor any cron expression — daily reports, cleanups, or data syncs.</p>
                <span class="text-xs font-medium text-[#22C55E] group-hover:text-[#22C55E]/80 mt-4 flex items-center gap-1 transition-colors">Learn more <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
            </a>

            <!-- Heartbeats — red (health/pulse) -->
            <a href="#" class="group block bg-[#111114] rounded-2xl p-6 hover:ring-1 hover:ring-white/8 transition-all duration-200">
                <div class="w-10 h-10 rounded-xl bg-[#E03E2D]/10 flex items-center justify-center mb-4">
                    <svg class="w-5 h-5 text-[#E03E2D]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                </div>
                <p class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] mb-2">Health</p>
                <h3 class="text-base font-semibold text-white mt-1">Heartbeats</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Ping us on a schedule. If we stop hearing from you, we alert your team immediately.</p>
                <span class="text-xs font-medium text-[#E03E2D] group-hover:text-[#E03E2D]/80 mt-4 flex items-center gap-1 transition-colors">Learn more <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
            </a>

            <!-- Queue Workers — amber (processing/queues) -->
            <a href="#" class="group block bg-[#111114] rounded-2xl p-6 hover:ring-1 hover:ring-white/8 transition-all duration-200">
                <div class="w-10 h-10 rounded-xl bg-[#F59E0B]/10 flex items-center justify-center mb-4">
                    <svg class="w-5 h-5 text-[#F59E0B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                </div>
                <p class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] mb-2">Workers</p>
                <h3 class="text-base font-semibold text-white mt-1">Queue Workers</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Know when your background processors stall, fall behind, or stop processing.</p>
                <span class="text-xs font-medium text-[#F59E0B] group-hover:text-[#F59E0B]/80 mt-4 flex items-center gap-1 transition-colors">Learn more <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
            </a>

            <!-- Background Jobs — purple (background/distributed) -->
            <a href="#" class="group block bg-[#111114] rounded-2xl p-6 hover:ring-1 hover:ring-white/8 transition-all duration-200">
                <div class="w-10 h-10 rounded-xl bg-[#7C3AED]/10 flex items-center justify-center mb-4">
                    <svg class="w-5 h-5 text-[#7C3AED]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                </div>
                <p class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] mb-2">Background</p>
                <h3 class="text-base font-semibold text-white mt-1">Background Jobs</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Track long-running processes across distributed systems with start/finish signals.</p>
                <span class="text-xs font-medium text-[#7C3AED] group-hover:text-[#7C3AED]/80 mt-4 flex items-center gap-1 transition-colors">Learn more <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
            </a>

            <!-- Scheduled APIs — blue (API/link) -->
            <a href="#" class="group block bg-[#111114] rounded-2xl p-6 hover:ring-1 hover:ring-white/8 transition-all duration-200">
                <div class="w-10 h-10 rounded-xl bg-[#3B82F6]/10 flex items-center justify-center mb-4">
                    <svg class="w-5 h-5 text-[#3B82F6]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                </div>
                <p class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] mb-2">API</p>
                <h3 class="text-base font-semibold text-white mt-1">Scheduled APIs</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Ensure your webhook triggers, polling jobs, and API callers run on time, every time.</p>
                <span class="text-xs font-medium text-[#3B82F6] group-hover:text-[#3B82F6]/80 mt-4 flex items-center gap-1 transition-colors">Learn more <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
            </a>

            <!-- Database Tasks — cyan (data storage) -->
            <a href="#" class="group block bg-[#111114] rounded-2xl p-6 hover:ring-1 hover:ring-white/8 transition-all duration-200">
                <div class="w-10 h-10 rounded-xl bg-[#06B6D4]/10 flex items-center justify-center mb-4">
                    <svg class="w-5 h-5 text-[#06B6D4]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>
                </div>
                <p class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] mb-2">Database</p>
                <h3 class="text-base font-semibold text-white mt-1">Database Tasks</h3>
                <p class="text-sm font-normal text-[#8A8A93] leading-relaxed mt-2">Monitor backups, vacuum runs, index rebuilds and other scheduled database maintenance.</p>
                <span class="text-xs font-medium text-[#06B6D4] group-hover:text-[#06B6D4]/80 mt-4 flex items-center gap-1 transition-colors">Learn more <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
            </a>

        </div>
    </div>
</section>
