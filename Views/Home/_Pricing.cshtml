<script>
    var isYearly = false;

    function toggleBilling() {
        isYearly = !isYearly;
        var toggle = document.getElementById('billing-toggle');
        var thumb = document.getElementById('billing-thumb');
        var monthlyLabel = document.getElementById('billing-monthly-label');
        var yearlyLabel = document.getElementById('billing-yearly-label');

        toggle.setAttribute('aria-checked', isYearly.toString());

        if (isYearly) {
            thumb.style.transform = 'translateX(20px)';
            toggle.style.backgroundColor = '#4F94FF';
            monthlyLabel.style.color = '#8B949E';
            yearlyLabel.style.color = '#FFFFFF';
        } else {
            thumb.style.transform = 'translateX(0px)';
            toggle.style.backgroundColor = '#30363D';
            monthlyLabel.style.color = '#FFFFFF';
            yearlyLabel.style.color = '#8B949E';
        }

        document.querySelectorAll('.price-display').forEach(function(el) {
            el.textContent = isYearly ? el.dataset.yearly : el.dataset.monthly;
        });
        document.querySelectorAll('.billing-note').forEach(function(el) {
            el.textContent = isYearly ? el.dataset.yearly : el.dataset.monthly;
        });
    }
</script>
