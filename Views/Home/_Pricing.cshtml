                onclick="toggleBilling()"
                class="relative w-11 h-6 rounded-full bg-hc-border border-2 border-transparent transition-colors duration-200 focus:outline-none"
                role="switch" aria-checked="false">
                <span id="billing-thumb"
                    class="block w-4 h-4 rounded-full bg-white shadow transition-transform duration-200 translate-x-0"></span>
            </button>
            <span id="billing-yearly-label" class="text-sm font-medium text-hc-dim">Yearly <span class="text-hc-green text-xs font-semibold">Save 25%</span></span>
        </div>

