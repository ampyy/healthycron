@* Contact — accent colors added *@
<section id="contact" class="py-20">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12 fade-in">
            <h2 class="text-3xl font-semibold text-white tracking-tight">Get in touch</h2>
            <p class="text-sm font-normal text-[#8A8A93] text-center mt-3 max-w-sm mx-auto">Questions, feedback, or need help? We respond within 1 business day.</p>
        </div>

        <div class="max-w-xl mx-auto fade-in">
            <!-- Contact methods — colored icons -->
            <div class="grid grid-cols-2 gap-3 mb-10">
                <a href="mailto:team@healthycron.com" class="bg-[#111114] rounded-xl p-4 flex items-center gap-3 hover:bg-[#16161A] transition-colors group">
                    <div class="w-9 h-9 rounded-xl bg-[#EA4335]/10 flex items-center justify-center flex-shrink-0">
                        <svg class="w-4 h-4 text-[#EA4335]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-white group-hover:text-[#EA4335] transition-colors">Email</p>
                        <p class="text-xs text-[#8A8A93]">team@healthycron.com</p>
                    </div>
                </a>
                <a href="https://wa.me/917906524297" target="_blank" class="bg-[#111114] rounded-xl p-4 flex items-center gap-3 hover:bg-[#16161A] transition-colors group">
                    <div class="w-9 h-9 rounded-xl bg-[#25D366]/10 flex items-center justify-center flex-shrink-0">
                        <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-white group-hover:text-[#25D366] transition-colors">WhatsApp</p>
                        <p class="text-xs text-[#8A8A93]">+91 79065 24297</p>
                    </div>
                </a>
            </div>

            <!-- Form -->
            <form id="contactForm" class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-medium text-[#8A8A93]">Name</label>
                        <input type="text" placeholder="Your name"
                            class="w-full bg-[#111114] border-none rounded-lg px-3 py-2.5 text-sm text-white font-normal placeholder:text-[#4A4A52] focus:outline-none focus:ring-1 focus:ring-[#22C55E]/30 transition-all">
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-medium text-[#8A8A93]">Email</label>
                        <input type="email" placeholder="you@company.com"
                            class="w-full bg-[#111114] border-none rounded-lg px-3 py-2.5 text-sm text-white font-normal placeholder:text-[#4A4A52] focus:outline-none focus:ring-1 focus:ring-[#22C55E]/30 transition-all">
                    </div>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-medium text-[#8A8A93]">Message</label>
                    <textarea rows="4" placeholder="Tell us how we can help..."
                        class="w-full bg-[#111114] border-none rounded-lg px-3 py-2.5 text-sm text-white font-normal placeholder:text-[#4A4A52] focus:outline-none focus:ring-1 focus:ring-[#22C55E]/30 transition-all resize-none"></textarea>
                </div>
                <div class="flex justify-center pt-2">
                    <button type="button" id="contactSubmitBtn"
                        class="bg-white text-[#0A0A0B] font-medium text-sm rounded-lg px-6 py-2.5 hover:bg-white/90 transition-all flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                        Send Message
                    </button>
                </div>
                <div id="contactSuccess" class="hidden text-center py-2 text-xs text-[#22C55E] flex items-center justify-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    Message sent! We'll get back to you soon.
                </div>
            </form>
        </div>
    </div>
</section>

<script>
    document.getElementById('contactSubmitBtn').addEventListener('click', function() {
        var btn = this;
        btn.textContent = 'Sending...';
        btn.disabled = true;
        setTimeout(function() {
            document.getElementById('contactSuccess').classList.remove('hidden');
            btn.textContent = 'Sent!';
        }, 800);
    });
</script>
