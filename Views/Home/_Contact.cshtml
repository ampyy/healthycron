@* Contact Section — contact-card style *@
<section id="contact" class="py-24 relative overflow-hidden">

    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 80% 50% at 50% 100%, rgba(91,142,255,0.05) 0%, transparent 70%)"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14 fade-in">
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">Get in touch</h2>
            <p class="text-[#94A3B8] max-w-xl mx-auto">Have questions or need help? Fill out the form and we'll get back to you within 1 business day.</p>
        </div>

        <!-- Contact card: left info + right form -->
        <div class="relative grid md:grid-cols-3 border border-[#1E293B] rounded-2xl overflow-hidden bg-[#0E1420] fade-in">

            <!-- Corner plus markers -->
            <div class="absolute -top-2.5 -left-2.5 w-5 h-5 text-[#1E293B]">
                <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9 0h2v20H9zM0 9h20v2H0z"/></svg>
            </div>
            <div class="absolute -top-2.5 -right-2.5 w-5 h-5 text-[#1E293B]">
                <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9 0h2v20H9zM0 9h20v2H0z"/></svg>
            </div>
            <div class="absolute -bottom-2.5 -left-2.5 w-5 h-5 text-[#1E293B]">
                <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9 0h2v20H9zM0 9h20v2H0z"/></svg>
            </div>
            <div class="absolute -bottom-2.5 -right-2.5 w-5 h-5 text-[#1E293B]">
                <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9 0h2v20H9zM0 9h20v2H0z"/></svg>
            </div>

            <!-- Left: Info (spans 2 cols on lg) -->
            <div class="md:col-span-2 p-8 lg:p-12 border-b md:border-b-0 md:border-r border-[#1E293B] flex flex-col justify-between">
                <div>
                    <h3 class="text-2xl lg:text-3xl font-bold text-white mb-4">Contact With Us</h3>
                    <p class="text-[#94A3B8] text-sm lg:text-base max-w-lg mb-10">
                        If you have any questions regarding our Services or need help, please fill out the form here. We do our best to respond within 1 business day.
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <!-- Email -->
                        <div class="flex items-center gap-3 py-3">
                            <div class="w-10 h-10 rounded-lg bg-[#141B27] border border-[#1E293B] flex items-center justify-center flex-shrink-0">
                                <svg class="w-4 h-4 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-white">Email</p>
                                <p class="text-xs text-[#94A3B8]">hello@healthycron.com</p>
                            </div>
                        </div>
                        <!-- Twitter/X -->
                        <div class="flex items-center gap-3 py-3">
                            <div class="w-10 h-10 rounded-lg bg-[#141B27] border border-[#1E293B] flex items-center justify-center flex-shrink-0">
                                <svg class="w-4 h-4 text-purple" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-white">Twitter / X</p>
                                <p class="text-xs text-[#94A3B8]">@@healthycron</p>
                            </div>
                        </div>
                        <!-- Discord -->
                        <div class="flex items-center gap-3 py-3 sm:col-span-1">
                            <div class="w-10 h-10 rounded-lg bg-[#141B27] border border-[#1E293B] flex items-center justify-center flex-shrink-0">
                                <svg class="w-4 h-4 text-[#5865F2]" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-white">Discord</p>
                                <p class="text-xs text-[#94A3B8]">discord.gg/healthycron</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Form -->
            <div class="md:col-span-1 p-8 flex items-start">
                <form id="contactForm" class="w-full space-y-4">
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-medium text-white/70">Name</label>
                        <input type="text" placeholder="Your name"
                            class="w-full bg-[#141B27] border border-[#1E293B] rounded-lg px-3 py-2.5 text-sm text-white placeholder-[#94A3B8]/50 focus:outline-none focus:border-blue/50 focus:ring-1 focus:ring-blue/20 transition-all">
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-medium text-white/70">Email</label>
                        <input type="email" placeholder="you@company.com"
                            class="w-full bg-[#141B27] border border-[#1E293B] rounded-lg px-3 py-2.5 text-sm text-white placeholder-[#94A3B8]/50 focus:outline-none focus:border-blue/50 focus:ring-1 focus:ring-blue/20 transition-all">
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-medium text-white/70">Message</label>
                        <textarea rows="4" placeholder="Tell us how we can help..."
                            class="w-full bg-[#141B27] border border-[#1E293B] rounded-lg px-3 py-2.5 text-sm text-white placeholder-[#94A3B8]/50 focus:outline-none focus:border-blue/50 focus:ring-1 focus:ring-blue/20 transition-all resize-none"></textarea>
                    </div>
                    <button type="button" id="contactSubmitBtn"
                        class="w-full py-2.5 rounded-lg text-sm font-semibold text-white glow-btn transition-all">
                        Send Message
                    </button>
                    <div id="contactSuccess" class="hidden text-center py-2 text-xs text-emerald-400">
                        ✓ Message sent! We'll get back to you soon.
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    document.getElementById('contactSubmitBtn').addEventListener('click', function() {
        var btn = this;
        btn.disabled = true;
        btn.textContent = 'Sending...';
        setTimeout(function() {
            document.getElementById('contactSuccess').classList.remove('hidden');
            document.getElementById('contactForm').style.opacity = '0.5';
            document.getElementById('contactForm').style.pointerEvents = 'none';
        }, 800);
    });
</script>
