@* Contact Section *@
<section id="contact" class="py-24 border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12 fade-in">
            <h2 class="text-3xl font-semibold text-white tracking-tight">Get in touch</h2>
            <p class="text-sm font-normal text-[#8A8A93] max-w-md mx-auto mt-3 leading-relaxed">Have questions? Fill out the form and we'll get back to you within 1 business day.</p>
        </div>

        <!-- Contact card -->
        <div class="grid md:grid-cols-3 border border-white/6 rounded-2xl overflow-hidden bg-[#111114] fade-in">

            <!-- Left: Info -->
            <div class="md:col-span-2 p-8 lg:p-12 border-b md:border-b-0 md:border-r border-white/6 flex flex-col justify-between">
                <div>
                    <h3 class="text-lg font-semibold text-white mb-3">Contact Us</h3>
                    <p class="text-sm font-normal text-[#8A8A93] max-w-lg mb-8 leading-relaxed">
                        If you have any questions or need help, please fill out the form. We do our best to respond within 1 business day.
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="flex items-center gap-3 py-2">
                            <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/6 flex items-center justify-center flex-shrink-0">
                                <svg class="w-3.5 h-3.5 text-[#8A8A93]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-white">Email</p>
                                <p class="text-xs text-[#8A8A93]">hello@healthycron.com</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 py-2">
                            <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/6 flex items-center justify-center flex-shrink-0">
                                <svg class="w-3.5 h-3.5 text-[#8A8A93]" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-white">Twitter / X</p>
                                <p class="text-xs text-[#8A8A93]">@@healthycron</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 py-2">
                            <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/6 flex items-center justify-center flex-shrink-0">
                                <svg class="w-3.5 h-3.5 text-[#8A8A93]" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-white">Discord</p>
                                <p class="text-xs text-[#8A8A93]">discord.gg/healthycron</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Form -->
            <div class="md:col-span-1 p-8">
                <form id="contactForm" class="w-full space-y-4">
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-medium text-[#8A8A93]">Name</label>
                        <input type="text" placeholder="Your name"
                            class="w-full bg-[#161618] border border-white/8 rounded-lg px-3 py-2.5 text-sm text-white placeholder-[#4A4A52] focus:outline-none focus:border-white/20 focus:ring-1 focus:ring-white/10 transition-all">
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-medium text-[#8A8A93]">Email</label>
                        <input type="email" placeholder="you@company.com"
                            class="w-full bg-[#161618] border border-white/8 rounded-lg px-3 py-2.5 text-sm text-white placeholder-[#4A4A52] focus:outline-none focus:border-white/20 focus:ring-1 focus:ring-white/10 transition-all">
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-medium text-[#8A8A93]">Message</label>
                        <textarea rows="4" placeholder="Tell us how we can help..."
                            class="w-full bg-[#161618] border border-white/8 rounded-lg px-3 py-2.5 text-sm text-white placeholder-[#4A4A52] focus:outline-none focus:border-white/20 focus:ring-1 focus:ring-white/10 transition-all resize-none"></textarea>
                    </div>
                    <button type="button" id="contactSubmitBtn"
                        class="w-full py-2.5 rounded-lg text-sm font-medium text-[#0A0A0B] bg-white hover:bg-white/90 transition-all">
                        Send Message
                    </button>
                    <div id="contactSuccess" class="hidden text-center py-2 text-xs text-[#22C55E]">
                        ✓ Message sent! We'll get back to you soon.
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    document.getElementById('contactSubmitBtn').addEventListener('click', function() {
        var btn = this;
        btn.disabled = true;
        btn.textContent = 'Sending...';
        setTimeout(function() {
            document.getElementById('contactSuccess').classList.remove('hidden');
            document.getElementById('contactForm').style.opacity = '0.5';
            document.getElementById('contactForm').style.pointerEvents = 'none';
        }, 800);
    });
</script>
