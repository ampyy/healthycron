<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthyCron</title>
    <meta name="description"
        content="Never miss a job run. Real-time cron monitoring, heartbeat checks, and instant alerts for engineering teams.">

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="~/favicon/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="192x192" href="~/favicon/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="~/favicon/android-chrome-512x512.png">
    <link rel="manifest" href="~/favicon/site.webmanifest">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,400&family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        hc-black: '#0A0A0B',
                        'hc-black-light': '#111114',
                        'hc-black-lighter': '#18181C',
                        blue: '#ffffff',
                        purple: '#a3a3a3',
                        'hc-muted': '#737373',
                        'hc-border': '#27272D'
                    },
                    fontFamily: {
                        sans: ['Sora', 'system-ui', 'sans-serif'],
                        mono: ['DM Mono', 'monospace']
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --hc-black: #0A0A0B;
            --hc-ink: #111114;
            --hc-surface: #18181C;
            --hc-border: #27272D;
            --hc-border-mid: #38383F;

            --hc-white: #FAFAFA;
            --hc-silver: #D4D4D8;
            --hc-dim: #A1A1AA;
            --hc-muted: #52525B;

            --hc-red: #EF3340;
            --hc-red-deep: #C41E27;
            --hc-red-subtle: #2D1215;
            --hc-green: #22C55E;
            --hc-green-subtle: #0D2318;
            --hc-amber: #F59E0B;
            --hc-amber-subtle: #261D09;
            --hc-blue: #3B82F6;
            --hc-blue-subtle: #0D1B38;
        }
        * {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Sora', sans-serif;
            background-color: var(--hc-black);
            color: var(--hc-white);
        }

        /* Gradient Text */
        .gradient-text {
            background: linear-gradient(135deg, #ffffff 0%, #a3a3a3 50%, #ffffff 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradient-shift 6s ease infinite;
        }

        @@keyframes gradient-shift {

            0%,
            100% {
                background-position: 0% center;
            }

            50% {
                background-position: 100% center;
            }
        }

        /* Minimalist Button (formerly Glow Button) */
        .glow-btn {
            position: relative;
            background: #6366F1;
            color: #ffffff !important;
            transition: all 0.2s ease;
        }

        .glow-btn:hover {
            transform: translateY(-1px);
            background: #4F52D9;
        }

        /* Solid Card (formerly Glass Card) */
        .glass-card {
            background: var(--hc-ink);
            border: 1px solid var(--hc-border);
            transition: all 0.2s ease;
        }

        .glass-card:hover {
            background: var(--hc-surface);
            border-color: var(--hc-border-mid);
            transform: translateY(-2px);
        }

        /* Navbar Scroll */
        .navbar-scrolled {
            background: rgba(0, 0, 0, 0.92);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(38, 38, 38, 0.8);
        }

        /* Fade In Animation */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.6s ease-out;
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Logo Carousel */
        .logo-scroll {
            animation: scroll-left 30s linear infinite;
        }

        @@keyframes scroll-left {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-50%);
            }
        }

        /* Testimonial Carousel */
        .testimonial-track {
            animation: testimonial-scroll 40s linear infinite;
        }

        @@keyframes testimonial-scroll {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-50%);
            }
        }

        /* Pulse Dot */
        .pulse-dot {
            animation: pulse 2s ease-in-out infinite;
        }

        @@keyframes pulse {

            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: 0.5;
                transform: scale(1.2);
            }
        }

        /* Background — pure black with faint dot grid */
        .bg-gradient-animated {
            background-color: #000000;
            background-image: radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px);
            background-size: 32px 32px;
        }

        /* Logo marquee scroll */
        @@keyframes logo-scroll {
            0%   { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        .logo-scroll {
            animation: logo-scroll 28s linear infinite;
        }

        /* Testimonial marquee scroll */
        @@keyframes testimonial-scroll {
            0%   { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        .testimonial-track {
            animation: testimonial-scroll 35s linear infinite;
        }
        .testimonial-track:hover,
        .logo-scroll:hover { animation-play-state: paused; }

        /* FAQ Accordion */
        .faq-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
        }

        .faq-content.open {
            max-height: 200px;
        }

        .tab-btn.active {
            background: rgba(255,255,255,0.04);
            border-color: rgba(255,255,255,0.15);
        }
        .tab-btn.active .w-8.h-8 svg {
            color: #6366F1;
            filter: drop-shadow(0 0 8px rgba(99,102,241,0.5));
        }

        .feature-image {
            opacity: 0;
            transform: scale(0.95);
            transition: all 0.4s ease;
        }

        .feature-image.active {
            opacity: 1;
            transform: scale(1);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #000000;
        }

        ::-webkit-scrollbar-thumb {
            background: #333333;
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #555555;
        }
    </style>
</head>

<body class="antialiased">
    <partial name="_Navbar" />

    <main role="main">
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <script>
        // 1. Navbar scroll effect
        window.addEventListener('scroll', function() {
            var nav = document.getElementById('navbar');
            if(nav) {
                if(window.scrollY > 50) { nav.classList.add('navbar-scrolled'); }
                else { nav.classList.remove('navbar-scrolled'); }
            }
        });

        // 2. Mobile menu toggle
        function toggleMobileMenu() {
            var menu = document.getElementById('mobile-menu');
            if(menu) menu.classList.toggle('hidden');
        }

        // 3. FAQ toggle
        function toggleFaq(button) {
            var content = button.nextElementSibling;
            var icon = button.querySelector('svg');
            if(content) {
                content.classList.toggle('open');
                if(icon) icon.style.transform = content.classList.contains('open') ? 'rotate(180deg)' : 'rotate(0)';
            }
        }

        // 4. Feature tabs logic
        var currentFeatureTab = 0;
        var featureTabInterval = null;

        function switchFeatureTab(index) {
            currentFeatureTab = index;
            document.querySelectorAll('.tab-btn').forEach(function(btn, i) {
                btn.classList.toggle('active', i === index);
            });
            document.querySelectorAll('.feature-image').forEach(function(img, i) {
                if (i === index) {
                    img.classList.add('active');
                    img.classList.remove('absolute', 'inset-0');
                    img.style.position = 'relative';
                } else {
                    img.classList.remove('active');
                    img.classList.add('absolute', 'inset-0');
                    img.style.position = 'absolute';
                }
            });
            clearInterval(featureTabInterval);
            startTabRotation();
        }

        function startTabRotation() {
            var tabs = document.querySelectorAll('.tab-btn');
            if (tabs.length > 0) {
                featureTabInterval = setInterval(function() {
                    currentFeatureTab = (currentFeatureTab + 1) % tabs.length;
                    switchFeatureTab(currentFeatureTab);
                }, 5000);
            }
        }
        window.addEventListener('load', startTabRotation);

        // 5. Scroll reveal animation (Fixes black screen bug)
        var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { root: null, rootMargin: '0px', threshold: 0.1 });
        
        document.querySelectorAll('.fade-in').forEach(function(el) { 
            observer.observe(el); 
        });

        // 6. Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {
            anchor.addEventListener('click', function (e) {
                var targetId = this.getAttribute('href');
                if (targetId !== '#') {
                    var target = document.querySelector(targetId);
                    if (target) {
                        e.preventDefault();
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        var menu = document.getElementById('mobile-menu');
                        if (menu) menu.classList.add('hidden');
                    }
                }
            });
        });

        // 7. Global logout
        async function handleLogout() {
            try {
                var response = await fetch('/auth/logout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                if (response.ok) { window.location.href = '/login'; } 
                else { alert('Logout failed.'); }
            } catch (err) {
                alert('Connection error.');
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>