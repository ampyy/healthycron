@* Footer — clean link-row style *@
<footer class="border-t border-[#1a1a1a] py-14 bg-black">
    <div class="max-w-5xl mx-auto px-6">

        <div class="flex flex-col md:flex-row items-center justify-between gap-8">
            <!-- Logo + copyright -->
            <div class="flex items-center gap-3">
                <a href="/" class="flex items-center gap-2.5">
                    <img src="/images/logo.png" alt="HealthyCron" class="w-7 h-7 rounded-lg object-contain">
                    <span class="text-base font-semibold text-white tracking-tight">HealthyCron</span>
                </a>
                <span class="text-[#525252] text-xs">·</span>
                <span class="text-[#525252] text-xs">© @DateTime.Now.Year All rights reserved</span>
            </div>

            <!-- Nav links -->
            <nav class="flex flex-wrap justify-center gap-x-7 gap-y-2">
                <a href="/#features" class="text-sm text-[#737373] hover:text-white transition-colors">Features</a>
                <a href="/#monitor" class="text-sm text-[#737373] hover:text-white transition-colors">Monitor Types</a>
                <a href="/#integrations" class="text-sm text-[#737373] hover:text-white transition-colors">Integrations</a>
                <a href="/#pricing" class="text-sm text-[#737373] hover:text-white transition-colors">Pricing</a>
                <a href="/#faq" class="text-sm text-[#737373] hover:text-white transition-colors">FAQ</a>
                <a href="/#contact" class="text-sm text-[#737373] hover:text-white transition-colors">Contact</a>
            </nav>

            <!-- Social icons -->
            <div class="flex items-center gap-4">
                <!-- X / Twitter -->
