@* Footer — 4-column layout: Company + Links + Follow + Newsletter *@
<footer class="bg-[#060607] border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6 py-16 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12">

        <!-- Col 1: Brand -->
        <div class="flex flex-col gap-4">
            <a href="/" class="flex items-center gap-2.5">
                <img src="/images/logo.png" alt="HealthyCron" class="w-8 h-8 rounded-lg object-contain">
                <span class="text-base font-semibold text-white tracking-tight">HealthyCron</span>
            </a>
            <p class="text-sm text-[#8A8A93] leading-relaxed">
                Monitor your cron jobs and scheduled tasks with instant alerts for your engineering team.
            </p>
            <!-- Status indicator -->
            <div class="flex items-center gap-2 mt-1">
                <span class="inline-flex items-center gap-1.5 text-[10px] font-medium uppercase tracking-widest text-[#22C55E] bg-[#22C55E]/8 border border-[#22C55E]/15 rounded-full px-2.5 py-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#22C55E] animate-pulse"></span>
                    All systems operational
                </span>
            </div>
        </div>

        <!-- Col 2: Product Links -->
        <div>
            <h3 class="text-xs font-semibold text-white uppercase tracking-widest mb-5">Product</h3>
            <ul class="space-y-3">
                <li><a href="/#features" class="text-sm text-[#8A8A93] hover:text-white transition-colors">Features</a></li>
                <li><a href="/#pricing" class="text-sm text-[#8A8A93] hover:text-white transition-colors">Pricing</a></li>
                <li><a href="/#integrations" class="text-sm text-[#8A8A93] hover:text-white transition-colors">Integrations</a></li>
                <li><a href="/status" class="text-sm text-[#8A8A93] hover:text-white transition-colors">Status Page</a></li>
                <li><a href="/changelog" class="text-sm text-[#8A8A93] hover:text-white transition-colors">Changelog</a></li>
            </ul>
        </div>

        <!-- Col 3: Company + Social -->
        <div>
            <h3 class="text-xs font-semibold text-white uppercase tracking-widest mb-5">Company</h3>
            <ul class="space-y-3 mb-8">
                <li><a href="/docs" class="text-sm text-[#8A8A93] hover:text-white transition-colors">Docs</a></li>
                <li><a href="/blog" class="text-sm text-[#8A8A93] hover:text-white transition-colors">Blog</a></li>
                <li><a href="/#contact" class="text-sm text-[#8A8A93] hover:text-white transition-colors">Contact</a></li>
                <li><a href="/privacy" class="text-sm text-[#8A8A93] hover:text-white transition-colors">Privacy Policy</a></li>
                <li><a href="/terms" class="text-sm text-[#8A8A93] hover:text-white transition-colors">Terms of Service</a></li>
            </ul>

            <!-- Social links -->
            <div class="flex items-center gap-4">
                <a href="#" target="_blank" rel="noopener noreferrer" aria-label="Twitter / X"
                   class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-[#8A8A93] hover:text-white hover:bg-white/10 transition-all">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M10.488 14.651L15.25 21h7l-7.858-10.478L20.93 3h-2.65l-5.117 5.886L8.75 3h-7l7.51 10.015L2.32 21h2.65zM16.25 19L5.75 5h2l10.5 14z"/></svg>
                </a>
                <a href="https://linkedin.com/in/amanp30" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
                   class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-[#8A8A93] hover:text-white hover:bg-white/10 transition-all">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z"/></svg>
                </a>
                <a href="https://github.com" target="_blank" rel="noopener noreferrer" aria-label="GitHub"
                   class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-[#8A8A93] hover:text-white hover:bg-white/10 transition-all">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M12 0C5.373 0 0 5.373 0 12c0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577v-2.165c-3.338.726-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.494.998.108-.776.417-1.305.76-1.604-2.665-.305-5.466-1.332-5.466-5.93 0-1.31.469-2.381 1.235-3.221-.124-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.3 1.23A11.51 11.51 0 0 1 12 5.803c1.02.005 2.047.137 3.006.403 2.29-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.873.118 3.176.77.84 1.235 1.91 1.235 3.221 0 4.61-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                </a>
            </div>
        </div>

        <!-- Col 4: Newsletter -->
        <div>
            <h3 class="text-xs font-semibold text-white uppercase tracking-widest mb-2">Stay updated</h3>
            <p class="text-sm text-[#8A8A93] mb-5">Get product updates and tips delivered straight to your inbox.</p>
            <form id="footerNewsletterForm" class="space-y-3" onsubmit="handleFooterNewsletter(event)">
                <div class="relative">
                    <input type="email" id="footerEmail" placeholder="your@email.com" required
                        class="w-full bg-[#111114] border border-white/8 rounded-lg px-3 py-2.5 text-sm text-white placeholder:text-[#4A4A52] focus:outline-none focus:ring-1 focus:ring-[#22C55E]/30 transition-all pr-24">
                    <button type="submit"
                        class="absolute right-1 top-1 bottom-1 px-3 bg-white text-[#0A0A0B] text-xs font-semibold rounded-md hover:bg-white/90 transition-all">
                        Subscribe
                    </button>
                </div>
                <p id="footerNewsletterMsg" class="hidden text-xs text-[#22C55E] flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    You're subscribed!
                </p>
            </form>
        </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/5">
        <div class="max-w-5xl mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
            <p class="text-xs text-[#4A4A52]">© 2025 HealthyCron. All rights reserved.</p>
            <div class="flex items-center gap-6">
                <a href="/privacy" class="text-xs text-[#4A4A52] hover:text-[#8A8A93] transition-colors">Privacy</a>
                <a href="/terms" class="text-xs text-[#4A4A52] hover:text-[#8A8A93] transition-colors">Terms</a>
                <a href="/docs/api-reference" class="text-xs text-[#4A4A52] hover:text-[#8A8A93] transition-colors">API Reference</a>
            </div>
        </div>
    </div>
</footer>

<script>
    function handleFooterNewsletter(e) {
        e.preventDefault();
        var form = document.getElementById('footerNewsletterForm');
        var msg = document.getElementById('footerNewsletterMsg');
        var input = document.getElementById('footerEmail');
        input.disabled = true;
        msg.classList.remove('hidden');
        form.querySelector('button').textContent = 'Subscribed!';
        form.querySelector('button').disabled = true;
    }
</script>
