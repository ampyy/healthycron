@* Navigation — Clean flat navbar per design system *@
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isHome = controller == "Home" && action == "Index";
    var user = Context.Items["User"] as HealthyCron.Models.User;
}

<style>
    #navbar { transition: border-color 0.2s ease, background 0.2s ease; }
    #navbar.scrolled {
        background: rgba(10,10,11,0.92);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom-color: rgba(255,255,255,0.06);
    }
</style>

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 border-b border-transparent">
    <div class="max-w-5xl mx-auto px-6">
        <div class="flex items-center justify-between h-14">

            <!-- Logo -->
            <a href="/" class="flex items-center gap-2 flex-shrink-0">
                <img src="/images/logo.png" alt="HealthyCron" class="w-6 h-6 rounded-md object-contain">
                <span class="text-sm font-medium text-white tracking-tight">HealthyCron</span>
            </a>

            @if (isHome)
            {
                <!-- Desktop nav links -->
                <nav class="hidden lg:flex items-center gap-6">
                    <a href="#features"     class="text-sm font-normal text-[#8A8A93] hover:text-white transition-colors duration-150">Features</a>
                    <a href="#monitor"      class="text-sm font-normal text-[#8A8A93] hover:text-white transition-colors duration-150">Monitor</a>
                    <a href="#integrations" class="text-sm font-normal text-[#8A8A93] hover:text-white transition-colors duration-150">Integrations</a>
                    <a href="#pricing"      class="text-sm font-normal text-[#8A8A93] hover:text-white transition-colors duration-150">Pricing</a>
                    <a href="#faq"          class="text-sm font-normal text-[#8A8A93] hover:text-white transition-colors duration-150">FAQ</a>
                </nav>
            }

            <!-- Auth area -->
            <div class="hidden sm:flex items-center gap-3">
                @if (user != null)
                {
                    <a href="/login" class="text-sm font-medium text-[#8A8A93] hover:text-white px-3 py-1.5 transition-colors">Dashboard</a>
                    <button onclick="handleLogout()" class="bg-white text-[#0A0A0B] font-medium text-sm rounded-lg px-4 py-1.5 hover:bg-white/90 transition-all">Logout</button>
                }
                else
                {
                    <a href="/login" class="text-sm font-medium text-[#8A8A93] hover:text-white px-3 py-1.5 transition-colors">Login</a>
                    <a href="/signup" class="bg-white text-[#0A0A0B] font-medium text-sm rounded-lg px-4 py-1.5 hover:bg-white/90 transition-all">Try for Free</a>
                }
            </div>

            <!-- Mobile hamburger -->
            <button id="mobile-menu-btn"
                class="sm:hidden flex items-center justify-center w-8 h-8 text-[#8A8A93] hover:text-white focus:outline-none"
                onclick="toggleMobileMenu()"
                aria-label="Toggle menu">
                <svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu"
         class="sm:hidden overflow-hidden max-h-0 transition-all duration-300 ease-in-out border-t border-transparent"
         style="background:rgba(10,10,11,0.97); backdrop-filter:blur(20px);">
        <div class="max-w-5xl mx-auto px-6 py-4 flex flex-col gap-3">
            @if (isHome)
            {
                <a href="#features"     class="text-sm text-[#8A8A93] hover:text-white transition-colors py-1" onclick="if(mobileOpen)toggleMobileMenu()">Features</a>
                <a href="#monitor"      class="text-sm text-[#8A8A93] hover:text-white transition-colors py-1" onclick="if(mobileOpen)toggleMobileMenu()">Monitor</a>
                <a href="#integrations" class="text-sm text-[#8A8A93] hover:text-white transition-colors py-1" onclick="if(mobileOpen)toggleMobileMenu()">Integrations</a>
                <a href="#pricing"      class="text-sm text-[#8A8A93] hover:text-white transition-colors py-1" onclick="if(mobileOpen)toggleMobileMenu()">Pricing</a>
                <a href="#faq"          class="text-sm text-[#8A8A93] hover:text-white transition-colors py-1" onclick="if(mobileOpen)toggleMobileMenu()">FAQ</a>
                <div class="h-px bg-white/6 my-1"></div>
            }
            @if (user != null)
            {
                <a href="/dashboard" class="text-sm text-[#8A8A93] hover:text-white transition-colors py-1">Dashboard</a>
                <button onclick="handleLogout()" class="text-left text-sm text-[#8A8A93] hover:text-white transition-colors py-1">Logout</button>
            }
            else
            {
                <a href="/login"  class="text-sm text-[#8A8A93] hover:text-white transition-colors py-1">Login</a>
                <a href="/signup" class="text-sm font-medium text-white bg-white/10 rounded-lg px-4 py-2 text-center">Try for Free</a>
            }
        </div>
    </div>
</nav>

<script>
    // Scroll effect
    var navbar = document.getElementById('navbar');
    window.addEventListener('scroll', function() {
        navbar.classList.toggle('scrolled', window.scrollY > 20);
    });

    var mobileOpen = false;
    function toggleMobileMenu() {
        mobileOpen = !mobileOpen;
        var menu = document.getElementById('mobile-menu');
        var ham  = document.getElementById('hamburger-icon');
        var cls  = document.getElementById('close-icon');
        if (mobileOpen) {
            menu.style.maxHeight = '400px';
            menu.style.borderTopColor = 'rgba(255,255,255,0.06)';
            ham.classList.add('hidden');
            cls.classList.remove('hidden');
        } else {
            menu.style.maxHeight = '0';
            menu.style.borderTopColor = 'transparent';
            ham.classList.remove('hidden');
            cls.classList.add('hidden');
        }
    }
</script>
