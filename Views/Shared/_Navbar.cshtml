@* Navigation *@
<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 lg:h-20">
            <a href="#" class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue to-purple flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <span class="text-xl font-bold text-white">HealthyCron</span>
            </a>

            <div class="hidden lg:flex items-center gap-8">
                <a href="#features" class="text-sm text-text-secondary hover:text-white transition-colors">Features</a>
                <a href="#monitor" class="text-sm text-text-secondary hover:text-white transition-colors">What to
                    Monitor</a>
                <a href="#integrations"
                    class="text-sm text-text-secondary hover:text-white transition-colors">Integrations</a>
                <a href="#pricing" class="text-sm text-text-secondary hover:text-white transition-colors">Pricing</a>
                <a href="#blog" class="text-sm text-text-secondary hover:text-white transition-colors">Blog</a>
                <a href="#faq" class="text-sm text-text-secondary hover:text-white transition-colors">FAQ</a>
            </div>

            <div class="hidden lg:flex items-center gap-4">
                @{
                    var user = Context.Items["User"] as HealthyCron.Models.User;
                    if (user != null)
                    {
                        <a href="/dashboard"
                            class="text-sm text-text-secondary hover:text-white transition-colors">Dashboard</a>
                        <button onclick="handleLogout()"
                            class="glow-btn px-5 py-2.5 rounded-lg text-sm font-medium text-white">Logout</button>
                    }
                    else
                    {
                        <a href="/login" class="text-sm text-text-secondary hover:text-white transition-colors">Login</a>
                        <a href="/signup" class="glow-btn px-5 py-2.5 rounded-lg text-sm font-medium text-white">Signup</a>
                    }
                }
            </div>

            <button id="mobile-menu-btn" class="lg:hidden p-2 text-text-secondary hover:text-white">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden bg-navy-light border-t border-border-color">
        <div class="px-4 py-4 space-y-3">
            <a href="#features" class="block text-sm text-text-secondary hover:text-white py-2">Features</a>
            <a href="#monitor" class="block text-sm text-text-secondary hover:text-white py-2">What to Monitor</a>
            <a href="#integrations" class="block text-sm text-text-secondary hover:text-white py-2">Integrations</a>
            <a href="#pricing" class="block text-sm text-text-secondary hover:text-white py-2">Pricing</a>
            <a href="#blog" class="block text-sm text-text-secondary hover:text-white py-2">Blog</a>
            <a href="#faq" class="block text-sm text-text-secondary hover:text-white py-2">FAQ</a>
            <div class="pt-4 border-t border-border-color flex flex-col gap-3">
                @{
                    var mobileUser = Context.Items["User"] as HealthyCron.Models.User;
                    if (mobileUser != null)
                    {
                        <a href="/dashboard" class="text-sm text-text-secondary hover:text-white">Dashboard</a>
                        <button onclick="handleLogout()" class="glow-btn px-5 py-2.5 rounded-lg text-sm font-medium text-white text-center">Logout</button>
                    }
                    else
                    {
                        <a href="/login" class="text-sm text-text-secondary hover:text-white">Login</a>
                        <a href="/signup" class="glow-btn px-5 py-2.5 rounded-lg text-sm font-medium text-white text-center">Signup</a>
                    }
                }
            </div>
        </div>
    </div>
</nav>
