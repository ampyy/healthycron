@model IEnumerable<HealthyCron.Models.MonitorPing>
@{
    var project = (ViewBag.Project as HealthyCron.Models.Project)!;
    var monitors = ViewBag.Monitors as IEnumerable<HealthyCron.Models.Monitor>;
    ViewData["Title"] = $"{project?.Name} - Event Logs";
    Layout = "_DashboardLayout";
    
    int? currentStatus = ViewBag.Status as int?;
    string? currentSearch = ViewBag.Search as string;
    Guid? currentMonitorId = ViewBag.MonitorId as Guid?;
    int currentLimit = ViewBag.Limit ?? 25;
    var userTz = ViewBag.UserTimezone as string ?? "UTC";
}

<div class="max-w-6xl mx-auto pb-20 px-4 sm:px-6">
    <!-- Breadcrumbs -->
    <div class="flex items-center justify-between mb-8">
        <div class="flex flex-wrap items-center gap-2 text-hc-muted text-sm uppercase tracking-wider font-semibold">
            <a href="/dashboard" class="hover:text-blue transition-colors flex items-center gap-1">
                <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
                Projects
            </a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <a href="/@project!.Slug/monitors" class="hover:text-white transition-colors">@project!.Name</a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            <span class="text-white">Event Logs</span>
        </div>
    </div>

    <!-- Header & Filters -->
    <div class="glass-card rounded-2xl p-6 mb-8 bg-hc-black/30 border border-white/5">
        <div class="flex flex-col gap-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-black text-white mb-1 uppercase tracking-tight">Project Activity Logs</h1>
                    <p class="text-xs text-hc-muted">Viewing recent events for @project?.Name.</p>
                </div>
                
                <div class="flex flex-wrap items-center gap-3">
                    @if (currentMonitorId != null)
                    {
                        <a href="/monitor/@(monitors?.FirstOrDefault(m => m.Id == currentMonitorId)?.Slug)" class="bg-white/5 hover:bg-white/10 text-white px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all ring-1 ring-white/10 border border-white/5 flex items-center gap-2">
                            <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                            Back to Monitor
                        </a>
                    }

                    <form method="get" class="flex items-center gap-3">
                        <input type="hidden" name="limit" value="@currentLimit" />
                        
                        <div class="relative group">
                            <select name="status" onchange="this.form.submit()" class="bg-hc-black border border-white/10 rounded-xl px-4 py-2 text-xs text-white focus:ring-2 focus:ring-blue/50 outline-none transition-all font-bold appearance-none pr-8 cursor-pointer hover:border-white/20">
                                <option value="">All Statuses</option>
                                <option value="0" selected="@(currentStatus == 0 ? "selected" : null)">OK</option>
                                <option value="1" selected="@(currentStatus == 1 ? "selected" : null)">Fail</option>
                                <option value="2" selected="@(currentStatus == 2 ? "selected" : null)">Start</option>
                            </select>
                            <i data-lucide="filter" class="absolute right-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-hc-muted pointer-events-none"></i>
                        </div>

                        @if (currentStatus != null)
                        {
                            <a href="/@project?.Slug/logs@(currentMonitorId != null ? $"?monitorId={currentMonitorId}" : "")" class="text-rose-500 hover:text-rose-400 text-xs font-bold transition-all p-2 flex items-center gap-1" title="Clear Filters">
                                <i data-lucide="x" class="w-3 h-3"></i>
                            </a>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Logs Table -->
    <section class="glass-card rounded-2xl overflow-hidden w-full bg-hc-black/20">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="text-[9px] uppercase font-black text-hc-muted border-b border-white/5 bg-hc-black/50">
                        <th class="px-4 py-3 pl-6 w-10">#</th>
                        <th class="px-4 py-3 w-24">Date</th>
                        <th class="px-4 py-3 w-24">Time</th>
                        <th class="px-4 py-3 w-20">Status</th>
                        <th class="px-4 py-3">User Agent</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    @{
                        int rowNum = Model.Count();
                    }
                    @foreach (var ping in Model)
                    {
                        var statusStr = ping.Status == HealthyCron.Models.PingType.Success ? "OK" : (ping.Status == HealthyCron.Models.PingType.Start ? "Start" : "Fail");
                        var localTime = TimezoneHelper.ToUserTime(ping.ReceivedAt, userTz);
                        var statusClass = statusStr == "OK" ? "bg-emerald-500/10 text-emerald-500 border border-emerald-500/20"
                                        : (statusStr == "Start" ? "bg-blue-500/10 text-blue-500 border border-blue-500/20"
                                        : "bg-rose-500/10 text-rose-500 border border-rose-500/20");
                        <tr class="hover:bg-white/[0.04] transition-all cursor-pointer group" onclick="showPingDetails(this)"
                            data-id="@ping.Id" data-time="@localTime.ToString("MMM dd, yyyy HH:mm:ss") (@userTz)"
                            data-status="@statusStr" data-message="@ping.Message"
                            data-ip="@ping.IpAddress" data-ua="@ping.UserAgent"
                            data-method="@ping.HttpMethod" data-headers="@ping.RequestHeaders">
                            <td class="px-4 py-3 pl-6 w-10">
                                <span class="text-[10px] font-mono text-hc-muted/40">@rowNum</span>
                            </td>
                            <td class="px-4 py-3 w-24">
                                <span class="text-xs text-white font-bold">@localTime.ToString("MMM dd")</span>
                            </td>
                            <td class="px-4 py-3 w-24">
                                <span class="text-[10px] text-hc-muted font-mono">@localTime.ToString("HH:mm:ss")</span>
                            </td>
                            <td class="px-4 py-3 w-20">
                                <span class="px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-widest @statusClass">@statusStr</span>
                            </td>
                            <td class="px-4 py-3">
                                <span class="text-[10px] text-hc-muted font-mono" title="@ping.UserAgent">@(ping.UserAgent ?? "—")</span>
                            </td>
                        </tr>
                        rowNum--;
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-20 text-center text-hc-muted font-medium text-xs opacity-50 italic">No logs matching your criteria were found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <div id="load-more-container" class="px-6 py-6 bg-white/[0.02] border-t border-white/5 text-center @(Model.Count() < currentLimit ? "hidden" : "")">
            <button onclick="loadMoreLogs()" id="btn-load-more" class="inline-flex items-center gap-2 px-8 py-3 rounded-xl bg-blue/10 hover:bg-blue/20 text-blue font-black uppercase tracking-widest text-[10px] transition-all transform hover:scale-105 active:scale-95 shadow-lg shadow-blue/5">
                <span>Load More Logs</span>
                <i data-lucide="chevron-down" class="w-4 h-4"></i>
            </button>
            <div id="loader-load-more" class="hidden flex justify-center">
                <div class="w-6 h-6 border-2 border-blue/20 border-t-blue rounded-full animate-spin"></div>
            </div>
        </div>
    </section>
</div>

<!-- Ping Details Modal -->
<div id="pingModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="fixed inset-0 bg-black/80 transition-opacity" onclick="closePingModal()"></div>
        <div class="inline-block bg-hc-black-light rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:max-w-lg w-full border border-hc-border relative z-10">
            <div class="px-6 py-4 border-b border-hc-border flex justify-between items-center bg-hc-black/50">
                <h3 class="text-xl font-bold text-white flex items-center gap-2"><i data-lucide="activity" class="text-blue"></i>Ping Details</h3>
                <button onclick="closePingModal()" class="text-hc-muted hover:text-white transition-colors"><i data-lucide="x" class="w-6 h-6"></i></button>
            </div>
            <div class="p-6">
                <div class="space-y-6">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-hc-black/50 rounded-xl p-4 border border-white/5">
                            <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black mb-1">Status</p>
                            <span id="modal-status" class="text-sm font-black uppercase tracking-widest"></span>
                        </div>
                        <div class="bg-hc-black/50 rounded-xl p-4 border border-white/5">
                            <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black mb-1">Received At</p>
                            <span id="modal-time" class="text-sm text-white font-bold"></span>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-hc-black/50 rounded-xl p-4 border border-white/5">
                            <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black mb-1">Source IP</p>
                            <span id="modal-ip" class="text-sm text-white font-mono break-all"></span>
                        </div>
                        <div class="bg-hc-black/50 rounded-xl p-4 border border-white/5">
                            <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black mb-1">Method</p>
                            <span id="modal-method" class="text-sm text-white font-mono font-bold"></span>
                        </div>
                    </div>

                    <div class="bg-hc-black/50 rounded-xl p-4 border border-white/5">
                        <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black mb-1">Ping Message</p>
                        <p id="modal-message" class="text-sm text-white italic"></p>
                    </div>

                    <div class="bg-hc-black/50 rounded-xl p-4 border border-white/5">
                        <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black mb-1">User Agent</p>
                        <p id="modal-ua" class="text-xs text-hc-muted break-all font-mono"></p>
                    </div>

                    <div class="bg-black/40 rounded-xl p-4 border border-white/5 overflow-x-auto">
                        <p class="text-[10px] text-hc-muted uppercase tracking-widest font-black mb-2">Request Headers</p>
                        <pre id="modal-headers" class="text-[10px] text-hc-green font-mono"></pre>
                    </div>

                    <button onclick="closePingModal()" class="w-full bg-blue text-white py-3 rounded-xl font-bold transition-all shadow-lg shadow-blue/20">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SignalR Client -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    // SignalR Connection
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/monitorHub")
        .withAutomaticReconnect()
        .build();

    async function startSignalR() {
        try {
            await connection.start();
            console.log("SignalR Connected.");
            await connection.invoke("JoinProject", "@project?.Id");
        } catch (err) {
            console.error("SignalR Connection Error: ", err);
            setTimeout(startSignalR, 5000);
        }
    }

    connection.on("PingReceived", (data) => {
        console.log("Ping Received:", data);
        
        // Check filters
        const currentStatusFilter = "@currentStatus";
        const statusVal = data.status === 'Success' ? 0 : (data.status === 'Start' ? 2 : 1);
        
        if (currentStatusFilter !== "" && statusVal.toString() !== currentStatusFilter) return;

        addLogRow(data);
    });

    startSignalR();

    function addLogRow(data) {
        const tbody = document.querySelector('table tbody');
        if (!tbody) return;

        // Remove "No logs" row
        const noLogsRow = tbody.querySelector('td[colspan="6"]');
        if (noLogsRow && noLogsRow.innerText.includes("No logs")) {
            tbody.removeChild(noLogsRow.parentElement);
        }

        const statusStr = data.status === 'Success' ? 'OK' : (data.status === 'Start' ? 'Start' : 'Fail');
        const statusClass = statusStr == 'OK' ? 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20' : (statusStr == 'Start' ? 'bg-blue-500/10 text-blue-500 border border-blue-500/20' : 'bg-rose-500/10 text-rose-500 border border-rose-500/20');
        
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-white/[0.04] transition-all cursor-pointer group opacity-0 translate-y-2';
        tr.onclick = function() { showPingDetails(this); };
        
        tr.dataset.id = data.id;
        tr.dataset.time = data.timeStr;
        tr.dataset.status = statusStr;
        tr.dataset.message = data.message || '';
        tr.dataset.ip = data.ipAddress || '';
        tr.dataset.ua = data.userAgent || '';
        tr.dataset.method = data.method || '';
        tr.dataset.headers = data.headers || '{}';

        tr.innerHTML = `
            <td class="px-4 py-3">
                <span class="text-xs text-white font-bold">${data.dateDisplay}</span>
            </td>
            <td class="px-4 py-3">
                <span class="text-[10px] text-hc-muted font-mono">${data.timeDisplay}</span>
            </td>
            <td class="px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="text-[10px] font-black uppercase tracking-wider text-blue">${data.monitorName}</span>
                </div>
            </td>
            <td class="px-4 py-3">
                <span class="px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-widest ${statusClass}">
                    ${statusStr}
                </span>
            </td>
            <td class="px-4 py-3 max-w-[150px] sm:max-w-xs">
                <div class="flex flex-col gap-0.5">
                    <div class="flex items-center gap-1.5 opacity-60">
                        <span class="text-[10px] text-white font-mono truncate">${data.method || 'GET'} ${data.ipAddress || 'N/A'}</span>
                    </div>
                    <div class="flex items-center gap-1.5 opacity-40 overflow-hidden">
                        <span class="text-[9px] text-hc-muted font-mono truncate" title="${data.userAgent || ''}">${(data.userAgent && data.userAgent.length > 20) ? data.userAgent.substring(0, 20) + '...' : (data.userAgent || 'N/A')}</span>
                    </div>
                </div>
            </td>
            <td class="px-4 py-3 text-right">
                <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-hc-muted group-hover:text-blue transition-all ml-auto opacity-50 group-hover:opacity-100"></i>
            </td>
        `;

        tbody.insertBefore(tr, tbody.firstChild);
        tr.offsetHeight;
        tr.classList.remove('opacity-0', 'translate-y-2');
        tr.classList.add('duration-500');
        
        lucide.createIcons();

        // Limit rows if needed
        if (tbody.children.length > 50) tbody.removeChild(tbody.lastChild);
    }

    function onMonitorChange(select) {
        const url = select.options[select.selectedIndex].getAttribute('data-url');
        window.location.href = url;
    }

    function openPingModal() { document.getElementById('pingModal').classList.remove('hidden'); }
    function closePingModal() { document.getElementById('pingModal').classList.add('hidden'); }

    function showPingDetails(row) {
        const dataset = row.dataset;
        document.getElementById('modal-time').innerText = dataset.time;
        document.getElementById('modal-message').innerText = dataset.message || 'Regular heartbeat ping.';
        
        const statusEl = document.getElementById('modal-status');
        statusEl.innerText = dataset.status;
        statusEl.className = 'text-sm font-black uppercase tracking-widest ' + (dataset.status === 'OK' ? 'text-emerald-500' : (dataset.status === 'Start' ? 'text-blue-500' : 'text-rose-500'));
        
        document.getElementById('modal-ip').innerText = dataset.ip || 'N/A';
        document.getElementById('modal-method').innerText = dataset.method || '-';
        document.getElementById('modal-ua').innerText = dataset.ua || 'N/A';
        
        try {
            const headers = JSON.parse(dataset.headers || '{}');
            document.getElementById('modal-headers').innerText = JSON.stringify(headers, null, 2);
        } catch {
            document.getElementById('modal-headers').innerText = '{}';
        }

        document.getElementById('pingModal').classList.remove('hidden');
        lucide.createIcons();
    }

    let currentOffset = @Model.Count();
    const limitStep = 25;
    let isLoading = false;

    async function loadMoreLogs() {
        if (isLoading) return;
        isLoading = true;

        const btn = document.getElementById('btn-load-more');
        const loader = document.getElementById('loader-load-more');
        
        btn.classList.add('hidden');
        loader.classList.remove('hidden');

        try {
            const params = new URLSearchParams({
                monitorId: '@currentMonitorId',
                status: '@currentStatus',
                limit: limitStep,
                offset: currentOffset
            });

            // Clean up empty params
            if (!params.get('monitorId')) params.delete('monitorId');
            if (!params.get('status')) params.delete('status');
            if (!params.get('search')) params.delete('search');

            const response = await fetch(`/@project!.Slug/logs/partials/logs?${params.toString()}`);
            if (!response.ok) throw new Error('Failed to load logs');

            const html = await response.text();
            
            if (html.trim().length === 0) {
                document.getElementById('load-more-container').classList.add('hidden');
                return; 
            }

            // Append to table
            const tbody = document.querySelector('table tbody');
            const tempDiv = document.createElement('tbody');
            tempDiv.innerHTML = html;
            
            let addedCount = 0;
            while (tempDiv.firstChild) {
                if (tempDiv.firstChild.nodeType === 1) { // Element node
                    tbody.appendChild(tempDiv.firstChild);
                    currentOffset++;
                    addedCount++;
                } else {
                    tempDiv.removeChild(tempDiv.firstChild);
                }
            }
            
            lucide.createIcons();

            if (addedCount < limitStep) {
                document.getElementById('load-more-container').classList.add('hidden');
            }

        } catch (error) {
            console.error(error);
            alert('Failed to load more logs.');
        } finally {
            isLoading = false;
            if (document.getElementById('load-more-container').classList.contains('hidden') === false) {
                 btn.classList.remove('hidden');
            }
            loader.classList.add('hidden');
        }
    }
</script>
