@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthyCron Docs</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Sora:wght@100..800&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        display: ['Sora', 'system-ui', 'sans-serif'],
                        mono: ['DM Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --hc-bg:        #0A0A0B;
            --hc-surface:   #111114;
            --hc-elevated:  #161618;
            --hc-border:    rgba(255,255,255,0.06);
            --hc-text:      #F2F2F2;
            --hc-muted:     #8A8A93;
            --hc-faint:     #4A4A52;
            --hc-green:     #22C55E;
            --hc-red:       #E03E2D;
            --hc-amber:     #F59E0B;
        }

        body {
            background-color: var(--hc-bg);
            color: var(--hc-text);
            font-family: 'Inter', system-ui, sans-serif;
            -webkit-font-smoothing: antialiased;
        }
        
        h1, h2, h3, h4, h5, h6, .font-display { font-family: 'Sora', system-ui, sans-serif; }
        code, .font-mono { font-family: 'DM Mono', monospace; }

        /* Inline code style */
        .prose code:not(pre code) {
            background-color: var(--hc-elevated);
            border: 1px solid var(--hc-border);
            border-radius: 4px;
            padding: 2px 6px;
            font-family: 'DM Mono', monospace;
            font-size: 0.75rem;
            color: var(--hc-text);
        }

        /* Unordered lists */
        .prose ul {
            list-style-type: none;
            padding-left: 0;
            margin-top: 1rem;
            margin-bottom: 1rem;
        }
        .prose ul li {
            position: relative;
            padding-left: 1.5rem;
            margin-bottom: 0.5rem;
            color: var(--hc-muted);
            font-size: 0.875rem;
            line-height: 1.625;
        }
        .prose ul li::before {
            content: '—';
            position: absolute;
            left: 0;
            color: var(--hc-faint);
            font-family: 'DM Mono', monospace;
        }
        .prose ul.success-list li::before {
            content: '✓';
            color: var(--hc-green);
        }
        .prose ul.danger-list li::before {
            content: '✗';
            color: rgba(224,62,45,0.7);
        }

        /* Callouts */
        .callout {
            border-radius: 0.75rem;
            padding: 1.25rem;
            margin-top: 2rem;
            margin-bottom: 2rem;
            border: 1px solid;
        }
        .callout-title {
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .callout-body {
            font-size: 0.875rem;
            color: var(--hc-muted);
            line-height: 1.625;
        }
        .callout-info { background: #0D1520; border-color: rgba(96,165,250,0.15); }
        .callout-info .callout-title { color: #60A5FA; }
        .callout-info .callout-icon { color: rgba(96,165,250,0.6); }

        .callout-success { background: #0A1A0F; border-color: rgba(34,197,94,0.15); }
        .callout-success .callout-title { color: #22C55E; }

        .callout-warning { background: #1A1200; border-color: rgba(245,158,11,0.15); }
        .callout-warning .callout-title { color: #F59E0B; }

        .callout-danger { background: #1C0E0C; border-color: rgba(224,62,45,0.15); }
        .callout-danger .callout-title { color: rgba(224,62,45,0.8); }

        /* API Method Badges */
        .method-badge {
            font-family: 'DM Mono', monospace;
            font-size: 10px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-radius: 4px;
            padding: 2px 8px;
            display: inline-block;
        }
        .method-get { background: #0D1520; color: #60A5FA; border: 1px solid rgba(96,165,250,0.2); }
        .method-post { background: #0A1A0F; color: #22C55E; border: 1px solid rgba(34,197,94,0.2); }
        .method-patch { background: #1A1200; color: #F59E0B; border: 1px solid rgba(245,158,11,0.2); }
        .method-delete { background: #1C0E0C; color: rgba(224,62,45,0.8); border: 1px solid rgba(224,62,45,0.2); }

        /* Tables */
        .docs-table-wrapper {
            border: 1px solid var(--hc-border);
            border-radius: 0.75rem;
            overflow: hidden;
            width: 100%;
            margin-top: 2rem;
            margin-bottom: 2rem;
        }
        .docs-table {
            width: 100%;
            border-collapse: collapse;
        }
        .docs-table th {
            font-size: 10px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--hc-faint);
            padding: 0.75rem 1rem;
            text-align: left;
            background: var(--hc-surface);
            border-bottom: 1px solid var(--hc-border);
        }
        .docs-table tbody tr:nth-child(even) { background: var(--hc-bg); }
        .docs-table tbody tr:nth-child(odd) { background: transparent; }
        .docs-table td {
            font-size: 0.875rem;
            font-weight: 400;
            color: var(--hc-muted);
            padding: 0.75rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }
        .docs-table tbody tr:last-child td { border-bottom: none; }
        .docs-table td:first-child { font-family: 'DM Mono', monospace; color: var(--hc-text); }

        /* Sidebar active */
        .sidebar-link {
            display: block;
            font-size: 0.875rem;
            font-weight: 400;
            color: var(--hc-muted);
            padding: 6px 12px;
            border-radius: 6px;
            transition: all 0.15s ease;
            cursor: pointer;
            margin-bottom: 2px;
        }
        .sidebar-link:hover { background: rgba(255,255,255,0.04); color: var(--hc-text); }
        .sidebar-link.active {
            font-weight: 500;
            color: var(--hc-text);
            background: rgba(255,255,255,0.06);
            border-left: 2px solid var(--hc-green);
            padding-left: 10px;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen">

    <!-- Top Navbar -->
    <header class="h-14 bg-[#0A0A0B] flex items-center justify-between px-6 sticky top-0 z-50">
        <div class="flex items-center gap-6">
            <a href="/" class="flex items-center gap-2">
                <img src="/images/logo.png" alt="HealthyCron" class="w-6 h-6 rounded-md object-contain">
                <span class="text-sm font-medium text-white">HealthyCron</span>
            </a>
        </div>

        <div class="flex items-center gap-4">
            <div class="relative hidden md:block mr-2">
                <input type="text" id="docs-search" placeholder="Search docs..." class="bg-[#111114] border border-white/6 rounded-lg pl-3 pr-10 py-1.5 text-sm font-normal text-[#4A4A52] placeholder:text-[#4A4A52] font-mono w-52 focus:outline-none focus:border-white/20 focus:text-white transition-colors">
                <div class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] text-[#4A4A52] font-mono border border-white/10 rounded px-1 pointer-events-none">⌘K</div>
            </div>
            <a href="/dashboard" class="text-sm font-normal text-[#8A8A93] hover:text-white transition-colors">Dashboard</a>
            <button onclick="handleLogout()" class="text-sm font-normal text-[#8A8A93] hover:text-white transition-colors">Logout</button>
            <button id="mobile-menu-btn" class="lg:hidden text-[#8A8A93] hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
        </div>
    </header>

    <div class="flex flex-1 mx-auto w-full max-w-[1400px]">
        <!-- Sidebar -->
        <aside id="sidebar" class="hidden lg:block w-56 shrink-0 bg-[#0A0A0B] h-[calc(100vh-56px)] overflow-y-auto sticky top-14 pb-12">
            <nav class="px-3 py-6" id="docs-nav">
                
                <!-- GETTING STARTED -->
                <div class="mb-6 nav-section">
                    <h3 class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] px-3 pt-5 pb-1.5">Getting Started</h3>
                    <a href="/docs" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">Introduction</a>
                    <a href="/docs/overview" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Overview" ? "active" : "")">Overview</a>
                    <a href="/docs/quick-start" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "QuickStart" ? "active" : "")">Quick Start</a>
                    <a href="/docs/how-monitoring-works" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "HowMonitoringWorks" ? "active" : "")">How Monitoring Works</a>
                </div>

                <!-- CORE CONCEPTS -->
                <div class="mb-6 nav-section">
                    <h3 class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] px-3 pt-5 pb-1.5">Core Concepts</h3>
                    <a href="/docs/monitors" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Monitors" ? "active" : "")">Monitors</a>
                    <a href="/docs/pinging-api" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "PingingApi" ? "active" : "")">Pinging API</a>
                    <a href="/docs/configuring-checks" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ConfiguringChecks" ? "active" : "")">Configuring Checks</a>
                    <a href="/docs/configuration" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Configuration" ? "active" : "")">Configuration</a>
                    <a href="/docs/reliability-tips" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ReliabilityTips" ? "active" : "")">Reliability Tips</a>
                </div>

                <!-- INTEGRATIONS -->
                <div class="mb-6 nav-section">
                    <h3 class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] px-3 pt-5 pb-1.5">Integrations</h3>
                    <a href="/docs/notifications" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Notifications" ? "active" : "")">Notifications & Alerts</a>
                    <a href="/docs/projects" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Projects" ? "active" : "")">Projects & Teams</a>
                </div>

                <!-- ENVIRONMENTS -->
                <div class="mb-6 nav-section">
                    <h3 class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] px-3 pt-5 pb-1.5">Environments</h3>
                    <a href="/docs/running-with-docker" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "RunningWithDocker" ? "active" : "")">Running with Docker</a>
                    <a href="/docs/shell-scripts" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ShellScripts" ? "active" : "")">Shell Scripts</a>
                    <a href="/docs/arduino" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Arduino" ? "active" : "")">Arduino</a>
                    <a href="/docs/network-routers" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "NetworkRouters" ? "active" : "")">Network Routers</a>
                    <a href="/docs/github-actions" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "GitHubActions" ? "active" : "")">GitHub Actions</a>
                </div>

                <!-- LANGUAGES -->
                <div class="mb-6 nav-section">
                    <h3 class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] px-3 pt-5 pb-1.5">Languages</h3>
                    <a href="/docs/csharp" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CSharp" ? "active" : "")">C#</a>
                    <a href="/docs/go" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Go" ? "active" : "")">Go</a>
                    <a href="/docs/javascript" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Javascript" ? "active" : "")">JavaScript</a>
                    <a href="/docs/php" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Php" ? "active" : "")">PHP</a>
                    <a href="/docs/powershell" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "PowerShell" ? "active" : "")">PowerShell</a>
                    <a href="/docs/python" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Python" ? "active" : "")">Python</a>
                    <a href="/docs/ruby" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Ruby" ? "active" : "")">Ruby</a>
                </div>

                <!-- GUIDES -->
                <div class="mb-6 nav-section">
                    <h3 class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] px-3 pt-5 pb-1.5">Guides</h3>
                    <a href="/docs/dotnet-integration" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "DotNetIntegration" ? "active" : "")">.NET & C# Integration</a>
                    <a href="/docs/best-practices" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "BestPractices" ? "active" : "")">Cron Job Best Practices</a>
                    <a href="/docs/api-reference" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ApiReference" ? "active" : "")">API Reference</a>
                </div>

                <!-- REFERENCE -->
                <div class="mb-6 nav-section">
                    <h3 class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] px-3 pt-5 pb-1.5">Reference</h3>
                    <a href="/docs/cron-syntax" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CronSyntax" ? "active" : "")">Cron Expression Syntax</a>
                    <a href="/docs/cron-syntax-cheatsheet" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CronSyntaxCheatsheet" ? "active" : "")">Cron Syntax Cheatsheet</a>
                    <a href="/docs/monitor-states" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MonitorStates" ? "active" : "")">Monitor States</a>
                    <a href="/docs/faq" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Faq" ? "active" : "")">FAQ</a>
                </div>

                <!-- COMPARISONS -->
                <div class="mb-6 nav-section">
                    <h3 class="text-[10px] font-medium uppercase tracking-widest text-[#4A4A52] px-3 pt-5 pb-1.5">Comparisons</h3>
                    <a href="/docs/compared-to-sentry" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ComparedToSentry" ? "active" : "")">Compared to Sentry</a>
                    <a href="/docs/compared-to-cronitor" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ComparedToCronitor" ? "active" : "")">Compared to Cronitor</a>
                </div>

            </nav>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 min-w-0">
            <div class="max-w-2xl pl-8 md:pl-16 pr-8 py-10 pb-24 prose">
                <!-- Breadcrumb placeholder -->
                <div class="text-xs font-normal text-[#4A4A52] mb-3">@ViewData["Breadcrumb"]</div>
                
                @RenderBody()

                <!-- Prev/Next Navigator -->
                @if (ViewData["PrevPageTitle"] != null || ViewData["NextPageTitle"] != null)
                {
                    <div class="border-t border-white/6 mt-12 pt-6 flex justify-between">
                        <div>
                            @if (ViewData["PrevPageTitle"] != null)
                            {
                                <div class="text-xs text-[#4A4A52] mb-1">Previous</div>
                                <a href="@ViewData["PrevPageUrl"]" class="text-sm font-medium text-white hover:text-white flex items-center gap-1.5">
                                    <span class="text-[#8A8A93]">←</span> @ViewData["PrevPageTitle"]
                                </a>
                            }
                        </div>
                        <div class="text-right">
                            @if (ViewData["NextPageTitle"] != null)
                            {
                                <div class="text-xs text-[#4A4A52] mb-1">Next</div>
                                <a href="@ViewData["NextPageUrl"]" class="text-sm font-medium text-white hover:text-white flex items-center gap-1.5 justify-end">
                                    @ViewData["NextPageTitle"] <span class="text-[#8A8A93]">→</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </main>
    </div>

    <script>
        const btn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        btn.addEventListener('click', () => {
            sidebar.classList.toggle('hidden');
            if(!sidebar.classList.contains('hidden')) {
                sidebar.classList.add('absolute', 'z-40', 'bg-[#0A0A0B]', 'h-[calc(100vh-56px)]');
            }
        });

        async function handleLogout() {
            try {
                const response = await fetch('/auth/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                if (response.ok) { window.location.href = '/login'; } 
            } catch (err) {}
        }
        
        function copyCode(btn) {
            const codeBlock = btn.closest('.code-container').querySelector('code');
            navigator.clipboard.writeText(codeBlock.innerText);
            const originalIcon = btn.innerHTML;
            btn.innerHTML = '<svg class="w-4 h-4 text-[#22C55E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
            setTimeout(() => { btn.innerHTML = originalIcon; }, 2000);
        }

        function switchTab(btn, index) {
            const container = btn.closest('.tabbed-code');
            container.querySelectorAll('.tab-btn').forEach((b, i) => {
                if (i === index) {
                    b.classList.add('text-white', 'border-b-2', 'border-[#22C55E]', '-mb-px');
                    b.classList.remove('text-[#4A4A52]', 'hover:text-[#8A8A93]');
                } else {
                    b.classList.remove('text-white', 'border-b-2', 'border-[#22C55E]', '-mb-px');
                    b.classList.add('text-[#4A4A52]', 'hover:text-[#8A8A93]');
                }
            });
            container.querySelectorAll('.tab-content').forEach((c, i) => {
                if (i === index) {
                    c.classList.remove('hidden');
                } else {
                    c.classList.add('hidden');
                }
            });
        }

        // Search Functionality
        const searchInput = document.getElementById('docs-search');
        if (searchInput) {
            // Keyboard shortcut Cmd+K / Ctrl+K
            document.addEventListener('keydown', (e) => {
                if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                    e.preventDefault();
                    searchInput.focus();
                }
            });

            // Filter
            searchInput.addEventListener('input', (e) => {
                const query = e.target.value.toLowerCase();
                const sections = document.querySelectorAll('.nav-section');

                sections.forEach(section => {
                    const links = section.querySelectorAll('.sidebar-link');
                    let sectionHasMatch = false;

                    links.forEach(link => {
                        if (link.textContent.toLowerCase().includes(query)) {
                            link.style.display = 'block';
                            sectionHasMatch = true;
                        } else {
                            link.style.display = 'none';
                        }
                    });

                    // Hide section header if no links match
                    const header = section.querySelector('h3');
                    if (header) {
                        header.style.display = sectionHasMatch || query === '' ? 'block' : 'none';
                    }
                });
            });
        }
    </script>
</body>
</html>
